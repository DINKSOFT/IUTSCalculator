<Application x:Class="IUTSCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IUTSCalculator"
             xmlns:converters="clr-namespace:IUTSCalculator.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══════════════════════════════════════════════════════════════
                 PALETTE

                 L'accent ne sert qu'à trois choses : l'action principale d'un
                 écran, l'élément sélectionné et le focus clavier. Les libellés,
                 les cases à cocher et les en-têtes de tableau reviennent au
                 gris — c'est ce qui rend à nouveau visible ce qui compte.
                 ═══════════════════════════════════════════════════════════════ -->

            <!-- Texte -->
            <Color x:Key="Ink">#17211F</Color>
            <Color x:Key="InkMuted">#48534F</Color>
            <Color x:Key="InkSubtle">#79837E</Color>

            <!-- Surfaces -->
            <Color x:Key="Ground">#F5F6F5</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="SurfaceAlt">#FAFBFA</Color>

            <!-- Filets -->
            <Color x:Key="Rule">#E0E4E0</Color>
            <Color x:Key="RuleStrong">#CBD1CC</Color>
            <Color x:Key="RuleFaint">#EEF1EE</Color>

            <!-- Rail de navigation -->
            <Color x:Key="Rail">#1E2A2C</Color>
            <Color x:Key="RailBorder">#2C393B</Color>
            <Color x:Key="RailHover">#27373A</Color>
            <Color x:Key="RailText">#BFCAC8</Color>
            <Color x:Key="RailTextDim">#6E807D</Color>

            <!-- Accent -->
            <Color x:Key="Accent">#14675A</Color>
            <Color x:Key="AccentDark">#0F5145</Color>
            <Color x:Key="AccentDarker">#0A3E35</Color>
            <Color x:Key="AccentTint">#E6F0ED</Color>
            <Color x:Key="AccentTintRule">#CFE2DC</Color>
            <Color x:Key="RowSelected">#F2F8F6</Color>

            <!-- Sémantique -->
            <Color x:Key="Success">#1F7A4D</Color>
            <Color x:Key="Warning">#A8690E</Color>
            <Color x:Key="WarningTint">#FDF8EE</Color>
            <Color x:Key="Danger">#9C2F28</Color>
            <Color x:Key="DangerRule">#E3C9C7</Color>

            <!-- Inactif -->
            <Color x:Key="DisabledFill">#EDEFED</Color>
            <Color x:Key="DisabledText">#A6AEA9</Color>

            <!-- ── Clés historiques ──────────────────────────────────────────
                 Conservées parce qu'une soixantaine d'endroits dans les vues
                 les référencent ; seules leurs VALEURS changent. Les noms en
                 « Blue » sont désormais trompeurs : préférez les clés
                 sémantiques ci-dessus dans tout nouveau code.
                 ─────────────────────────────────────────────────────────────── -->
            <Color x:Key="PrimaryBlue">#14675A</Color>
            <Color x:Key="PrimaryBlueDark">#0F5145</Color>
            <Color x:Key="PrimaryBlueDarker">#0A3E35</Color>
            <Color x:Key="GrayLight">#FAFBFA</Color>
            <Color x:Key="GrayMedium">#CBD1CC</Color>
            <Color x:Key="GrayDark">#79837E</Color>
            <Color x:Key="Red">#9C2F28</Color>
            <Color x:Key="Green">#1F7A4D</Color>
            <Color x:Key="White">#FFFFFF</Color>

            <!-- ═══════════ Pinceaux ═══════════ -->
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
            <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMuted}"/>
            <SolidColorBrush x:Key="InkSubtleBrush" Color="{StaticResource InkSubtle}"/>
            <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource Ground}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}"/>
            <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource Rule}"/>
            <SolidColorBrush x:Key="RuleStrongBrush" Color="{StaticResource RuleStrong}"/>
            <SolidColorBrush x:Key="RuleFaintBrush" Color="{StaticResource RuleFaint}"/>
            <SolidColorBrush x:Key="RailBrush" Color="{StaticResource Rail}"/>
            <SolidColorBrush x:Key="RailBorderBrush" Color="{StaticResource RailBorder}"/>
            <SolidColorBrush x:Key="RailHoverBrush" Color="{StaticResource RailHover}"/>
            <SolidColorBrush x:Key="RailTextBrush" Color="{StaticResource RailText}"/>
            <SolidColorBrush x:Key="RailTextDimBrush" Color="{StaticResource RailTextDim}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
            <SolidColorBrush x:Key="AccentBrush2" Color="{StaticResource Accent}"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>
            <SolidColorBrush x:Key="AccentDarkerBrush" Color="{StaticResource AccentDark}"/>
            <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTint}"/>
            <SolidColorBrush x:Key="AccentTintRuleBrush" Color="{StaticResource AccentTintRule}"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelected}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
            <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTint}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
            <SolidColorBrush x:Key="DangerRuleBrush" Color="{StaticResource DangerRule}"/>
            <SolidColorBrush x:Key="DisabledFillBrush" Color="{StaticResource DisabledFill}"/>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledText}"/>

            <!-- Pinceaux historiques -->
            <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}"/>
            <SolidColorBrush x:Key="PrimaryBlueDarkBrush" Color="{StaticResource PrimaryBlueDark}"/>
            <SolidColorBrush x:Key="PrimaryBlueDarkerBrush" Color="{StaticResource PrimaryBlueDarker}"/>
            <SolidColorBrush x:Key="GrayLightBrush" Color="{StaticResource GrayLight}"/>
            <SolidColorBrush x:Key="GrayMediumBrush" Color="{StaticResource GrayMedium}"/>
            <SolidColorBrush x:Key="GrayDarkBrush" Color="{StaticResource GrayDark}"/>
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}"/>
            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>

            <!-- ═══════════ Icônes Segoe MDL2 Assets ═══════════ -->
            <sys:String x:Key="IconPeople">&#xE716;</sys:String>
            <sys:String x:Key="IconCalculator">&#xE8CD;</sys:String>
            <sys:String x:Key="IconHistory">&#xF182;</sys:String>
            <sys:String x:Key="IconSettings">&#xE713;</sys:String>
            <sys:String x:Key="IconEstimate">&#xE8EF;</sys:String>
            <sys:String x:Key="IconPdf">&#xEA90;</sys:String>
            <sys:String x:Key="IconExcel">&#xE8A5;</sys:String>
            <sys:String x:Key="IconNew">&#xE109;</sys:String>
            <sys:String x:Key="IconSave">&#xE105;</sys:String>
            <sys:String x:Key="IconRefresh">&#xE895;</sys:String>
            <sys:String x:Key="IconClear">&#xE894;</sys:String>
            <sys:String x:Key="IconDelete">&#xE107;</sys:String>
            <sys:String x:Key="IconView">&#xE8F4;</sys:String>
            <sys:String x:Key="IconExcelAlt">&#xEA90;</sys:String>
            <sys:String x:Key="IconFile">&#xE8A5;</sys:String>
            <sys:String x:Key="IconEmploye">&#xE716;</sys:String>
            <sys:String x:Key="IconReset">&#xE8EB;</sys:String>
            <sys:String x:Key="IconInfo">&#xE946;</sys:String>
            <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
            <sys:String x:Key="IconError">&#xE7BA;</sys:String>
            <sys:String x:Key="IconSuccess">&#xE8B3;</sys:String>
            <sys:String x:Key="IconSearch">&#xE721;</sys:String>
            <sys:String x:Key="IconAdd">&#xE8C8;</sys:String>
            <sys:String x:Key="IconSubtract">&#xE8C7;</sys:String>
            <sys:String x:Key="IconCheck">&#xE8FD;</sys:String>
            <sys:String x:Key="IconClose">&#xE8BB;</sys:String>
            <sys:String x:Key="IconCancel">&#xE711;</sys:String>
            <sys:String x:Key="IconWarningAlt">&#xE7BA;</sys:String>
            <sys:String x:Key="IconImport">&#xE78B;</sys:String>
            <sys:String x:Key="IconExport">&#xEE71;</sys:String>
            <sys:String x:Key="IconEffaceFormulaire">&#xE75C;</sys:String>
            <sys:String x:Key="IconBatch">&#xE8FD;</sys:String>
            <sys:String x:Key="IconMore">&#xE712;</sys:String>
            <sys:String x:Key="IconChevron">&#xE70D;</sys:String>
            <sys:String x:Key="IconBuilding">&#xE825;</sys:String>
            <sys:String x:Key="IconMenu">&#xE700;</sys:String>
            <sys:String x:Key="IconCollapseLeft">&#xE76B;</sys:String>
            <sys:String x:Key="IconEdit">&#xE70F;</sys:String>
            <sys:String x:Key="IconLock">&#xE72E;</sys:String>
            <sys:String x:Key="IconBack">&#xE72B;</sys:String>

            <!-- ═══════════════════════════════════════════════════════════════
                 TYPOGRAPHIE
                 Segoe UI, police du système : aucune dépendance à embarquer.
                 La hiérarchie vient de la taille, de la graisse et du gris —
                 plus de la couleur.
                 ═══════════════════════════════════════════════════════════════ -->

            <Style x:Key="ScreenTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="21"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Montants : chiffres tabulaires et alignés à droite, pour que les
                 colonnes se lisent d'un coup d'œil. -->
            <Style x:Key="MoneyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <!-- Libellé de champ : gris, graisse normale. C'est l'unique raison
                 pour laquelle l'accent redevient lisible ailleurs. -->
            <Style x:Key="FormLabelStyle" TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
                <Setter Property="Padding" Value="2,0,2,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style x:Key="FormTextBlockLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
                <Setter Property="Padding" Value="2,0,2,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════
                 CHAMPS DE SAISIE
                 ═══════════════════════════════════════════════════════════════ -->

            <Style TargetType="TextBox" x:Key="FormTextBoxStyle">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                <EventSetter Event="GotFocus" Handler="TextBox_GotFocus_ClearIfZero"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource InkSubtleBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush2}"/>
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource InkSubtleBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FormCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="5,4,0,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- Même habillage que la case à cocher, pour un bouton radio : un Style
                 ciblant CheckBox ne peut pas s'appliquer à un RadioButton (il dérive de
                 ToggleButton, pas de CheckBox) et lèverait une exception à l'affichage. -->
            <Style x:Key="FormRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style TargetType="DatePicker" x:Key="FormDatePickerStyle">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════
                 PANNEAUX
                 Fond blanc et filet discret, au lieu du bloc gris encadré.
                 ═══════════════════════════════════════════════════════════════ -->

            <Style x:Key="FormGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource InkSubtleBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════
                 BOUTONS
                 Trois niveaux au lieu d'un seul. MenuButtonStyle reste l'action
                 principale (il est utilisé à une quarantaine d'endroits) ; les
                 actions secondaires prennent SecondaryButtonStyle.
                 ═══════════════════════════════════════════════════════════════ -->

            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Height" Value="34"/>
                <!-- Sans cela, un bouton posé dans une cellule de Grid s'étire sur toute
                     sa largeur : c'est ce qui donnait des boutons de 700 px de large.
                     Un bouton qui doit vraiment occuper la largeur le déclare lui-même. -->
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="Glyph"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="15"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Sans icône, pas d'espace réservé à l'icône. -->
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBlueDarkerBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InkBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton d'action principale : alias explicite de MenuButtonStyle -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}"/>

            <!-- Action secondaire : contour, pas de remplissage. -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="Glyph"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="15"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InkSubtleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RuleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Action destructrice. -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerRuleBrush}"/>
            </Style>

            <!-- Bouton icône pour bandeau / en-tête -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InkSubtleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RuleBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton icône pour l'en-tête du rail de navigation sombre -->
            <Style x:Key="RailIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource RailTextBrush}"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RailHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RailBorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════
                 RAIL DE NAVIGATION
                 ═══════════════════════════════════════════════════════════════ -->

            <Style x:Key="NavGroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource RailTextDimBrush}"/>
                <Setter Property="Margin" Value="10,14,10,6"/>
            </Style>

            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource RailTextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="{TemplateBinding Tag}"
                                               FontSize="15"
                                               Width="20"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RailHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource RailTextDimBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════════
                 TABLEAUX
                 En-tête gris sur fond clair, au lieu de la bande bleue pleine.
                 ═══════════════════════════════════════════════════════════════ -->

            <Style x:Key="GridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Un montant se lit aligné à droite : son en-tête de colonne aussi. -->
            <Style x:Key="GridColumnHeaderRightStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="GridColumnHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Cellule de texte : si la colonne est trop étroite, le texte est coupé
                 proprement par des points de suspension et l'infobulle donne la valeur
                 entière, plutôt que de laisser un mot tronqué sans recours. -->
            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Style>

            <Style x:Key="CenterTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <!-- Texte aligné à droite pour nombres, heures et montants -->
            <Style x:Key="RightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}"/>
            <Style x:Key="CellNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}"/>

            <Style x:Key="GridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleFaintBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Style.Triggers>
                    <!-- Propriété attachée : le nom complet est obligatoire.
                         L'alternance est gérée ici plutôt que par
                         DataGrid.AlternatingRowBackground, qui poserait une
                         valeur locale et empêcherait le survol et la sélection
                         de reprendre la main. -->
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGrid" x:Key="MainDataGridStyle">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeaderStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource GridCellStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource GridRowStyle}"/>
            </Style>

            <Style x:Key="FormDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MainDataGridStyle}">
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
            </Style>

            <!-- ═══════════ Convertisseurs ═══════════ -->
            <converters:BoolToTypeConverter x:Key="BoolToTypeConverter"/>
            <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
            <converters:DecimalToStringConverter x:Key="DecimalToStringConverter"/>
            <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
            <converters:PourcentageConverter x:Key="PourcentageConverter"/>
            <converters:MontantConverter x:Key="MontantConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
