<UserControl x:Class="IUTSCalculator.Views.GestionTempsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:GestionTempsViewModel}"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style x:Key="Toolbar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Gestion des temps &amp; rotations" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Planning des équipes postées, décompte hebdomadaire des heures et transfert vers la paie (RH-08)"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChargerCommand}"/>
                <Button Content="Calculer le décompte" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}" Command="{Binding CalculerCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Période ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mois de paie" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="130" ItemsSource="{Binding MoisDisponibles}"
                              SelectedItem="{Binding MoisSelectionne}" DisplayMemberPath="Nom"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="90" ItemsSource="{Binding AnneesDisponibles}" SelectedItem="{Binding Annee}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Équipe" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="190" ItemsSource="{Binding EquipesFiltre}"
                              SelectedItem="{Binding EquipeFiltre}" DisplayMemberPath="Designation"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Filtrer (salarié, matricule, équipe)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}" Height="26"
                             Padding="6,2" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,8,0,0">
                    <TextBlock Text="{Binding PeriodeLibelle, Mode=OneWay}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush2}"/>
                    <TextBlock Text="{Binding BaremeApplicableLibelle, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource InkSubtleBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Onglets ═══════════ -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding OngletActif, Mode=TwoWay}">

            <!-- ───────── 1. Planning ───────── -->
            <TabItem Header="Planning">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="220"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Toolbar}">
                        <WrapPanel>
                            <Button Content="Générer depuis les cycles" Tag="{StaticResource IconBatch}"
                                    Style="{StaticResource MenuButtonStyle}" Command="{Binding GenererPlanningCommand}"
                                    ToolTip="Remplit les jours sans saisie avec le cycle de l'équipe. Les jours saisis ou importés sont conservés."/>
                            <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EnregistrerPlanningCommand}"/>
                            <Button Content="Importer pointages / grille" Tag="{StaticResource IconImport}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImporterCommand}"
                                    ToolTip="Fichier de badgeuse (Matricule, Date, Entrée, Sortie ou Code) ou grille de planning exportée puis corrigée dans Excel."/>
                            <Button Content="Modèle de pointages" Tag="{StaticResource IconFile}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExporterModeleCommand}"/>
                            <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExporterExcelCommand}"/>
                            <Button Content="Régénérer (écrase les saisies)" Tag="{StaticResource IconReset}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenererPlanningCommand}"
                                    ToolTip="Remplace tous les jours de la période par le cycle de l'équipe, y compris les saisies et pointages."/>
                        </WrapPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Margin="2,0,0,6" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap">
                        <Run Text="Codes :"/>
                        <Run Text="{Binding Legende, Mode=OneWay}"/>
                        <Run Text=". Tapez le code dans la case (Entrée pour valider), puis « Enregistrer »."/>
                    </TextBlock>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid x:Name="GrillePlanning"
                                  ItemsSource="{Binding VuePlanning}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False"
                                  SelectionUnit="Cell" SelectionMode="Extended"
                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                  FrozenColumnCount="3" RowHeight="24"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                  VerticalGridLinesBrush="{StaticResource RuleBrush}"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0"
                                  PreparingCellForEdit="GrillePlanning_PreparingCellForEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeId, Mode=OneWay}"
                                                    IsReadOnly="True" Width="85"/>
                                <DataGridTextColumn Header="Salarié" Binding="{Binding NomComplet, Mode=OneWay}"
                                                    IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="Équipe" Binding="{Binding EquipeCode, Mode=OneWay}"
                                                    IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="Postes" Binding="{Binding JoursTravailles, Mode=OneWay}"
                                                    IsReadOnly="True" Width="55"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                    ElementStyle="{StaticResource RightTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────── 2. Décompte & transfert ───────── -->
            <TabItem Header="Décompte &amp; transfert vers la paie">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="HEURES SUPPLÉMENTAIRES" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalHeuresSup, Mode=OneWay, StringFormat={}{0:0.##} h}" Style="{StaticResource KpiValue}"
                                           Foreground="{StaticResource AccentBrush2}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="41e-48e H" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalTranche1, Mode=OneWay, StringFormat={}{0:0.##} h}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="AU-DELÀ DE 48 H" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalTranche2, Mode=OneWay, StringFormat={}{0:0.##} h}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="NUIT" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalNuit, Mode=OneWay, StringFormat={}{0:0.##} h}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="DIMANCHE / FÉRIÉ" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalFerie, Mode=OneWay, StringFormat={}{0:0.##} h}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="PANIERS" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalPaniers, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}">
                            <StackPanel>
                                <TextBlock Text="JOURS D'ABSENCE (A)" Style="{StaticResource KpiLabel}"/>
                                <TextBlock Text="{Binding TotalAbsences, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource Toolbar}">
                        <WrapPanel>
                            <Button Content="Recalculer" Tag="{StaticResource IconCalculator}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CalculerCommand}"/>
                            <Button Content="Tout transférer vers la paie" Tag="{StaticResource IconCheck}"
                                    Style="{StaticResource MenuButtonStyle}" Command="{Binding TransfererToutCommand}"/>
                            <Button Content="Heures sup. → PAI-03" Tag="{StaticResource IconExport}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TransfererHeuresSupCommand}"/>
                            <Button Content="Absences → congés et absences" Tag="{StaticResource IconExport}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TransfererAbsencesCommand}"/>
                            <Button Content="Paniers → variables du mois" Tag="{StaticResource IconExport}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TransfererPaniersCommand}"/>
                            <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExporterExcelCommand}"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Recaps}" SelectedItem="{Binding RecapSelectionne}"
                                  Style="{StaticResource FormDataGridStyle}" IsReadOnly="True"
                                  AutoGenerateColumns="False" BorderThickness="0" FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeId, Mode=OneWay}" Width="85"/>
                                <DataGridTextColumn Header="Salarié" Binding="{Binding NomComplet, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Équipe" Binding="{Binding EquipeCode, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn Header="Postes" Binding="{Binding JoursTravailles, Mode=OneWay}" Width="55"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Semaines" Binding="{Binding PeriodeDecompteLibelle, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Heures" Binding="{Binding HeuresDecomptees, Mode=OneWay, StringFormat={}{0:0.##}}" Width="60"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Normales" Binding="{Binding HeuresNormales, Mode=OneWay, StringFormat={}{0:0.##}}" Width="70"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="HS" Binding="{Binding HeuresSup, Mode=OneWay, StringFormat={}{0:0.##}}" Width="50"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightTextStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush2}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="41e-48e" Binding="{Binding Tranche1, Mode=OneWay, StringFormat={}{0:0.##}}" Width="60"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="&gt; 48e" Binding="{Binding Tranche2, Mode=OneWay, StringFormat={}{0:0.##}}" Width="55"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Nuit" Binding="{Binding Nuit, Mode=OneWay, StringFormat={}{0:0.##}}" Width="50"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Fér. jour" Binding="{Binding FerieJour, Mode=OneWay, StringFormat={}{0:0.##}}" Width="62"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Fér. nuit" Binding="{Binding FerieNuit, Mode=OneWay, StringFormat={}{0:0.##}}" Width="62"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Paniers" Binding="{Binding Paniers, Mode=OneWay}" Width="58"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Mt paniers" Binding="{Binding MontantPanier, Mode=OneWay, StringFormat={}{0:N0}}" Width="80"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="A" Binding="{Binding JoursAbsenceNonJustifiee, Mode=OneWay}" Width="35"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="AJ" Binding="{Binding JoursAbsenceJustifiee, Mode=OneWay}" Width="35"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="CP" Binding="{Binding JoursConge, Mode=OneWay}" Width="35"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="M" Binding="{Binding JoursMaladie, Mode=OneWay}" Width="35"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                <DataGridTextColumn Header="Observations" Binding="{Binding Observations, Mode=OneWay}" Width="*" MinWidth="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Détail par semaine du salarié sélectionné -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">
                                <Run Text="Détail par semaine —"/>
                                <Run Text="{Binding RecapSelectionne.NomComplet, Mode=OneWay}"/>
                            </TextBlock>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecapSelectionne.Semaines}" IsReadOnly="True"
                                      AutoGenerateColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Semaine" Binding="{Binding Libelle, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Codes" Binding="{Binding Codes, Mode=OneWay}" Width="170"/>
                                    <DataGridTextColumn Header="Heures" Binding="{Binding HeuresTravaillees, Mode=OneWay, StringFormat={}{0:0.##}}" Width="60"/>
                                    <DataGridTextColumn Header="Normales" Binding="{Binding HeuresNormales, Mode=OneWay, StringFormat={}{0:0.##}}" Width="70"/>
                                    <DataGridTextColumn Header="HS" Binding="{Binding HeuresSup, Mode=OneWay, StringFormat={}{0:0.##}}" Width="50"/>
                                    <DataGridTextColumn Header="41e-48e" Binding="{Binding Tranche1, Mode=OneWay, StringFormat={}{0:0.##}}" Width="60"/>
                                    <DataGridTextColumn Header="&gt; 48e" Binding="{Binding Tranche2, Mode=OneWay, StringFormat={}{0:0.##}}" Width="55"/>
                                    <DataGridTextColumn Header="Nuit" Binding="{Binding Nuit, Mode=OneWay, StringFormat={}{0:0.##}}" Width="50"/>
                                    <DataGridTextColumn Header="Fér. jour" Binding="{Binding FerieJour, Mode=OneWay, StringFormat={}{0:0.##}}" Width="62"/>
                                    <DataGridTextColumn Header="Fér. nuit" Binding="{Binding FerieNuit, Mode=OneWay, StringFormat={}{0:0.##}}" Width="62"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────── 3. Équipes & cycles ───────── -->
            <TabItem Header="Équipes &amp; cycles">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" MinWidth="260"/>
                        <ColumnDefinition Width="4*" MinWidth="320"/>
                        <ColumnDefinition Width="5*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liste des équipes -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="150"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Toolbar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Nouvelle équipe" Tag="{StaticResource IconAdd}"
                                        Style="{StaticResource MenuButtonStyle}" Command="{Binding NouvelleEquipeCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding Equipes}" SelectedItem="{Binding EquipeSelectionnee}"
                                      Style="{StaticResource FormDataGridStyle}" IsReadOnly="True"
                                      AutoGenerateColumns="False" BorderThickness="0" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="85"/>
                                    <DataGridTextColumn Header="Site" Binding="{Binding Site, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Cycle" Binding="{Binding Motif, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Membres" Binding="{Binding NombreMembres, Mode=OneWay}" Width="65"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}" ElementStyle="{StaticResource RightTextStyle}"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active, Mode=OneWay}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Fiche de l'équipe -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding EquipeEnCours}">
                                <TextBlock Text="FICHE DE L'ÉQUIPE" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="Sélectionnez une équipe ou créez-en une." Foreground="{StaticResource InkSubtleBrush}"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Code *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                                 VerticalContentAlignment="Center" CharacterCasing="Upper"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Site" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Libellé" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>

                                <TextBlock Text="Cycle de rotation * (ex. 7J 7N 7R, 4J 4R, 2J 2N 4R)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"
                                         CharacterCasing="Upper" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding ResumeCycle, Mode=OneWay}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush2}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CycleValide}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Premier jour du cycle *" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                <DatePicker SelectedDate="{Binding DateDebutCycle}" Height="30"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Poste de jour (h)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DureePosteJour, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Poste de nuit (h)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DureePosteNuit, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Normales / poste (h)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding HeuresNormalesParPoste, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"
                                                 ToolTip="Au-delà de ces heures, une nuit ou un jour férié donne des heures supplémentaires de nuit ou de férié."/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Semaine de décompte des 40 h" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding DataContext.ModesSemaine, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ModeSemaine}"/>

                                <CheckBox Content="Travail du dimanche majoré comme un jour férié" IsChecked="{Binding DimancheMajore}" Margin="0,8,0,0"/>

                                <TextBlock Text="Prime de panier" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding DataContext.ModesPanier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding PanierMode}"/>
                                <TextBlock Text="Valeur (FCFA par poste, ou fraction du taux horaire : 0,3333 = un tiers)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding PanierValeur, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>

                                <CheckBox Content="Équipe active" IsChecked="{Binding Active}" Margin="0,10,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Enregistrer l'équipe" Tag="{StaticResource IconSave}"
                                            Style="{StaticResource MenuButtonStyle}"
                                            Command="{Binding DataContext.EnregistrerEquipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.SupprimerEquipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Affectation des salariés -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="150"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Toolbar}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RechercheSalaries, UpdateSourceTrigger=PropertyChanged}" Height="26"
                                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                                         ToolTip="Filtrer les salariés (nom, matricule, équipe)"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Affecter à l'équipe" Tag="{StaticResource IconAdd}"
                                            Style="{StaticResource MenuButtonStyle}" Command="{Binding AffecterCommand}"
                                            ToolTip="Affecte les salariés cochés à l'équipe affichée dans la fiche."/>
                                    <Button Content="Retirer" Tag="{StaticResource IconSubtract}" Margin="0"
                                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RetirerCommand}"
                                            ToolTip="Retire les salariés cochés de leur équipe."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding VueSalaries}" Style="{StaticResource FormDataGridStyle}"
                                      AutoGenerateColumns="False" BorderThickness="0" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding EstCoche, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule, Mode=OneWay}" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="Salarié" Binding="{Binding NomComplet, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="Fonction" Binding="{Binding Fonction, Mode=OneWay}" IsReadOnly="True" Width="110"/>
                                    <DataGridTextColumn Header="Équipe" Binding="{Binding EquipeCode, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ───────── 4. Paramètres ───────── -->
            <TabItem Header="Paramètres, fériés &amp; barème HS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Période de pointage -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PÉRIODE DE POINTAGE" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock Text="Jour d'arrêté (0 = mois civil ; 20 = du 21 du mois précédent au 20)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                    <ComboBox Width="90" HorizontalAlignment="Left" ItemsSource="{Binding JoursArreteDisponibles}" SelectedItem="{Binding JourArrete}"/>
                                    <TextBlock Text="{Binding ApercuArrete, Mode=OneWay}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AccentBrush2}"/>
                                    <CheckBox Content="Une absence justifiée (AJ) compte 8 h pour atteindre le seuil des 40 h"
                                              IsChecked="{Binding AJCompteDansSeuil}" Margin="0,10,0,0"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Par défaut, non : les heures supplémentaires se décomptent sur le travail effectif. Une semaine à cheval sur deux périodes est décomptée en entier avec la période qui contient son dernier jour."/>
                                    <Button Content="Enregistrer les paramètres" Tag="{StaticResource IconSave}" HorizontalAlignment="Left"
                                            Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"
                                            Command="{Binding EnregistrerParametresCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- Jours fériés -->
                            <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="JOURS FÉRIÉS" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                                               Text="Un poste J ou N tombant un jour de cette liste est décompté comme FJ ou FN. Ajoutez les fêtes mobiles (Ramadan, Tabaski, Maouloud, lundi de Pâques, Ascension) chaque année."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding NouveauFerieDate}" Height="30"/>
                                        <TextBox Grid.Column="2" Text="{Binding NouveauFerieLibelle, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" VerticalContentAlignment="Center" ToolTip="Nom du jour férié"/>
                                        <Button Grid.Column="4" Content="Ajouter" Tag="{StaticResource IconAdd}" Margin="0"
                                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AjouterFerieCommand}"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding Feries}" SelectedItem="{Binding FerieSelectionne}"
                                             DisplayMemberPath="Designation" Height="200" Margin="0,8,0,0"/>
                                    <Button Content="Supprimer le jour sélectionné" Tag="{StaticResource IconDelete}" HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                                            Command="{Binding SupprimerFerieCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Barème HS daté -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="BARÈME DES HEURES SUPPLÉMENTAIRES (DATÉ)" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Le barème applicable à un mois est celui dont la date d'effet est la plus récente. Quand une règle change, créez un nouveau barème : les mois passés gardent le leur. Il s'applique aussi à l'écran « Heures supplémentaires »."/>
                                <DataGrid ItemsSource="{Binding Baremes}" SelectedItem="{Binding BaremeSelectionne}" Height="130"
                                          Style="{StaticResource FormDataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Effet" Binding="{Binding DateEffet, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" Width="85"/>
                                        <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Taux" Binding="{Binding Resume, Mode=OneWay}" Width="190"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel DataContext="{Binding BaremeEnCours}" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Date d'effet" Style="{StaticResource FieldLabel}"/>
                                            <DatePicker SelectedDate="{Binding DateEffet}" Height="30"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Libellé" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Référence (convention, décret, accord)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="41e-48e heure" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TauxTranche1, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Au-delà de 48 h" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TauxTranche2, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Nuit" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TauxNuit, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                            <TextBlock Text="Dim./férié de jour" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TauxFerieJour, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                            <TextBlock Text="Dim./férié de nuit" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TauxFerieNuit, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                                            <TextBlock Text="Heures 1re tranche / durée légale" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding SeuilTranche1, UpdateSourceTrigger=LostFocus}" Width="45" Height="28" VerticalContentAlignment="Center"/>
                                                <TextBlock Text=" h / " VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DureeHebdoLegale, UpdateSourceTrigger=LostFocus}" Width="45" Height="28" VerticalContentAlignment="Center"/>
                                                <TextBlock Text=" h" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Nouveau barème" Tag="{StaticResource IconAdd}"
                                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NouveauBaremeCommand}"/>
                                    <Button Content="Enregistrer le barème" Tag="{StaticResource IconSave}"
                                            Style="{StaticResource MenuButtonStyle}" Command="{Binding EnregistrerBaremeCommand}"/>
                                    <Button Content="Supprimer" Tag="{StaticResource IconDelete}" Margin="0"
                                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SupprimerBaremeCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Barre de statut ═══════════ -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
