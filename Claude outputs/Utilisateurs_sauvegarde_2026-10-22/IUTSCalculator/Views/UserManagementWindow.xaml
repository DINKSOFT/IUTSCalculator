<Window x:Class="IUTSCalculator.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Gestion des utilisateurs"
        Height="560" Width="880"
        MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource GrayLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="Gestion des utilisateurs" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBlueDarkerBrush}"/>
            <TextBlock Text="Créez les comptes du personnel et attribuez un rôle : Lecture seule (consultation), Éditeur (saisie et calculs), Administrateur (tout + gestion des utilisateurs)."
                       FontSize="12" Foreground="{StaticResource GrayDarkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des utilisateurs -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1" Padding="10">
                <DataGrid x:Name="GrilleUtilisateurs" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" SelectionChanged="Grille_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom affiché" Binding="{Binding Nom}" Width="2*"/>
                        <DataGridTextColumn Header="Identifiant" Binding="{Binding Identifiant}" Width="1.4*"/>
                        <DataGridTextColumn Header="Rôle" Binding="{Binding RoleLibelle}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Panneaux d'action -->
            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource GrayMediumBrush}"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Nouvel utilisateur" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Nom affiché" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="NewNom" Height="28" Margin="0,0,0,8"
                                 BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>
                        <TextBlock Text="Identifiant" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="NewIdentifiant" Height="28" Margin="0,0,0,8"
                                 BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>
                        <TextBlock Text="Rôle" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="NewRole" Height="28" Margin="0,0,0,8" SelectedIndex="1">
                            <ComboBoxItem Content="Lecture seule"/>
                            <ComboBoxItem Content="Éditeur"/>
                            <ComboBoxItem Content="Administrateur"/>
                        </ComboBox>
                        <TextBlock Text="Mot de passe (6 caractères min.)" FontSize="11" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="NewMdp" Height="28" Margin="0,0,0,10"
                                     BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>
                        <Button Content="Ajouter l'utilisateur" Style="{StaticResource MenuButtonStyle}"
                                Height="32" Click="Ajouter_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource GrayMediumBrush}"
                        BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Utilisateur sélectionné" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SelInfo" Text="Aucun utilisateur sélectionné."
                                   FontSize="11" Foreground="{StaticResource GrayDarkBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Changer le rôle" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="SelRole" Height="28" Margin="0,0,0,6">
                            <ComboBoxItem Content="Lecture seule"/>
                            <ComboBoxItem Content="Éditeur"/>
                            <ComboBoxItem Content="Administrateur"/>
                        </ComboBox>
                        <Button Content="Appliquer le rôle" Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" Margin="0,0,0,10" Click="AppliquerRole_Click"/>

                        <TextBlock Text="Nouveau mot de passe" FontSize="11" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="SelMdp" Height="28" Margin="0,0,0,6"
                                     BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>
                        <Button Content="Réinitialiser le mot de passe" Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" Margin="0,0,0,10" Click="Reinitialiser_Click"/>

                        <Button Content="Supprimer cet utilisateur" Style="{StaticResource DangerButtonStyle}"
                                Height="30" Click="Supprimer_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="MessageEtat" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Button Content="Fermer" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="110" Height="34" Click="Fermer_Click"/>
        </DockPanel>
    </Grid>
</Window>
