<UserControl x:Class="IUTSCalculator.Views.AbsenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:AbsenceViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Congés et absences" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding NombreAbsences, Mode=OneWay}"/>
                    <Run Text="absence(s) sur la période — le compteur de congés et la retenue du bulletin en découlent"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Recharger" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Modèle Excel" Tag="{StaticResource IconExcelAlt}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Exporte un modèle Excel pré-rempli avec l'ensemble des salariés pour la saisie des congés du mois."
                        Command="{Binding ExporterModeleCommand}"/>
                <Button Content="Importer Excel" Tag="{StaticResource IconImport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Importe les congés payés depuis un fichier Excel pour l'ensemble des salariés."
                        Command="{Binding ImporterExcelCommand}"/>
                <Button Content="Saisie groupée" Tag="{StaticResource IconEmploye}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Attribue un congé collectif à tous les salariés ou à une catégorie en un clic."
                        Command="{Binding ToggleAttributionGroupeeCommand}"/>
                <Button Content="Nouvelle absence" Tag="{StaticResource IconAdd}" Margin="0" Width="170"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouvelleCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Barre de période ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Période traitée" Style="{StaticResource SectionLabelStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="150" Height="34" Margin="0,0,8,0"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding MoisDisponibles}"
                                  DisplayMemberPath="Nom"
                                  SelectedItem="{Binding MoisSelectionne}"/>
                        <ComboBox Width="96" Height="34" Margin="0"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding AnneesDisponibles}"
                                  SelectedItem="{Binding Annee}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Margin="22,4,22,2"
                           VerticalAlignment="Stretch" Fill="{StaticResource RuleBrush}"/>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Règles appliquées à ce dossier" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding DroitMensuelLibelle}" FontSize="12"
                               Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BaseRetenueLibelle}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,14,0,0" Padding="12,8" CornerRadius="3"
                        Background="{StaticResource WarningTintBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        Visibility="{Binding PeriodeCloturee, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Période clôturée — lecture seule. Rouvrez-la depuis « Périodes de paie » pour corriger."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource InkBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Panneau rétractable : Saisie et attribution groupée ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,16"
                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding AttributionGroupeeOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="ATTRIBUTION GROUPÉE DE CONGÉS PAYÉS" Style="{StaticResource SectionLabelStyle}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Attribuez un congé collectif en une seule opération à tout l'effectif ou par catégorie (conçu pour plusieurs milliers de salariés)."
                                   FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
                    </StackPanel>
                    <Button Content="Fermer" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="0" Padding="12,0" Height="28" Margin="0"
                            Command="{Binding ToggleAttributionGroupeeCommand}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Groupe cible" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                        <ComboBox Height="34" Margin="0" Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding CategoriesFiltre}"
                                  SelectedItem="{Binding CategorieFiltreSelectionnee, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Du" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                        <DatePicker Width="130" Height="34" Margin="0" Style="{StaticResource FormDatePickerStyle}"
                                    SelectedDate="{Binding DateDebutGroupee, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Au" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                        <DatePicker Width="130" Height="34" Margin="0" Style="{StaticResource FormDatePickerStyle}"
                                    SelectedDate="{Binding DateFinGroupee, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Jours ouvrables" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Height="34" Margin="0,0,6,0" TextAlignment="Right"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding JoursGroupee, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Calculer" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="0" Padding="8,0" Height="34" Margin="0"
                                    ToolTip="Recalcule les jours ouvrables d'après les dates (dimanches exclus)"
                                    Command="{Binding CalculerJoursGroupeeCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Motif / Commentaire" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                        <TextBox Height="34" Margin="0" Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding CommentaireGroupe, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="Cible actuelle : " FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
                        <TextBlock Text="{Binding NombreSalariesCibles}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text=" salarié(s) recevront ce congé." FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
                    </StackPanel>
                    <Button Content="Appliquer le congé au groupe sélectionné" Tag="{StaticResource IconBatch}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource MenuButtonStyle}" Height="34" MinWidth="0" Padding="16,0" Margin="0"
                            Command="{Binding AppliquerAttributionGroupeeCommand}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════ Absences et compteurs ═══════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des absences de la période -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <TextBlock Text="ABSENCES DE LA PÉRIODE" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}"
                                       Text="{Binding PeriodeLibelle}"/>
                        </Grid>
                    </Border>

                    <!-- ═══════════ Barre de recherche et filtres absences ═══════════ -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche textuelle -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="32" Padding="28,4,26,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Rechercher par salarié, type, motif..."/>
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource InkSubtleBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Width="20" Height="20"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Effacer la recherche"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Filtre Type -->
                            <ComboBox Grid.Column="2" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding TypesAbsenceFiltreOptions}"
                                      SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par type d'absence"/>

                            <!-- Filtre Rémunérée -->
                            <ComboBox Grid.Column="4" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding RemunereeFiltreOptions}"
                                      SelectedValue="{Binding SelectedRemunereeFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par prise en charge"/>

                            <!-- Réinitialiser -->
                            <Button Grid.Column="5" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                                    MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Réinitialiser les filtres"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Compteur d'absences -->
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombreAbsencesAffichees, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding NombreAbsences, Mode=OneWay}"/>
                                <Run Text="absence(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Formulaire d'édition, ouvert seulement quand une absence est en cours -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12"
                            Visibility="{Binding EditionOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Salarié" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <!-- Recherche rapide du salarié pour entreprises à fort effectif -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBox Text="{Binding FiltreSalarie, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Height="28" Padding="24,2,22,2" Margin="0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Filtrer par nom, prénom, matricule ou emploi..."/>
                                        <TextBlock Text="{StaticResource IconSearch}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource InkSubtleBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" IsHitTestVisible="False"/>
                                        <Button Command="{Binding ClearFiltreSalarieCommand}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,4,0" Width="16" Height="16"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Effacer la recherche"
                                                Visibility="{Binding HasFiltreSalarie, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource InkSubtleBrush}"/>
                                        </Button>
                                    </Grid>
                                    <ComboBox Height="34" Margin="0,0,0,10"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding SalariesFiltres}"
                                              SelectedItem="{Binding SalarieSelectionne, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding LastName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding FirstName, Mode=OneWay}"/>
                                                    <Run Text="·" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <Run Text="{Binding Matricule, Mode=OneWay}" Foreground="{StaticResource InkSubtleBrush}" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Type d'absence" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <ComboBox Height="34" Margin="0,0,0,10"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding TypesAbsence}"
                                              SelectedItem="{Binding TypeSelectionne, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Libelle}"/>
                                                    <TextBlock Text="{Binding Traitement, StringFormat=' — {0}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Du" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                        <DatePicker Width="140" Margin="0,0,0,10"
                                                    Style="{StaticResource FormDatePickerStyle}"
                                                    SelectedDate="{Binding AbsenceEnCours.DateDebut, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Au" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                        <DatePicker Width="140" Margin="0,0,0,10"
                                                    Style="{StaticResource FormDatePickerStyle}"
                                                    SelectedDate="{Binding AbsenceEnCours.DateFin, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Jours" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                        <TextBox Width="80" Margin="0,0,0,10" TextAlignment="Right"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Text="{Binding AbsenceEnCours.NombreJours, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Heures" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                        <TextBox Width="80" Margin="0,0,0,10" TextAlignment="Right"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 ToolTip="À renseigner seulement si le dossier retient au taux horaire, ou pour une absence de quelques heures."
                                                 Text="{Binding AbsenceEnCours.NombreHeures, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <Button Content="Compter les jours" MinWidth="0" Padding="12,0" Margin="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Compte les jours ouvrables entre les deux dates, dimanches exclus. Le résultat reste modifiable."
                                                Command="{Binding CalculerJoursCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Commentaire" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Margin="0,0,0,10"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding AbsenceEnCours.Commentaire, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                        MinWidth="0" Padding="12,0"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding EnregistrerCommand}"/>
                                <Button Content="Annuler" MinWidth="0" Padding="12,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AnnulerCommand}"/>
                                <Button Content="Supprimer cette absence" Margin="0" MinWidth="0" Padding="12,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding SupprimerCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Toutes les colonnes sont en Mode=OneWay : une colonne de DataGrid est
                         liée en TwoWay par défaut, même dans une grille en lecture seule, et
                         une propriété calculée (TypeLibelle, Periode, EstRemuneree) fait alors
                         lever « liaison TwoWay sur une propriété en lecture seule ». -->
                    <DataGrid ItemsSource="{Binding AbsencesView}"
                              SelectedItem="{Binding AbsenceSelectionnee, Mode=TwoWay}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                Width="2*" MinWidth="140"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLibelle, Mode=OneWay}"
                                                Width="*" MinWidth="130"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Période" Binding="{Binding Periode, Mode=OneWay}"
                                                Width="180"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Jours" Binding="{Binding NombreJours, StringFormat=N2, Mode=OneWay}"
                                                Width="70"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridCheckBoxColumn Header="Payée" Binding="{Binding EstRemuneree, Mode=OneWay}"
                                                    Width="60"
                                                    HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Compteur de congés de l'effectif -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <TextBlock Text="COMPTEUR DE CONGÉS" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12"
                            Visibility="{Binding ADesAvertissements, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="À VÉRIFIER" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Avertissements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding SoldesView}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Acquis"
                                                Binding="{Binding JoursAcquis, StringFormat=N1, Mode=OneWay}"
                                                Width="70"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Pris"
                                                Binding="{Binding JoursPris, StringFormat=N1, Mode=OneWay}"
                                                Width="60"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Solde"
                                                Binding="{Binding SoldeLibelle, Mode=OneWay}"
                                                Width="90"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Barre d'état ═══════════ -->
        <Border Grid.Row="4" Margin="0,14,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
