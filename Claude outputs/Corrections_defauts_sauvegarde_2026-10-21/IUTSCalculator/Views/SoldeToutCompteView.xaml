<UserControl x:Class="IUTSCalculator.Views.SoldeToutCompteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:SoldeToutCompteViewModel}"
             mc:Ignorable="d" d:DesignWidth="1250" d:DesignHeight="800">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Solde de tout compte &amp; Gestion des départs" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Calcul automatisé des indemnités de rupture (CCI-BF), décompte financier, et édition des documents légaux obligatoires"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                        Command="{Binding RafraichirCommand}"/>
                <Button Content="Calculer" Tag="{StaticResource IconCalculator}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                        Command="{Binding CalculerCommand}"/>
                <Button Content="Valider départ &amp; Archiver" Tag="{StaticResource IconSave}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,4"
                        Command="{Binding ValiderEtEnregistrerCommand}"/>
            </WrapPanel>
        </Grid>

        <!-- ═══════════ Onglets principaux ═══════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ────────── Onglet 1 : Décompte & Sortie ────────── -->
            <TabItem Header="  Décompte &amp; Indemnités de rupture  ">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ──── Colonne Gauche : Salarié & Paramètres de rupture ──── -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Salarié concerné" Style="{StaticResource SectionHeading}"/>

                                <!-- Recherche rapide salarié -->
                                <TextBlock Text="Rechercher par nom ou matricule" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FiltreSalarie, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Sélecteur salarié -->
                                <TextBlock Text="Sélection du travailleur" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding EmployeesFiltres}"
                                          SelectedItem="{Binding SelectedEmployee}"
                                          Height="30" Margin="0,0,0,14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                                <TextBlock Text=" (" Foreground="{StaticResource InkSubtleBrush}"/>
                                                <TextBlock Text="{Binding EmployeeId}" Foreground="{StaticResource InkSubtleBrush}"/>
                                                <TextBlock Text=" - " Foreground="{StaticResource InkSubtleBrush}"/>
                                                <TextBlock Text="{Binding StatutLibelle}" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text=")" Foreground="{StaticResource InkSubtleBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Separator Margin="0,0,0,12" Background="{StaticResource RuleBrush}"/>

                                <TextBlock Text="Modalités de la cessation de service" Style="{StaticResource SectionHeading}"/>

                                <!-- Date de sortie -->
                                <TextBlock Text="Date effective de sortie" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DateSortie, Mode=TwoWay}"
                                            Height="28" Margin="0,0,0,10"/>

                                <!-- Motif de rupture -->
                                <TextBlock Text="Motif de rupture (Code du travail / CCI-BF)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Motifs}"
                                          SelectedItem="{Binding SelectedMotifOption}"
                                          DisplayMemberPath="Libelle"
                                          Height="30" Margin="0,0,0,10"/>
                                <!-- Passerelle RH-06 : licenciement disciplinaire notifié -->
                                <TextBlock Text="{Binding InfoDiscipline, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource AccentBrush2}" Margin="0,-4,0,10"
                                           Visibility="{Binding AInfoDiscipline, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Statut du préavis -->
                                <TextBlock Text="Statut du préavis légal" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StatutsPreavis}"
                                          SelectedItem="{Binding SelectedPreavisOption}"
                                          DisplayMemberPath="Libelle"
                                          Height="30" Margin="0,0,0,10"/>

                                <!-- Jours travaillés dans le mois de sortie -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Jours de présence" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding JoursPresence, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Congés dus (reliquat)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding JoursCongesManuel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                 ToolTip="Laisser vide pour utiliser le solde automatique"
                                                 Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Salaire de référence & Gratification -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Salaire réf. (FCFA)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SalaireRefManuel, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                 ToolTip="Laisser vide pour retenir le brut contractuel"
                                                 Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Gratification 13e" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Gratification, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Indemnités diverses -->
                                <TextBlock Text="Indemnités diverses / Transactionnelles" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LibelleIndemnitesDiverses, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Intitulé de l'indemnité diverse"
                                             Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndemnitesDiverses, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Montant en FCFA"
                                             Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                </Grid>

                                <!-- Autres retenues de sortie -->
                                <TextBlock Text="Autres déductions de sortie" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LibelleAutresDeductions, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Motif de la déduction"
                                             Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding AutresDeductions, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Montant en FCFA"
                                             Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                                </Grid>

                                <!-- Commentaire -->
                                <TextBlock Text="Observations / Notes administratives" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}"
                                         Height="45" TextWrapping="Wrap" AcceptsReturn="True"
                                         Padding="6,4" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ──── Colonne Droite : Synthèse, Décompte & Éditions ──── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cartouche d'identité Salarié & Contrat -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding SoldeCourant.NomSalarie, FallbackValue='Sélectionnez un salarié', Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock Text=" — " Foreground="{StaticResource InkSubtleBrush}"/>
                                        <TextBlock Text="{Binding SoldeCourant.Fonction, FallbackValue='-', Mode=OneWay}"
                                                   FontSize="13" Foreground="{StaticResource InkMutedBrush}"/>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Catégorie : " FontSize="11.5" Foreground="{StaticResource InkSubtleBrush}"/>
                                        <TextBlock Text="{Binding SoldeCourant.Categorie, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text=" (Échelon " FontSize="11.5" Foreground="{StaticResource InkSubtleBrush}"/>
                                        <TextBlock Text="{Binding SoldeCourant.Echelon, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text=") — Ancienneté : " FontSize="11.5" Foreground="{StaticResource InkSubtleBrush}"/>
                                        <TextBlock Text="{Binding SoldeCourant.AncienneteTexte, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text=" — Salaire réf. : " FontSize="11.5" Foreground="{StaticResource InkSubtleBrush}"/>
                                        <TextBlock Text="{Binding SoldeCourant.SalaireReference, StringFormat='{}{0:N0} FCFA', Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border CornerRadius="4" Padding="8,4" Background="{StaticResource AccentTintBrush}">
                                        <TextBlock Text="{Binding SoldeCourant.MotifLibelle, FallbackValue='En attente', Mode=OneWay}"
                                                   FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" FontSize="11.5"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tableau détaillé des montants et décompte -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Décomposition des droits et indemnités de fin de contrat" Style="{StaticResource SectionHeading}"/>

                                    <!-- Grille des rubriques financières -->
                                    <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- En-tête -->
                                                <RowDefinition Height="Auto"/> <!-- Dernier salaire -->
                                                <RowDefinition Height="Auto"/> <!-- Congés -->
                                                <RowDefinition Height="Auto"/> <!-- Préavis -->
                                                <RowDefinition Height="Auto"/> <!-- Licenciement -->
                                                <RowDefinition Height="Auto"/> <!-- 13e mois -->
                                                <RowDefinition Height="Auto"/> <!-- Divers -->
                                                <RowDefinition Height="Auto"/> <!-- Total Brut -->
                                                <RowDefinition Height="Auto"/> <!-- Retenue IUTS -->
                                                <RowDefinition Height="Auto"/> <!-- Retenue CNSS -->
                                                <RowDefinition Height="Auto"/> <!-- Prêts en cours -->
                                                <RowDefinition Height="Auto"/> <!-- Autres déductions -->
                                                <RowDefinition Height="Auto"/> <!-- Total Retenues -->
                                                <RowDefinition Height="Auto"/> <!-- Net à payer -->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3.2*"/>
                                                <ColumnDefinition Width="1.25*"/>
                                                <ColumnDefinition Width="1.25*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- En-têtes -->
                                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource GroundBrush}" Padding="8,6" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Élément / Indemnité" FontWeight="Bold" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="1" Text="Détail / Base" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="Régime légal" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="Montant (FCFA)" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 1 : Salaire de présence -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Dernier salaire (salaire de présence)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoldeCourant.JoursPresence, StringFormat='{}{0:0.##} j ouvrés', Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Imposable" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.SalairePresence, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 2 : Congés payés -->
                                            <Border Grid.Row="2" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Indemnité compensatrice de congés payés" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoldeCourant.JoursCongesDus, StringFormat='{}{0:0.##} j reliquat', Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Imposable" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.IndemniteConges, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 3 : Préavis -->
                                            <Border Grid.Row="3" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Indemnité compensatrice de préavis" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoldeCourant.StatutPreavisLibelle, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Imposable" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.IndemnitePreavis, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 4 : Indemnité de licenciement / retraite -->
                                            <Border Grid.Row="4" Grid.ColumnSpan="4" Padding="8,5" Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentTintRuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Indemnité de licenciement / de fin de service (Art. 35 CCI-BF)" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoldeCourant.TauxLicenciementApplique, StringFormat='{}Taux global {0:0.##}%', Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Exonéré (Art. 106 CGI)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.IndemniteLicenciement, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 5 : 13ème mois -->
                                            <Border Grid.Row="5" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Prorata 13e mois / Gratification" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SoldeCourant.Mois13emeMois, StringFormat='{}{0:0.##} mois', Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Imposable" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.Indemnite13emeMois, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 6 : Diverses -->
                                            <Border Grid.Row="6" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleStrongBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SoldeCourant.LibelleIndemnitesDiverses, FallbackValue='Indemnités diverses', Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Imposable" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.IndemnitesDiverses, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 7 : Total Brut -->
                                            <Border Grid.Row="7" Grid.ColumnSpan="4" Background="{StaticResource GroundBrush}" Padding="8,6" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="TOTAL BRUT DES INDEMNITÉS" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SoldeCourant.TotalExonere, StringFormat='{}Exonéré : {0:N0}', Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.TotalBrut, StringFormat='{}{0:N0}', Mode=OneWay}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 8 : IUTS estimé -->
                                            <Border Grid.Row="8" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Retenue IUTS (estimée sur éléments imposables)" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Retenue fiscale" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.EstimationIUTS, StringFormat='{}-{0:N0}', Mode=OneWay}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 9 : CNSS estimée -->
                                            <Border Grid.Row="9" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Retenue CNSS salariale (5,5% branche retraite)" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Cotisation sociale" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.EstimationCNSS, StringFormat='{}-{0:N0}', Mode=OneWay}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 10 : Prêts en cours -->
                                            <Border Grid.Row="10" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Remboursement solde de prêts et avances en cours" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="Solde restant dû" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Retenue sur net" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.DeductionsPrets, StringFormat='{}-{0:N0}', Mode=OneWay}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 11 : Autres retenues -->
                                            <Border Grid.Row="11" Grid.ColumnSpan="4" Padding="8,5" BorderBrush="{StaticResource RuleStrongBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SoldeCourant.LibelleDeductionsAutres, FallbackValue='Autres déductions de sortie', Mode=OneWay}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Retenue sur net" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.DeductionsAutres, StringFormat='{}-{0:N0}', Mode=OneWay}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 12 : Total Retenues -->
                                            <Border Grid.Row="12" Grid.ColumnSpan="4" Background="{StaticResource GroundBrush}" Padding="8,6" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="TOTAL DES DÉDUCTIONS ET CHARGES" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.TotalRetenues, StringFormat='{}-{0:N0}', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <!-- Ligne 13 : NET À PAYER -->
                                            <Border Grid.Row="13" Grid.ColumnSpan="4" Background="{StaticResource AccentTintBrush}" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="NET À PERCEVOIR POUR SOLDE DE TOUT COMPTE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDarkerBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SoldeCourant.TotalNet, StringFormat='{}{0:N0} FCFA', Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Barre d'édition des documents légaux (Bas) -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Édition des documents légaux de fin de contrat (Conformes Code du travail)" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock Text="Documents administratifs officiels prêts pour signature et remise au salarié" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Reçu STC (PDF)" Tag="{StaticResource IconPdf}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                                            Command="{Binding ImprimerRecuPdfCommand}"/>
                                    <Button Content="Certificat travail (Art. 67)" Tag="{StaticResource IconPdf}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                                            Command="{Binding ImprimerCertificatPdfCommand}"/>
                                    <Button Content="Attestation fin service" Tag="{StaticResource IconPdf}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                                            Command="{Binding ImprimerAttestationPdfCommand}"/>
                                    <Button Content="Export Excel" Tag="{StaticResource IconExcel}" Margin="0,0,8,4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ExporterExcelCommand}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ────────── Onglet 2 : Historique des soldes archivés ────────── -->
            <TabItem Header="  Historique des départs archivés  ">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barre de filtre historique -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Filtrer l'historique par salarié ou motif" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FiltreHistorique, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="6,2" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Button Content="Rappeler le décompte" Tag="{StaticResource IconView}"
                                        Style="{StaticResource MenuButtonStyle}" Margin="0,0,6,2"
                                        Command="{Binding ChargerSoldeHistoriqueCommand}"
                                        CommandParameter="{Binding SelectedSoldeHistorique}"/>
                                <Button Content="Reçu PDF" Tag="{StaticResource IconPdf}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,2"
                                        Command="{Binding ImprimerRecuPdfCommand}"/>
                                <Button Content="Certificat PDF" Tag="{StaticResource IconPdf}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,2"
                                        Command="{Binding ImprimerCertificatPdfCommand}"/>
                                <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,2"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding SupprimerSoldeCommand}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Tableau de l'historique des soldes -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding SoldesHistoriqueFiltres}"
                                  SelectedItem="{Binding SelectedSoldeHistorique}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  RowHeight="30"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource RuleFaintBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                                <DataGridTextColumn Header="Date sortie" Binding="{Binding DateSortie, StringFormat='dd/MM/yyyy', Mode=OneWay}" Width="95"/>
                                <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeId, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Motif de rupture" Binding="{Binding MotifLibelle, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Ancienneté" Binding="{Binding AncienneteTexte, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Salaire réf." Binding="{Binding SalaireReference, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Total Brut" Binding="{Binding TotalBrut, StringFormat='{}{0:N0}', Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Retenues" Binding="{Binding TotalRetenues, StringFormat='{}{0:N0}', Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Net payé (FCFA)" Binding="{Binding TotalNet, StringFormat='{}{0:N0}', Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Observations" Binding="{Binding Commentaire, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Barre d'état ═══════════ -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4" Background="{StaticResource GroundBrush}" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource InkMutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
