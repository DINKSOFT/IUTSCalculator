<UserControl x:Class="IUTSCalculator.Views.FormationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{StaticResource GroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style bouton icône Segoe -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <!-- Style carte KPI -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Bandeau supérieur / Titre & Plan -->
            <RowDefinition Height="*"/>    <!-- Contenu des onglets -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             1. BANDEAU SUPÉRIEUR : SÉLECTION DE L'EXERCICE & DU PLAN
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Titre & Sélecteur de Plan -->
                    <RowDefinition Height="Auto"/> <!-- Boutons d'Action & Exports -->
                </Grid.RowDefinitions>

                <!-- Titre & Sélecteur de Plan : le sous-titre et le combo occupent une colonne Auto
                     chacun, le spacer * absorbe le reste. Les boutons ne sont plus dans cette ligne
                     (voir ci-dessous) pour ne jamais se faire couper par des colonnes Auto voisines. -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Titre & Exercice -->
                        <ColumnDefinition Width="Auto"/> <!-- Sélecteur de Plan -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    </Grid.ColumnDefinitions>

                    <!-- Titre & Année -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{StaticResource IconBuilding}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Gestion de la Formation &amp; TPA" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Plan annuel, sessions, compétences, participants et contrepartie fiscale (CGI / FAFPA)" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                        </StackPanel>

                        <Border Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Exercice :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AnneesDisponibles}"
                                          SelectedItem="{Binding AnneeSelectionnee, Mode=TwoWay}"
                                          Width="75" Height="24" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sélecteur de Plan -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="Plan annuel :" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Plans}"
                                  SelectedItem="{Binding PlanSelectionne, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220" Height="26" VerticalAlignment="Center"/>

                        <!-- Badge Statut -->
                        <Border CornerRadius="3" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{Binding PlanSelectionne.CouleurStatut, Mode=OneWay, FallbackValue=#757575}">
                            <TextBlock Text="{Binding PlanSelectionne.StatutLibelle, Mode=OneWay, FallbackValue='Aucun plan'}"
                                       Foreground="{StaticResource WhiteBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Actions globales et Exports : rangée dédiée pleine largeur (jamais rognée par les
                     colonnes Auto du titre/sélecteur), avec défilement horizontal de secours si la
                     fenêtre est réellement trop étroite pour tout afficher d'un coup. -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Nouveau Plan" Command="{Binding NouveauPlanCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                FontWeight="SemiBold" Height="28" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>

                        <Button Content="Enregistrer" Command="{Binding EnregistrerPlanCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                Height="28" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>

                        <Button Content="Valider Plan" Command="{Binding ValiderPlanCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource SuccessBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                Height="28" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>

                        <Button Content="Clôturer Plan" Command="{Binding CloturerPlanCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource WarningBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                Height="28" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>

                        <Button Content="Supprimer" Command="{Binding SupprimerPlanCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                Height="28" Padding="10,0" Margin="0,0,12,0" Cursor="Hand"/>

                        <!-- Exports -->
                        <Button ToolTip="Exporter la synthèse complète en Excel (4 feuilles)"
                                Command="{Binding ExporterExcelCommand}"
                                Style="{StaticResource IconButtonStyle}" Height="28" Width="32" Margin="0,0,4,0">
                            <TextBlock Text="{StaticResource IconExcel}" FontFamily="Segoe MDL2 Assets" Foreground="#1F7A4D" FontSize="14"/>
                        </Button>

                        <Button ToolTip="Exporter le bilan officiel annuel en PDF (iTextSharp)"
                                Command="{Binding ExporterBilanPdfCommand}"
                                Style="{StaticResource IconButtonStyle}" Height="28" Width="32" Margin="0,0,4,0">
                            <TextBlock Text="{StaticResource IconPdf}" FontFamily="Segoe MDL2 Assets" Foreground="#C62828" FontSize="14"/>
                        </Button>

                        <Button ToolTip="Rafraîchir les données"
                                Command="{Binding RafraichirCommand}"
                                Style="{StaticResource IconButtonStyle}" Height="28" Width="32">
                            <TextBlock Text="{StaticResource IconRefresh}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource InkMutedBrush}" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             2. ONGLETS PRINCIPAUX DU MODULE
             ═══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding OngletActifIndex, Mode=TwoWay}"
                    Background="Transparent" BorderThickness="0" Margin="10,8,10,10">

            <!-- ─────────────────────────────────────────────────────────
                 ONGLET 1 : PILOTAGE & TPA
                 ───────────────────────────────────────────────────────── -->
            <TabItem Header="Pilotage &amp; TPA" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">

                        <!-- Cartes KPI Financières & TPA -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KPI 1 : Masse Salariale TPA -->
                            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Masse Salariale TPA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding TableauBordTpa.MasseSalarialeTexte, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="Assiette soumise exercice" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 2 : TPA Due Théorique -->
                            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TPA Légale Due" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding TableauBordTpa.TpaDueTexte, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding TableauBordTpa.TauxTpaTexte, StringFormat='Taux légal : {0}', Mode=OneWay}" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 3 : Budget Prévisionnel Plan -->
                            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Budget Formation Voté" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding PlanSelectionne.BudgetPrevisionnelTexte, Mode=OneWay, FallbackValue='0 FCFA'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding PlanSelectionne.Code, StringFormat='Plan {0}', Mode=OneWay, FallbackValue='—'}" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 4 : Dépenses Réelles Engagées -->
                            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dépenses Engagées" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding TableauBordTpa.TotalDepensesTexte, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding PlanSelectionne.TauxConsommationTexte, StringFormat='Conso : {0}', Mode=OneWay, FallbackValue='0%'}" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 5 : Ratio d'Effort Formation -->
                            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Ratio Effort Formation" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding TableauBordTpa.RatioDepensesMasseTexte, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="Dépenses / Masse TPA" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI 6 : Couverture TPA -->
                            <Border Grid.Column="5" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Couverture TPA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Text="{Binding TableauBordTpa.TauxCouvertureTpaTexte, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#0288D1" Margin="0,3,0,0"/>
                                    <TextBlock Text="Dépenses / TPA légale" FontSize="9" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Formulaire Détails du Plan Annuel -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,12" MinHeight="250">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Paramètres et Objectifs du Plan Annuel de Formation" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,12"/>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Code du plan :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PlanSelectionne.Code, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Intitulé du plan :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PlanSelectionne.Titre, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Année d'exercice :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PlanSelectionne.AnneeExercice, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Budget voté (FCFA) :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PlanSelectionne.BudgetPrevisionnel, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                    <TextBlock Text="Orientations et Objectifs Stratégiques de l'entreprise :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding PlanSelectionne.ObjectifsStrategiques, UpdateSourceTrigger=PropertyChanged}"
                                             Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                </StackPanel>

                                <!-- Synthèse d'exécution -->
                                <Border Grid.Row="3" Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Sessions rattachées :" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBlock Text="{Binding PlanSelectionne.NombreSessions, Mode=OneWay, StringFormat='{}{0} session(s)'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Agents formés (présents) :" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBlock Text="{Binding TableauBordTpa.NombreSalariesFormes, Mode=OneWay, StringFormat='{}{0} collaborateur(s)'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Heures de formation dispensées :" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBlock Text="{Binding TableauBordTpa.NombreHeuresTotal, Mode=OneWay, StringFormat='{}{0} heures'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Solde budgétaire disponible :" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBlock Text="{Binding PlanSelectionne.EcartBudgetTexte, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Note légale FAFPA / TPA -->
                        <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" CornerRadius="4" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconInfo}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rappel fiscalité Burkina Faso (CGI Art. 120+) : Les dépenses directes de formation professionnelle continue justifiées (frais pédagogiques d'organismes agréés, formateurs et logistique) constituent la contrepartie légale de la Taxe Patronale et d'Apprentissage (TPA) et permettent d'ouvrir les droits de tirage et de remboursement auprès du FAFPA."
                                           FontSize="10.5" Foreground="#1B5E20" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────────────────────────────────────────────────
                 ONGLET 2 : SESSIONS DE FORMATION & PARTICIPANTS
                 ───────────────────────────────────────────────────────── -->
            <TabItem Header="Sessions &amp; Inscriptions" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Barre d'outils sessions -->
                            <RowDefinition Height="Auto"/> <!-- Liste des sessions -->
                            <RowDefinition Height="Auto"/> <!-- Détails session & formulaire de coûts -->
                            <RowDefinition Height="Auto"/> <!-- Gestion des participants -->
                        </Grid.RowDefinitions>

                        <!-- Barre d'outils Sessions : filtres sur une ligne, actions sur la suivante
                             (rangée dédiée pleine largeur + défilement horizontal de secours) pour ne
                             jamais faire disparaître de boutons derrière une colonne Auto voisine. -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="Statut :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox SelectedItem="{Binding FiltreStatutSession, Mode=TwoWay}" Width="110" Height="24" FontSize="11">
                                    <ComboBoxItem Content="Toutes"/>
                                    <ComboBoxItem Content="Planifiée"/>
                                    <ComboBoxItem Content="Confirmée"/>
                                    <ComboBoxItem Content="En cours"/>
                                    <ComboBoxItem Content="Réalisée"/>
                                    <ComboBoxItem Content="Annulée"/>
                                </ComboBox>

                                <TextBlock Text="Rechercher :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBox Text="{Binding RechercheSessionTexte, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="24" FontSize="11"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nouvelle Session" Command="{Binding NouvelleSessionCommand}"
                                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                            FontWeight="SemiBold" Height="26" Padding="8,0" Margin="0,0,6,0" Cursor="Hand"/>

                                    <Button Content="Enregistrer Session" Command="{Binding EnregistrerSessionCommand}"
                                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
                                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" Cursor="Hand"/>

                                    <Button Content="Confirmer" Command="{Binding ConfirmerSessionCommand}"
                                            Background="{StaticResource SurfaceBrush}" Foreground="#0288D1"
                                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" Cursor="Hand"/>

                                    <Button Content="Marquer Réalisée" Command="{Binding RealiserSessionCommand}"
                                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource SuccessBrush}"
                                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                            Height="26" Padding="8,0" Margin="0,0,6,0" Cursor="Hand"/>

                                    <Button Content="Supprimer" Command="{Binding SupprimerSessionCommand}"
                                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}"
                                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                            Height="26" Padding="8,0" Cursor="Hand"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Grille des Sessions -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" MinHeight="160">
                            <DataGrid ItemsSource="{Binding SessionsFiltrees}"
                                      SelectedItem="{Binding SessionSelectionnee, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding CodeSession, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Intitulé de la session" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Période" Binding="{Binding PeriodeLibelle, Mode=OneWay}" Width="160"/>
                                    <DataGridTextColumn Header="Formateur" Binding="{Binding FormateurNom, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="Organisme" Binding="{Binding OrganismeNom, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Inscrits/Présents" Binding="{Binding NombrePresents, StringFormat='{}{0} / ', Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Coût Réel" Binding="{Binding CoutTotalTexte, Mode=OneWay}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Détails & Coûts de la session sélectionnée -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding SessionSelectionnee.DisplayName, StringFormat='Paramètres de la session : {0}', FallbackValue='Détails de la session'}"
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Code session :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SessionSelectionnee.CodeSession, UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Formation (Catalogue) :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding CatalogueFormations}"
                                                  SelectedValue="{Binding SessionSelectionnee.FormationId, Mode=TwoWay}"
                                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Organisme formateur :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding Organismes}"
                                                  SelectedValue="{Binding SessionSelectionnee.OrganismeId, Mode=TwoWay}"
                                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Formateur / Animateur :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SessionSelectionnee.FormateurNom, UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Dates et Coûts ventilés -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Date début :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <DatePicker SelectedDate="{Binding SessionSelectionnee.DateDebut, Mode=TwoWay}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Date fin :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <DatePicker SelectedDate="{Binding SessionSelectionnee.DateFin, Mode=TwoWay}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Coût Pédagogique (FCFA) :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SessionSelectionnee.CoutPedagogique, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="Coût Logistique (FCFA) :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SessionSelectionnee.CoutLogistique, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                        <TextBlock Text="Coût Annexe / Autre :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding SessionSelectionnee.CoutAutre, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Height="25" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="Total Réel (FCFA) :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,3"/>
                                        <Border Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" Height="25" Padding="6,3">
                                            <TextBlock Text="{Binding SessionSelectionnee.CoutTotalTexte, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Participants inscrits à la session sélectionnée -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" MinHeight="220">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header participants & Inscription rapide -->
                                    <RowDefinition Height="Auto"/> <!-- Grille participants -->
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Salariés Inscrits &amp; Pointage des Présences" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                                    <!-- Ajout rapide d'un salarié -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ajouter salarié :" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding EmployesDisponibles}"
                                                  SelectedItem="{Binding NouvelEmployeSelectionne, Mode=TwoWay}"
                                                  DisplayMemberPath="FullName" Width="200" Height="25" FontSize="11" Margin="0,0,6,0"/>

                                        <Button Content="+ Inscrire" Command="{Binding AjouterParticipantCommand}"
                                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                                FontWeight="SemiBold" Height="25" Padding="8,0" Cursor="Hand" Margin="0,0,10,0"/>

                                        <Button Content="Présent" Command="{Binding PointerPresentCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource SuccessBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="25" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>

                                        <Button Content="Absent" Command="{Binding PointerAbsentCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource WarningBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="25" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>

                                        <Button Content="Attestation" Command="{Binding DelivrerAttestationCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource AccentBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="25" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>

                                        <Button Content="PDF Attestation" Command="{Binding GenererAttestationPdfCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="#C62828"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                FontWeight="SemiBold" Height="25" Padding="8,0" Cursor="Hand" Margin="0,0,4,0"/>

                                        <Button Content="Retirer" Command="{Binding SupprimerInscriptionCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="25" Padding="6,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Grille des Inscriptions -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Inscriptions}"
                                          SelectedItem="{Binding InscriptionSelectionnee, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                          BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeMatricule, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Nom &amp; Prénom" Binding="{Binding EmployeeNomComplet, Mode=OneWay}" Width="160" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Service / Direction" Binding="{Binding Department, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Poste" Binding="{Binding PosteTitre, Mode=OneWay}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Statut Présence" Binding="{Binding StatutPresenceLibelle, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Note / Évaluation" Binding="{Binding NoteEvaluation, Mode=TwoWay}" Width="110"/>
                                        <DataGridCheckBoxColumn Header="Attestation" Binding="{Binding AttestationObtenue, Mode=TwoWay}" Width="90"/>
                                        <DataGridTextColumn Header="Frais Imputés" Binding="{Binding FraisImputesTexte, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire, Mode=TwoWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────────────────────────────────────────────────
                 ONGLET 3 : RÉFÉRENTIELS (CATALOGUE & ORGANISMES)
                 ───────────────────────────────────────────────────────── -->
            <TabItem Header="Catalogue &amp; Organismes" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panneau 1 : Catalogue des Formations -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,6,0" MinHeight="450">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Catalogue des Actions de Formation" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ Nouvelle" Command="{Binding NouvelleFormationCommand}"
                                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                                FontWeight="SemiBold" Height="24" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>
                                        <Button Content="Enregistrer" Command="{Binding EnregistrerFormationCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="24" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>
                                        <Button Content="Supprimer" Command="{Binding SupprimerFormationCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="24" Padding="6,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Liste Catalogue -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CatalogueFormations}"
                                          SelectedItem="{Binding FormationCatalogueSelectionnee, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Height="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="80"/>
                                        <DataGridTextColumn Header="Intitulé" Binding="{Binding Intitule, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Durée" Binding="{Binding DureeLibelle, Mode=OneWay}" Width="60"/>
                                        <DataGridTextColumn Header="Modalité" Binding="{Binding TypeFormationLibelle, Mode=OneWay}" Width="75"/>
                                        <DataGridTextColumn Header="Coût Est." Binding="{Binding CoutEstimeTexte, Mode=OneWay}" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Formulaire Édition Formation -->
                                <StackPanel Grid.Row="2">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Code :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding FormationCatalogueSelectionnee.Code, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Intitulé :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding FormationCatalogueSelectionnee.Intitule, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Domaine :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding FormationCatalogueSelectionnee.Domaine, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Durée (h) :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding FormationCatalogueSelectionnee.DureeHeures, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Coût Est./Participant :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding FormationCatalogueSelectionnee.CoutEstimeParParticipant, StringFormat='{}{0:N0}', UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Compétence visée (RH-02) :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                        <ComboBox ItemsSource="{Binding CompetencesDisponibles}"
                                                  SelectedValue="{Binding FormationCatalogueSelectionnee.CompetenceViseeId, Mode=TwoWay}"
                                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="24" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Objectifs pédagogiques :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                        <TextBox Text="{Binding FormationCatalogueSelectionnee.ObjectifsPedagogiques, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Panneau 2 : Organismes Formateurs Agréés -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="6,0,0,0" MinHeight="450">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Organismes de Formation &amp; Agréments FAFPA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ Nouvel Org." Command="{Binding NouvelOrganismeCommand}"
                                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                                FontWeight="SemiBold" Height="24" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>
                                        <Button Content="Enregistrer" Command="{Binding EnregistrerOrganismeCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="24" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"/>
                                        <Button Content="Supprimer" Command="{Binding SupprimerOrganismeCommand}"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}"
                                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                                Height="24" Padding="6,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Liste Organismes -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Organismes}"
                                          SelectedItem="{Binding OrganismeSelectionne, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Height="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Raison Sociale" Binding="{Binding RaisonSociale, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="N° Agrément" Binding="{Binding NumeroAgrement, Mode=OneWay}" Width="120"/>
                                        <DataGridTextColumn Header="Contact" Binding="{Binding ContactNom, Mode=OneWay}" Width="110"/>
                                        <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone, Mode=OneWay}" Width="95"/>
                                        <DataGridTextColumn Header="Statut" Binding="{Binding StatutActifLibelle, Mode=OneWay}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Formulaire Édition Organisme -->
                                <StackPanel Grid.Row="2">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Raison Sociale :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding OrganismeSelectionne.RaisonSociale, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="N° Agrément FAFPA :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding OrganismeSelectionne.NumeroAgrement, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Nom contact :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding OrganismeSelectionne.ContactNom, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Téléphone :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding OrganismeSelectionne.Telephone, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Email :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                            <TextBox Text="{Binding OrganismeSelectionne.Email, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Adresse &amp; Siège :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                        <TextBox Text="{Binding OrganismeSelectionne.Adresse, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Domaines de spécialité :" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                        <TextBox Text="{Binding OrganismeSelectionne.Specialites, UpdateSourceTrigger=PropertyChanged}" Height="24" FontSize="11"/>
                                    </StackPanel>

                                    <CheckBox Content="Organisme actif pour de nouvelles sessions" IsChecked="{Binding OrganismeSelectionne.Actif, Mode=TwoWay}"
                                              Margin="0,4,0,0" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────────────────────────────────────────────────
                 ONGLET 4 : RECUEIL DES BESOINS RH-03
                 ───────────────────────────────────────────────────────── -->
            <TabItem Header="Besoins d'Évaluation (RH-03)" FontSize="12" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Bannière explicative -->
                            <RowDefinition Height="Auto"/> <!-- Barre d'action passerelle -->
                            <RowDefinition Height="*"/>    <!-- Tableau des besoins -->
                        </Grid.RowDefinitions>

                        <!-- Bannière explicative passerelle -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Consolidation des Besoins Recensés en Entretiens Annuels d'Évaluation" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Cette section regroupe automatiquement tous les souhaits et besoins de formation exprimés par les collaborateurs et validés par leurs évaluateurs N+1 lors des campagnes RH-03. Vous pouvez affecter directement une demande à une session réelle du plan annuel de formation en cours."
                                           FontSize="11" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Barre d'action passerelle -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding BesoinsRh03.Count, StringFormat='Total des besoins recensés : {0}', Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding SessionSelectionnee.DisplayName, StringFormat='Session cible : {0}', FallbackValue='(Aucune session active)'}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Button Content="Affecter à la Session Sélectionnée" Command="{Binding AssignerBesoinASessionSelectionneeCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource WhiteBrush}"
                                        FontWeight="SemiBold" Height="26" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>

                                <Button Content="Détacher la Demande" Command="{Binding DetacherBesoinCommand}"
                                        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource WarningBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        Height="26" Padding="8,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grille des Besoins RH-03 -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" MinHeight="300">
                            <DataGrid ItemsSource="{Binding BesoinsRh03}"
                                      SelectedItem="{Binding BesoinRh03Selectionne, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N°" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                                    <DataGridTextColumn Header="Thème de formation" Binding="{Binding ThemeFormation, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Compétence visée" Binding="{Binding CompetenceVisee, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="Priorité" Binding="{Binding PrioriteLibelle, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Avis de l'évaluateur N+1" Binding="{Binding AvisEvaluateur, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut, Mode=OneWay}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
