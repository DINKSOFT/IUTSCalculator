<UserControl x:Class="IUTSCalculator.Views.OrganigrammeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:OrganigrammeViewModel}"
             mc:Ignorable="d" d:DesignWidth="1250" d:DesignHeight="780">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="TabHeaderBtnStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template arborescent pour la vue graphique -->
        <HierarchicalDataTemplate DataType="{x:Type models:NoeudOrganigramme}" ItemsSource="{Binding Enfants}">
            <Border Margin="4,4,4,6" CornerRadius="6"
                    BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}"
                    MinWidth="220" MaxWidth="280">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource RuleStrongBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="#A8690E"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bandeau supérieur coloré -->
                    <Border Grid.Row="0" CornerRadius="5,5,0,0" Padding="8,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstPoste}" Value="True">
                                        <Setter Property="Background" Value="#2A5B84"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Code, Mode=OneWay}"
                                       FontWeight="Bold" FontSize="10" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="{Binding BadgeType, Mode=OneWay}"
                                       FontSize="9.5" Foreground="#E0E4E0"/>
                        </Grid>
                    </Border>

                    <!-- Corps du nœud -->
                    <Border Grid.Row="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Titre, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,4"/>

                            <DockPanel LastChildFill="True" Margin="0,4,0,2">
                                <!-- Avatar / Initiales -->
                                <Border Width="26" Height="26" CornerRadius="13"
                                        Background="{StaticResource AccentTintBrush}"
                                        BorderBrush="{StaticResource AccentTintRuleBrush}" BorderThickness="1"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InitialeAvatar, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResponsableOuTitulaire, Mode=OneWay, FallbackValue='— Non pourvu —'}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SousTitre, Mode=OneWay}"
                                               FontSize="9.5" Foreground="{StaticResource InkSubtleBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pied de carte : Décompte effectif -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleFaintBrush}" BorderThickness="0,1,0,0"
                            Padding="8,4" CornerRadius="0,0,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Effectif : " FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                                <TextBlock Text="{Binding EffectifTotal, Mode=OneWay}" FontWeight="SemiBold"
                                           FontSize="10.5" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text=" pers." FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="Postes : " FontSize="10"
                                       Foreground="{StaticResource InkSubtleBrush}"
                                       Visibility="{Binding EstUnite, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding NombrePostes, StringFormat='{}Postes: {0}', Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource InkBrush}"
                                       Visibility="{Binding EstUnite, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="350"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ 1. En-tête de l'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Organigramme d'entreprise" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Directions, services, nomenclature des postes et rattachements hiérarchiques N+1"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <!-- Actions globales -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Initialiser structure" Tag="{StaticResource IconAdd}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding InitialiserDefautCommand}"
                        ToolTip="Génère une structure organisationnelle type burkinabè ou synchronise les services existants"/>
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding RechargerCommand}"/>
                <Button Content="Export Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding ExporterExcelCommand}"/>
                <Button Content="Export PDF" Tag="{StaticResource IconPdf}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0"
                        Command="{Binding ExporterPdfCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ 2. Cartouches statistiques ═══════════ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL UNITÉS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalUnites, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Directions &amp; Services" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="DIRECTIONS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalDirections, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Directions générales &amp; directes" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SERVICES" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalServices, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock Text="Services &amp; Pôles opérationnels" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="POSTES BUDGÉTÉS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalPostes, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Nomenclature des emplois" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="POSTES POURVUS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalPostesPourvus, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="Titulaires en fonction" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="5">
                    <TextBlock Text="POSTES VACANTS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource InkSubtleBrush}"/>
                    <TextBlock Text="{Binding TotalPostesVacants, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="Postes sans titulaire" FontSize="10" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 3. Barre d'onglets ═══════════ -->
        <DockPanel Grid.Row="2" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <RadioButton Content="Vue Graphique de l'Organigramme" Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=0, Mode=TwoWay}"
                             Command="{Binding ResetZoomCommand}"/>

                <RadioButton Content="Directions &amp; Services" Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1, Mode=TwoWay}"/>

                <RadioButton Content="Postes &amp; Fonctions" Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=2, Mode=TwoWay}"/>

                <RadioButton Content="Salariés &amp; Affectations" Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=3, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Barre de recherche rapide intégrée -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="Rechercher :" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,6,0"/>
                <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}"
                         Width="200" Style="{StaticResource FormTextBoxStyle}" Padding="6,4"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══════════ 4. Contenu des 4 onglets ═══════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource RuleStrongBrush}" BorderThickness="1"
                CornerRadius="0,0,4,4" Padding="14">

            <Grid>
                <!-- ───────── ONGLET 0 : VUE GRAPHIQUE ───────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre d'outils du graphique -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Déplier tout" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,6,0"
                                        Command="{Binding DeplierToutCommand}"/>
                                <Button Content="Replier tout" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,14,0"
                                        Command="{Binding ReplierToutCommand}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" Content="Afficher également les postes dans l'organigramme"
                                      IsChecked="{Binding InclurePostesDansArbre}"
                                      VerticalAlignment="Center" FontSize="11" Margin="0,0,14,0"/>

                            <!-- Zoom controls -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Zoom :" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,6,0"/>
                                <Button Content="-" Width="24" Height="24" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,3,0"
                                        Command="{Binding ZoomOutCommand}" ToolTip="Zoom arrière"/>
                                <TextBlock Text="{Binding ZoomLevelPourcentage, Mode=OneWay}"
                                           Width="46" TextAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <Button Content="+" Width="24" Height="24" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="3,0,6,0"
                                        Command="{Binding ZoomInCommand}" ToolTip="Zoom avant"/>
                                <Button Content="100%" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" Margin="0"
                                        Command="{Binding ResetZoomCommand}" ToolTip="Réinitialiser zoom"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Zone de rendu graphique de l'arbre -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#F8FAFC">
                        <Grid Margin="20">
                            <TreeView ItemsSource="{Binding ArbreRacines}"
                                      SelectedItemChanged="TreeView_SelectedItemChanged"
                                      BorderThickness="0" Background="Transparent">
                                <TreeView.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                </TreeView.LayoutTransform>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ───────── ONGLET 1 : DIRECTIONS & SERVICES ───────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau de gauche -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="DIRECTIONS &amp; SERVICES DU DOSSIER" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                            <Button Content="Nouvelle entité" Tag="{StaticResource IconAdd}"
                                    Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right" Padding="10,4"
                                    Command="{Binding NouvelleUniteCommand}"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Unites}"
                                  SelectedItem="{Binding UniteSelectionnee}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="85"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding BadgeTypeLibelle, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Parent" Binding="{Binding ParentLibelle, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding ResponsableNom, Mode=OneWay}" Width="140"/>
                                <DataGridTextColumn Header="Postes" Binding="{Binding NombrePostes, Mode=OneWay}" Width="65"/>
                                <DataGridTextColumn Header="Direct" Binding="{Binding NombreSalariesDirects, Mode=OneWay}" Width="65"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding NombreSalariesTotal, Mode=OneWay}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Formulaire latéral droit -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Background="{StaticResource SurfaceAltBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="FICHE DE L'UNITÉ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>

                                <TextBlock Text="Code :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <TextBox Text="{Binding UniteEnEdition.Code, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Libellé de l'entité :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <TextBox Text="{Binding UniteEnEdition.Libelle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Type d'unité :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TypesUniteDisponibles}"
                                          SelectedItem="{Binding UniteEnEdition.TypeUnite}"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Rattachement hiérarchique (Parent) :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ParentsDisponibles}"
                                          SelectedValue="{Binding UniteEnEdition.ParentId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Responsable désigné :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ResponsablesDisponibles}"
                                          SelectedValue="{Binding UniteEnEdition.ResponsableMatricule}"
                                          SelectedValuePath="EmployeeId"
                                          DisplayMemberPath="FullNameWithId"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Description / Attributions :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <TextBox Text="{Binding UniteEnEdition.Description, UpdateSourceTrigger=PropertyChanged}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="Ordre d'affichage :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <TextBox Text="{Binding UniteEnEdition.Ordre, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <!-- Boutons d'action -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding SupprimerUniteCommand}"
                                            Visibility="{Binding EstEnEditionUnite, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                            Style="{StaticResource MenuButtonStyle}" Margin="0"
                                            Command="{Binding EnregistrerUniteCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ───────── ONGLET 2 : POSTES & FONCTIONS ───────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau des postes -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RÉPERTOIRE DES POSTES" Style="{StaticResource SectionLabelStyle}" Margin="0,0,12,0"/>
                                <ComboBox Width="110" Style="{StaticResource FormComboBoxStyle}"
                                          SelectedItem="{Binding FiltreStatutPoste}">
                                    <ComboBoxItem Content="Tous"/>
                                    <ComboBoxItem Content="Pourvus"/>
                                    <ComboBoxItem Content="Vacants"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Content="Nouveau poste" Tag="{StaticResource IconAdd}"
                                    Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right" Padding="10,4"
                                    Command="{Binding NouveauPosteCommand}"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Postes}"
                                  SelectedItem="{Binding PosteSelectionne}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn Header="Intitulé du Poste" Binding="{Binding Intitule, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding UniteLibelle, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Effectif GPEC" Binding="{Binding BadgeEffectifGpec, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatutOccupationGpec, Mode=OneWay}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Formulaire latéral droit : Fiche de poste complète -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Background="{StaticResource SurfaceAltBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="FICHE DE POSTE DÉTAILLÉE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                                    <Button Content="Exporter Fiche PDF" Tag="{StaticResource IconPdf}"
                                            Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right" Padding="10,4"
                                            Command="{Binding ExporterFichePostePdfCommand}"/>
                                </DockPanel>

                                <!-- 1. Identification du poste -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="1. IDENTIFICATION &amp; RATTACHEMENT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Code :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Intitulé du poste :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.Intitule, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Effectif budgété :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.EffectifRequis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Unité / Direction :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding UnitesRattachementDisponibles}"
                                                          SelectedValue="{Binding PosteEnEdition.UniteId}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{StaticResource FormComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Supérieur direct N+1 :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding SuperieursDisponibles}"
                                                          SelectedValue="{Binding PosteEnEdition.SuperieurPosteId}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{StaticResource FormComboBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Missions & Activités clés -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="2. MISSIONS &amp; ACTIVITÉS CLÉS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <TextBlock Text="Finalité principale du poste :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                        <TextBox Text="{Binding PosteEnEdition.FinalitePrincipale, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="45" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,6"/>

                                        <TextBlock Text="Activités clés &amp; Tâches régulières :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                        <TextBox Text="{Binding PosteEnEdition.ActivitesCles, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Profil requis & Conditions -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="3. PROFIL REQUIS &amp; CONDITIONS DE TRAVAIL" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Niveau d'étude :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.NiveauEtudeRequis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Diplôme exigé :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.DiplomeRequis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Expérience (ans) :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.ExperienceMinimaleAnnees, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Conditions particulières de travail (déplacements, horaires, etc.) :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                        <TextBox Text="{Binding PosteEnEdition.ConditionsTravail, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Classification & Rémunération indicative -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="4. CLASSIFICATION CONVENTIONNELLE &amp; CADRE SALARIAL" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Convention collective :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.ConventionLibelle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Catégorie conventionnelle :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.CategorieConventionnelle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Échelon indicatif :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.EchelonConventionnel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Min. Convention (FCFA) :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.SalaireMinimumConventionnel, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Salaire Min Budgété :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.SalaireMinBudgete, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Salaire Max Budgété :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                                <TextBox Text="{Binding PosteEnEdition.SalaireMaxBudgete, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource FormTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 5. Compétences requises -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="5. COMPÉTENCES REQUISES (CATALOGUE D'ENTREPRISE)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <DataGrid ItemsSource="{Binding CompetencesPosteEnEdition}"
                                                  SelectedItem="{Binding CompetencePosteSelectionnee}"
                                                  Style="{StaticResource FormDataGridStyle}"
                                                  MaxHeight="140" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,0,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding CompetenceCode, Mode=OneWay}" Width="70"/>
                                                <DataGridTextColumn Header="Compétence" Binding="{Binding CompetenceLibelle, Mode=OneWay}" Width="*"/>
                                                <DataGridTextColumn Header="Domaine" Binding="{Binding DomaineLibelle, Mode=OneWay}" Width="100"/>
                                                <DataGridTextColumn Header="Niveau" Binding="{Binding NiveauEtoiles, Mode=OneWay}" Width="75"/>
                                                <DataGridCheckBoxColumn Header="Requis" Binding="{Binding EstObligatoire, Mode=OneWay}" Width="55"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Barre d'ajout rapide de compétence -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding CompetencesDisponibles}"
                                                      SelectedItem="{Binding CompetenceSelectionneePourAjout}"
                                                      DisplayMemberPath="Libelle"
                                                      Style="{StaticResource FormComboBoxStyle}" Margin="0,0,6,0"/>

                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding NiveauMaitrisePourAjout, Mode=TwoWay}"
                                                      Style="{StaticResource FormComboBoxStyle}" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Niv 1 (★)"/>
                                                <ComboBoxItem Content="Niv 2 (★★)"/>
                                                <ComboBoxItem Content="Niv 3 (★★★)"/>
                                                <ComboBoxItem Content="Niv 4 (★★★★)"/>
                                            </ComboBox>

                                            <CheckBox Grid.Column="2" Content="Requis" IsChecked="{Binding EstObligatoirePourAjout}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <Button Grid.Column="3" Content="Ajouter" Tag="{StaticResource IconAdd}"
                                                    Style="{StaticResource MenuButtonStyle}" Margin="0,0,6,0" Padding="8,4"
                                                    Command="{Binding AjouterCompetencePosteCommand}"/>

                                            <Button Grid.Column="4" Content="Retirer" Tag="{StaticResource IconDelete}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                                    Command="{Binding SupprimerCompetencePosteCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 6. Titulaires actuels du poste -->
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="6. TITULAIRES ACTUELS DU POSTE (OCCUPATION RÉELLE)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBlueDarkBrush}" Margin="0,0,0,8"/>

                                        <DataGrid ItemsSource="{Binding TitulairesPosteEnEdition}"
                                                  Style="{StaticResource FormDataGridStyle}"
                                                  MaxHeight="120" IsReadOnly="True" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule, Mode=OneWay}" Width="75"/>
                                                <DataGridTextColumn Header="Nom &amp; Prénoms" Binding="{Binding NomComplet, Mode=OneWay}" Width="*"/>
                                                <DataGridTextColumn Header="Embauche" Binding="{Binding DateEmbaucheTexte, Mode=OneWay}" Width="85"/>
                                                <DataGridTextColumn Header="Contrat" Binding="{Binding TypeContrat, Mode=OneWay}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Boutons d'action enregistrement / suppression -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding SupprimerPosteCommand}"
                                            Visibility="{Binding EstEnEditionPoste, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Enregistrer le poste" Tag="{StaticResource IconSave}"
                                            Style="{StaticResource MenuButtonStyle}" Margin="0"
                                            Command="{Binding EnregistrerPosteCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ───────── ONGLET 3 : SALARIÉS & AFFECTATIONS ───────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau salariés -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AFFECTATIONS ORGANISATIONNELLES DES SALARIÉS"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Affectations}"
                                  SelectedItem="{Binding AffectationSelectionnee}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="Nom &amp; Prénoms" Binding="{Binding NomComplet, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceActuel, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Poste" Binding="{Binding PosteActuelLibelle, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Manager N+1" Binding="{Binding ManagerActuelNom, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Panneau d'affectation rapide -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Background="{StaticResource SurfaceAltBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="AFFECTATION DU COLLABORATEUR" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12"/>

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AffectationSelectionnee.NomComplet, FallbackValue='Sélectionnez un salarié'}"
                                                   FontWeight="Bold" FontSize="13" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock Text="{Binding AffectationSelectionnee.Matricule, StringFormat='{}Matricule : {0}'}"
                                                   FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Service de rattachement :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ServicesDisponibles}"
                                          SelectedItem="{Binding ServiceAffectationChoisi}"
                                          IsEditable="True"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Poste de travail occupé :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Postes}"
                                          SelectedItem="{Binding PosteAffectationChoisi}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Manager direct (N+1) :" Style="{StaticResource FormTextBlockLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ResponsablesDisponibles}"
                                          SelectedItem="{Binding ManagerAffectationChoisi}"
                                          DisplayMemberPath="FullNameWithId"
                                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,16"/>

                                <Button Content="Enregistrer l'affectation" Tag="{StaticResource IconSave}"
                                        Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right" Margin="0"
                                        Command="{Binding EnregistrerAffectationCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
