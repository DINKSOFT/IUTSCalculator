        <!-- ═══════════════════════════════════════════════════════════════════
             COLONNE PRINCIPALE
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource GroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bandeau : le dossier courant, remonté de la barre d'état.
                 C'est l'information qu'il ne faut jamais confondre quand on
                 gère plusieurs sociétés. -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,20,0">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Bouton pour masquer/réafficher le rail de navigation -->
                        <Button Style="{StaticResource HeaderIconButtonStyle}"
                                Tag="{StaticResource IconMenu}"
                                ToolTip="Afficher / masquer le menu latéral (Ctrl+B)"
                                Command="{Binding ToggleNavRailCommand}"
                                Margin="0,0,10,0"/>

                        <Button VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Tag="{StaticResource IconRefresh}"
                                Content="{Binding CurrentDossierName}"
                                ToolTip="Changer de dossier"
                                Click="ChangeDossier_Click"/>
                    </StackPanel>

                    <Menu HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="Transparent" BorderThickness="0" Padding="0">
                        <MenuItem Padding="8,4">
                            <MenuItem.Header>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="{StaticResource IconMore}"
                                           FontSize="16"
                                           Foreground="{StaticResource InkMutedBrush}"/>
                            </MenuItem.Header>

                            <MenuItem x:Name="MenuUtilisateurCourant" IsEnabled="False"/>
                            <MenuItem x:Name="MenuGestionUtilisateurs" Header="Gestion des utilisateurs…" Click="GererUtilisateurs_Click"/>
                            <MenuItem Header="Se déconnecter" Click="Deconnexion_Click"/>
                            <Separator/>
                            <MenuItem Header="Nouveau calcul" Command="{Binding NewCalculationCommand}"/>
                            <MenuItem Header="Enregistrer" Command="{Binding SaveDataCommand}"/>
                            <MenuItem Header="Exporter en PDF" Command="{Binding ExportToPdfCommand}"/>
                            <Separator/>
                            <MenuItem Header="Afficher / Masquer le menu latéral"
                                      InputGestureText="Ctrl+B"
                                      Command="{Binding ToggleNavRailCommand}"/>
                            <MenuItem Header="Changer de dossier..." Click="ChangeDossier_Click"/>
                            <MenuItem Header="Sauvegarder les données…" Click="Sauvegarder_Click"/>
                            <MenuItem Header="Préférences d'affichage" Click="DisplayPreferences_Click"/>
                            <Separator/>
                            <MenuItem Header="Documentation" Click="OpenDocumentation_Click"/>
                            <MenuItem Header="Activer le logiciel / licence…" Click="ActiverLicence_Click"/>
                            <MenuItem Header="À propos" Click="About_Click"/>
                            <Separator/>
                            <MenuItem Header="Quitter" Click="Exit_Click"/>
                        </MenuItem>
                    </Menu>
                </Grid>
            </Border>

            <!-- Vue dynamique selon le ViewModel courant -->
            <ContentControl Grid.Row="1" Margin="20,18,20,18"
                            Content="{Binding CurrentViewModel}"/>

            <!-- Barre d'état -->
            <Border Grid.Row="2" Height="28" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                   Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                        <Run Text="Dossier : "/>
                        <Run Text="{Binding CurrentDossierName, Mode=OneWay}"/>
                        <Run Text="   ·   "/>
                        <Run Text="{Binding VersionProgramme, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
