<Window x:Class="IUTSCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IUTSCalculator"
        xmlns:views="clr-namespace:IUTSCalculator.Views"
        xmlns:viewModels="clr-namespace:IUTSCalculator.ViewModels"
        mc:Ignorable="d"
        Title="Sigma Paie &amp; RH"
        Height="700"
        Width="1200"
        MinHeight="560"
        MinWidth="980"
        FontFamily="Segoe UI"
        Background="{StaticResource GroundBrush}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleNavRailCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Association ViewModel → Vue -->
            <DataTemplate DataType="{x:Type viewModels:CalculationViewModel}">
                <views:CalculationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BaseSalaryEstimatorViewModel}">
                <views:BaseSalaryEstimatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BatchSalaryCalculationViewModel}">
                <views:BatchSalaryCalculationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BatchSalaryEstimationViewModel}">
                <views:BatchSalaryEstimationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BulletinViewModel}">
                <views:BulletinView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BulletinBatchViewModel}">
                <views:BulletinBatchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:EmployeeManagementViewModel}">
                <views:EmployeeManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:RubriqueViewModel}">
                <views:RubriqueView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:BaremeViewModel}">
                <views:BaremeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PeriodePaieViewModel}">
                <views:PeriodePaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DeclarationCnssViewModel}">
                <views:DeclarationCnssView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DeclarationIutsTpaViewModel}">
                <views:DeclarationIutsTpaView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:LivrePaieViewModel}">
                <views:LivrePaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:EtatAnnuelSalairesViewModel}">
                <views:EtatAnnuelSalairesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:TableauBordMasseSalarialeViewModel}">
                <views:TableauBordMasseSalarialeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:OrganigrammeViewModel}">
                <views:OrganigrammeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SuiviPostesBudgetViewModel}">
                <views:SuiviPostesBudgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:EntretiensEvaluationsViewModel}">
                <views:EntretiensEvaluationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:FormationViewModel}">
                <views:FormationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:RecrutementViewModel}">
                <views:RecrutementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:GestionTempsViewModel}">
                <views:GestionTempsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DisciplineViewModel}">
                <views:DisciplineView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SanteSecuriteViewModel}">
                <views:SanteSecuriteView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:EcriturePaieViewModel}">
                <views:EcriturePaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:OrdreVirementViewModel}">
                <views:OrdreVirementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ControleEquivalenceViewModel}">
                <views:ControleEquivalenceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AbsenceViewModel}">
                <views:AbsenceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PretViewModel}">
                <views:PretView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ProfilPaieViewModel}">
                <views:ProfilPaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:VariablePaieViewModel}">
                <views:VariablePaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AuditViewModel}">
                <views:AuditView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:HeuresSupplementairesViewModel}">
                <views:HeuresSupplementairesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ConventionCollectiveViewModel}">
                <views:ConventionCollectiveView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SoldeToutCompteViewModel}">
                <views:SoldeToutCompteView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SaisieOppositionViewModel}">
                <views:SaisieOppositionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:RappelPaieViewModel}">
                <views:RappelPaieView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AvantageNatureViewModel}">
                <views:AvantageNatureView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             RAIL DE NAVIGATION
             Les boutons du menu latéral, regroupés par domaine.
             Peut être masqué pour libérer de l'espace sur petits écrans.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Width="234"
                Background="{StaticResource RailBrush}"
                Visibility="{Binding IsNavRailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>

                <!-- Marque et bouton de masquage -->
                <Border DockPanel.Dock="Top" Height="64"
                        BorderBrush="{StaticResource RailBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0,12,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Sigma" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="PAIE &amp; RH" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource RailTextDimBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Style="{StaticResource RailIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Tag="{StaticResource IconCollapseLeft}"
                                ToolTip="Masquer le menu latéral (Ctrl+B)"
                                Command="{Binding ToggleNavRailCommand}"/>
                    </Grid>
                </Border>

                <!-- Barre de recherche du menu latéral -->
                <Border DockPanel.Dock="Top"
                        Margin="10,10,10,6">
                    <StackPanel>
                        <!-- Champ de recherche stylé aux couleurs du rail -->
                        <Border Background="#141D1F"
                                BorderBrush="{StaticResource RailBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="32">
                            <Grid Margin="8,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icône loupe -->
                                <TextBlock Grid.Column="0"
                                           Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource RailTextDimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>

                                <!-- Placeholder / Hint -->
                                <TextBlock Grid.Column="1"
                                           Text="Rechercher... (Ctrl+F)"
                                           Foreground="{StaticResource RailTextDimBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNavMenuSearchText}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Zone de saisie -->
                                <TextBox x:Name="NavMenuSearchBox"
                                         Grid.Column="1"
                                         Text="{Binding NavMenuSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         CaretBrush="White">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding NavigateToFirstNavMatchCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding ClearNavMenuSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Bouton Effacer (X) -->
                                <Button Grid.Column="2"
                                        Command="{Binding ClearNavMenuSearchCommand}"
                                        Tag="{StaticResource IconClear}"
                                        Width="22" Height="22"
                                        ToolTip="Effacer la recherche (Échap)"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNavMenuSearchText}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Indicateur du nombre de résultats trouvés quand une recherche est active -->
                        <TextBlock Text="{Binding NavMenuMatchCountText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RailTextDimBrush}"
                                   Margin="6,4,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNavMenuSearchText}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Paramètres, détaché du reste -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource RailBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="10,8,10,12"
                        Visibility="{Binding IsNavSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Tag="{StaticResource IconSettings}" Content="Paramètres"
                            Command="{Binding NavigateToSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Paramètres">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,4,10,12">

                        <!-- ───── PAIE ───── -->
                        <TextBlock Text="PAIE" Style="{StaticResource NavGroupHeaderStyle}"
                                   Visibility="{Binding IsNavGroupPaieVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="{StaticResource IconPdf}" Content="Bulletin de paie"
                                Command="{Binding NavigateToBulletinCommand}"
                                Visibility="{Binding IsNavBulletinVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Bulletin de paie">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconBatch}" Content="Bulletins en masse"
                                Command="{Binding NavigateToBulletinBatchCommand}"
                                Visibility="{Binding IsNavBulletinBatchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Bulletins de paie en masse">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconHistory}" Content="Rappels &amp; régularisations"
                                Command="{Binding NavigateToRappelsCommand}"
                                Visibility="{Binding IsNavRappelsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Rappels &amp; régularisations">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconEmploye}" Content="Avantages en nature"
                                Command="{Binding NavigateToAvantagesNatureCommand}"
                                Visibility="{Binding IsNavAvantagesNatureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Avantages en nature">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconReset}" Content="Solde de tout compte"
                                Command="{Binding NavigateToSoldeToutCompteCommand}"
                                Visibility="{Binding IsNavSoldeToutCompteVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Solde de Tout Compte &amp; Départs">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ───── CALCUL ───── -->
                        <TextBlock Text="CALCUL" Style="{StaticResource NavGroupHeaderStyle}"
                                   Visibility="{Binding IsNavGroupCalculVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="{StaticResource IconCalculator}" Content="Calcul d'IUTS"
                                Command="{Binding NavigateToCalculationCommand}"
                                Visibility="{Binding IsNavCalculVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Calcul d'IUTS">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExcel}" Content="Calcul en lot"
                                Command="{Binding NavigateToBatchSalaryCalculationCommand}"
                                Visibility="{Binding IsNavCalculBatchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Calcul de salaires en lot">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconEstimate}" Content="Estimation du salaire"
                                Command="{Binding NavigateToBaseSalaryEstimatorCommand}"
                                Visibility="{Binding IsNavEstimationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Estimation du salaire de base">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconEstimate}" Content="Estimation en lot"
                                Command="{Binding NavigateToBatchSalaryEstimationCommand}"
                                Visibility="{Binding IsNavEstimationBatchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Estimation de salaires en lot">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ───── DONNÉES ───── -->
                        <TextBlock Text="DONNÉES" Style="{StaticResource NavGroupHeaderStyle}"
                                   Visibility="{Binding IsNavGroupDonneesVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="{StaticResource IconEmploye}" Content="Employés"
                                Command="{Binding NavigateToEmployeeManagementCommand}"
                                Visibility="{Binding IsNavEmployesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Gestion des employés">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconHistory}" Content="Historique"
                                Command="{Binding NavigateToHistoryCommand}"
                                Visibility="{Binding IsNavHistoriqueVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Historique">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ───── DÉCLARATIONS ───── -->
                        <TextBlock Text="DÉCLARATIONS" Style="{StaticResource NavGroupHeaderStyle}"
                                   Visibility="{Binding IsNavGroupDeclarationsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="{StaticResource IconExport}" Content="Déclaration CNSS"
                                Command="{Binding NavigateToDeclarationCnssCommand}"
                                Visibility="{Binding IsNavCnssVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Déclaration CNSS">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExport}" Content="Déclaration IUTS/TPA"
                                Command="{Binding NavigateToDeclarationIutsTpaCommand}"
                                Visibility="{Binding IsNavIutsTpaVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Déclaration IUTS/TPA">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExport}" Content="Livre de paie"
                                Command="{Binding NavigateToLivrePaieCommand}"
                                Visibility="{Binding IsNavLivrePaieVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Livre de paie">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExport}" Content="État annuel des salaires (DADS)"
                                Command="{Binding NavigateToEtatAnnuelSalairesCommand}"
                                Visibility="{Binding IsNavEtatAnnuelSalairesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="État annuel des salaires">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExport}" Content="Écritures de paie"
                                Command="{Binding NavigateToEcriturePaieCommand}"
                                Visibility="{Binding IsNavEcriturePaieVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Écritures de paie">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="{StaticResource IconExport}" Content="Ordres de virement"
                                Command="{Binding NavigateToOrdreVirementCommand}"
                                Visibility="{Binding IsNavOrdreVirementVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.Title}" Value="Ordres de virement">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ───── PILOTAGE ───── -->
                        <TextBlock Text="PILOTAGE" Style="{StaticResource NavGroupHeaderStyle}"
                                   Visibility="{Binding IsNavGroupPilotageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Tag="{StaticResource IconExport}" Content="Tableau de bord masse salariale"
                                Command="{Binding NavigateToTableauBordMasseSalarialeCommand}"
                                Visibility="{Binding IsNavTableauBordMasseSalarialeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
