<UserControl x:Class="IUTSCalculator.Views.EcriturePaieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:EcriturePaieViewModel}"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalBadgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="TotalBadgeValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Écritures de paie SYSCOHADA" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Pièce de paie mensuelle : centralisation équilibrée des charges et des tiers, exportable vers Sage 100c Comptabilité"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Export Sage 100c" Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Fichier d'import Sage 100c Comptabilité (texte délimité par des points-virgules, encodé Windows-1252) : JO_Num, EC_Reference, Date, EC_Piece, CG_Num, CT_Num, EC_Intitule, Sens, Montant. Refusé si la pièce n'est pas équilibrée."
                        Command="{Binding ExporterSageCommand}"/>
                <Button Content="Fichier d'import (.txt)" Tag="{StaticResource IconSave}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Fichier texte générique (Date;Journal;Piece;Compte;Libelle;Debit;Credit, UTF-8) — ce n'est pas le format d'import de Sage."
                        Command="{Binding ExporterTxtCommand}"/>
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterExcelCommand}"/>
                <Button Content="Générer l'écriture" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding GenererCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres de sélection ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mois -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Mois" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="160" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding MoisDisponibles}"
                              DisplayMemberPath="Nom"
                              SelectedItem="{Binding MoisSelectionne}"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="110" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <!-- Période / Pièce info -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PeriodeChoisieLibelle}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding PieceComptable.NumeroPiece, StringFormat='Pièce : {0}', FallbackValue='Pièce : —'}"
                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding LongueurComptesLibelle, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
        <!-- ═══════════ Résultat (Tableau comptable) ═══════════ -->
        <TabItem Header="Écriture du mois">
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <!-- En-tête de la carte avec statut d'équilibre et badge brouillon -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EnteteJournal, Mode=OneWay}"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding PieceComptable.EstBrouillon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="BROUILLON (PÉRIODE NON CLÔTURÉE)" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Border>

                            <Border Background="#EBF7F0" BorderBrush="#2BA24C" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2"
                                    Visibility="{Binding EstEquilibree, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✓ PIÈCE ÉQUILIBRÉE" FontSize="10" FontWeight="Bold" Foreground="#1F7A4D"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding APieceComptable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Total Débit : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDebit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Text="|" Foreground="{StaticResource RuleStrongBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Total Crédit : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCredit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Text="|" Foreground="{StaticResource RuleStrongBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Text="Écart : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Ecart, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding EstEquilibree, Converter={StaticResource BoolToTypeConverter}, ConverterParameter='text:#1F7A4D;#9C2F28'}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bandeau de totaux en pied de tableau -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="16,10"
                        Visibility="{Binding APieceComptable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ÉCRITURE COMPTABLE MENSUELLE SYSCOHADA" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding PieceComptable.NumeroPiece, Mode=OneWay, StringFormat='Réf. Pièce : {0}'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="TOTAL DÉBIT" Style="{StaticResource TotalBadgeLabel}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalDebit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Border Grid.Column="2" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="TOTAL CRÉDIT" Style="{StaticResource TotalBadgeLabel}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalCredit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Border Grid.Column="4" Background="#E6F0ED" CornerRadius="4" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ÉCART : " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"/>
                                <TextBlock Text="{Binding Ecart, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush2}"/>
                                <TextBlock Text=" FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding APieceComptable, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucune écriture comptable générée" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Choisissez le mois et l'année, puis cliquez sur « Générer l'écriture » pour visualiser la pièce d'OD de paie."
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                </StackPanel>

                <!-- Tableau comptable -->
                <DataGrid ItemsSource="{Binding Lignes}"
                          Style="{StaticResource FormDataGridStyle}"
                          Margin="0" BorderThickness="0" IsReadOnly="True"
                          AutoGenerateColumns="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding APieceComptable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding Ordre, Mode=OneWay}"
                                            Width="50" MinWidth="40"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding DateEcriture, StringFormat='dd/MM/yyyy', Mode=OneWay}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Journal" Binding="{Binding CodeJournal, Mode=OneWay}"
                                            Width="65" MinWidth="55"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="N° Pièce" Binding="{Binding ReferencePiece, Mode=OneWay}"
                                            Width="120" MinWidth="100"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Compte" Binding="{Binding CompteGeneral, Mode=OneWay}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Intitulé du compte" Binding="{Binding IntituleCompte, Mode=OneWay}"
                                            Width="220" MinWidth="180"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Libellé de l'opération" Binding="{Binding LibelleOperation, Mode=OneWay}"
                                            Width="*" MinWidth="200"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Débit"
                                            Binding="{Binding Debit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="120" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                        <DataGridTextColumn Header="Crédit"
                                            Binding="{Binding Credit, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="120" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        </TabItem>

        <!-- ═══════════ Paramètres comptables du dossier (défaut 20) ═══════════ -->
        <TabItem Header="Paramètres comptables">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Padding="12,8" Margin="0,0,0,10" CornerRadius="3"
                            Background="{StaticResource WarningTintBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Visibility="{Binding ParametresNonEnregistrables, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="La base de ce dossier n'a pas encore reçu la mise à niveau des paramètres comptables (schéma v38) : les valeurs d'origine sont utilisées et ne peuvent pas être modifiées."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Journal, pièce, longueur -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,8,0" VerticalAlignment="Top">
                            <StackPanel DataContext="{Binding Parametres}">
                                <TextBlock Text="JOURNAL ET PIÈCE" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="Code journal (JO_Num)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Width="110" HorizontalAlignment="Left" MaxLength="6"
                                         Text="{Binding CodeJournal, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Libellé du journal" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding LibelleJournal, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="N° de pièce (EC_Piece)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding FormatPiece, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Référence (EC_Reference)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding FormatReference, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Variables : {AAAA} année, {AA} année sur 2 chiffres, {MM} mois. Sage limite la pièce à 13 caractères et la référence à 17."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Longueur des comptes généraux (0 = automatique)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding LongueurComptes, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="Les comptes plus courts sont complétés par des zéros à droite (6611 → 661100). Automatique : longueur du plus long compte utilisé (Plan de paie et comptes ci-contre)."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,0,8"/>

                                <CheckBox Content="Ligne d'en-tête (noms des colonnes) dans le fichier Sage" Style="{StaticResource FormCheckBoxStyle}" Margin="0,4,0,4"
                                          IsChecked="{Binding EnTeteFichierSage}"/>
                            </StackPanel>
                        </Border>

                        <!-- Comptes de charges -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,8,0" VerticalAlignment="Top">
                            <StackPanel DataContext="{Binding Parametres}">
                                <TextBlock Text="COMPTES DE CHARGES (DÉBIT)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="Charges sociales patronales CNSS" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteChargesCnss, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Taxe patronale et d'apprentissage (charge)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteChargeTpa, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="COMPTES DE REPLI" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,4"/>
                                <TextBlock Text="Utilisés seulement quand la rubrique du Plan de paie n'a pas de compte."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Salaire de base (et absences)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteSalaireBase, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Indemnité de logement" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteIndemniteLogement, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Indemnité de transport" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteIndemniteTransport, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Indemnité de fonction" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteIndemniteFonction, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Indemnité de sujétion" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteIndemniteSujetion, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Gains variables" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteGainsVariables, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Comptes de tiers -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" VerticalAlignment="Top">
                            <StackPanel DataContext="{Binding Parametres}">
                                <TextBlock Text="COMPTES DE TIERS (CRÉDIT)" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="CNSS à payer (parts salariale et patronale)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteCnss, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="IUTS retenu à reverser" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteIuts, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="TPA à payer" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteTpa, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Retenue spéciale à reverser" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteRetenueSpeciale, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Net à payer (rémunérations dues)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteNetAPayer, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Retenues diverses (repli)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding CompteRetenuesDiverses, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Les comptes IUTS et CNSS se règlent ici : les comptes de contrepartie des rubriques IUTS et CNSS du Plan de paie ne sont pas utilisés par l'écriture."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding ApercuParametres, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource InkBrush}" Margin="2,12,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Enregistrer les paramètres" Tag="{StaticResource IconSave}"
                                Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding EnregistrerParametresCommand}"/>
                        <Button Content="Annuler les modifications" Tag="{StaticResource IconCancel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AnnulerParametresCommand}"/>
                        <Button Content="Rétablir les valeurs d'origine" Tag="{StaticResource IconReset}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Remet dans le formulaire les comptes que le programme utilisait avant le paramétrage ; il reste à enregistrer."
                                Command="{Binding RetablirParametresCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding MessageParametres}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource InkMutedBrush}" Margin="2,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="AVERTISSEMENTS ET POINTS D'ATTENTION" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
