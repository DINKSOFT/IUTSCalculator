<UserControl x:Class="IUTSCalculator.Views.DeclarationCnssView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:DeclarationCnssViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="TotalValeur" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Déclaration CNSS" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Bordereau de cotisations et état nominatif, construits depuis la paie déjà saisie"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterCommand}"/>
                <Button Content="Générer la déclaration" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding GenererCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rythme -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RYTHME" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                    <RadioButton Content="Mensuelle" GroupName="Periodicite" Margin="0,0,0,6"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 IsChecked="{Binding EstMensuelle}"/>
                    <RadioButton Content="Trimestrielle" GroupName="Periodicite"
                                 Style="{StaticResource FormRadioButtonStyle}"
                                 IsChecked="{Binding EstTrimestrielle}"/>
                </StackPanel>

                <!-- Mois -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                            Visibility="{Binding EstMensuelle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Mois déclaré" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="150" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding MoisDisponibles}"
                              DisplayMemberPath="Nom"
                              SelectedItem="{Binding MoisSelectionne}"/>
                </StackPanel>

                <!-- Trimestre -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                            Visibility="{Binding EstTrimestrielle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Trimestre déclaré" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="150" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding TrimestresDisponibles}"
                              SelectedItem="{Binding TrimestreSelectionne}"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="100" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <!-- Aide au choix du rythme -->
                <StackPanel Grid.Column="6" VerticalAlignment="Top">
                    <TextBlock Text="Seuil légal" Style="{StaticResource FieldLabel}"/>
                    <Button Content="Déterminer d'après l'effectif" Margin="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="20 salariés et plus : déclaration mensuelle. En dessous : trimestrielle."
                            Command="{Binding DeterminerPeriodiciteCommand}"/>
                </StackPanel>

                <TextBlock Grid.Column="7" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                           Text="{Binding PeriodeChoisieLibelle}"/>
            </Grid>
        </Border>

        <!-- ═══════════ Résultat ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- État nominatif -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="ÉTAT NOMINATIF" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <!-- État vide -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding ADeclaration, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucune déclaration générée" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Choisissez la période et le rythme, puis générez la déclaration depuis les bulletins enregistrés."
                                   FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Lignes}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0" IsReadOnly="True"
                              Visibility="{Binding ADeclaration, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule CNSS" Binding="{Binding NumeroCnss}"
                                                Width="130" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Nom et prénoms" Binding="{Binding NomComplet}"
                                                Width="2*" MinWidth="180"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Brut"
                                                Binding="{Binding SalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="100"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Assiette"
                                                Binding="{Binding AssiettePlafonnee, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="100"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Part salariale"
                                                Binding="{Binding CotisationSalariale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="100"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Part patronale"
                                                Binding="{Binding CotisationPatronale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="100"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Observation" Binding="{Binding Anomalie}"
                                                Width="2*" MinWidth="160"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AUneAnomalie}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bordereau -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0"
                    Visibility="{Binding ADeclaration, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="BORDEREAU" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel DataContext="{Binding Declaration}">

                            <TextBlock Text="{Binding PeriodeLibelle}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding EcheanceLibelle}" FontSize="11" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EcheanceDepassee}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Assiette -->
                            <TextBlock Text="ASSIETTE" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Effectif déclaré" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding Effectif, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Salaires bruts" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalSalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Assiette cotisable" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Foreground="{StaticResource AccentBrush2}"
                                           Text="{Binding TotalAssiette, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <!-- Branches -->
                            <TextBlock Text="COTISATIONS PAR BRANCHE" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prestations familiales" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding PrestationsFamiliales, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Risques professionnels" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding RisquesProfessionnels, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pensions — patronale" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding PensionsPatronal, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Pensions — salariale" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding PensionsSalarial, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL À VERSER" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush2}"
                                           Text="{Binding TotalCotisationsAttendu, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <!-- Rapprochement -->
                            <TextBlock Text="RAPPROCHEMENT AVEC LA PAIE" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total des bulletins" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalCotisations, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Attendu d'après le barème" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalCotisationsAttendu, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Écart" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding EcartGlobal, Converter={StaticResource MontantConverter}, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TotalValeur}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EcartGlobalSignificatif}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="{Binding Bareme.Designation}" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="À VÉRIFIER AVANT DÉPÔT" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
