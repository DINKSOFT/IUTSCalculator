<UserControl x:Class="IUTSCalculator.Views.PretView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:PretViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <!--
        Deux contraintes ont dicté cette disposition.

        HAUTEUR. Chaque carte est une grille à lignes explicites : « Auto » pour les
        en-têtes et les formulaires, « * » pour le tableau. Un DockPanel servait d'abord
        ses enfants ancrés et ne laissait au tableau que le reste — c'est-à-dire rien dès
        que le formulaire d'édition s'ouvrait.

        LARGEUR. GridCellStyle pose 10 px de marge de chaque côté : une colonne déclarée
        à 90 px n'affiche que 70 px de texte. Toutes les largeurs ci-dessous comptent ces
        20 px, et l'avancement de l'échéancier est passé en info-bulle de ligne pour
        rendre sa colonne au nom du salarié.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Prêts et avances" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding NombrePretsActifs, Mode=OneWay}"/>
                    <Run Text="prêt(s) en cours — la retenue du mois vient de l'échéancier, elle ne se saisit pas"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Recharger" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Nouveau prêt" Tag="{StaticResource IconAdd}" Margin="0" Width="170"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Période et créances, sur une ligne ═══════════ -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="14,8" CornerRadius="3"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Période" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox Width="140" Height="30" Margin="0,0,6,0"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding MoisDisponibles}"
                              DisplayMemberPath="Nom"
                              SelectedItem="{Binding MoisSelectionne}"/>
                    <ComboBox Width="92" Height="30" Margin="0"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Margin="16,2,16,2"
                           VerticalAlignment="Stretch" Fill="{StaticResource RuleBrush}"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource InkMutedBrush}"
                           ToolTip="Une échéance est réputée retenue lorsque la période de son mois est clôturée.">
                    <Run Text="Retenu sur la période :"/>
                    <Run Text="{Binding TotalRetenueDuMois, StringFormat=N0, Mode=OneWay}"/>
                    <Run Text="— reste dû au total :"/>
                    <Run Text="{Binding TotalRestantDu, StringFormat=N0, Mode=OneWay}"/>
                    <Run Text="  Une échéance est réputée retenue lorsque la période de son mois est clôturée."
                         Foreground="{StaticResource InkSubtleBrush}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════ Créances et échéancier ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="520"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ───────── Colonne gauche : état des créances ───────── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <Grid>
                            <TextBlock Text="PRÊTS, AVANCES ET ACOMPTES" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}"
                                       Text="{Binding PeriodeLibelle}"/>
                        </Grid>
                    </Border>

                    <!-- ═══════════ Barre de recherche et filtres prêts ═══════════ -->
                    <Border Grid.Row="1" Background="#F8FAFC"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche textuelle -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="32" Padding="28,4,26,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Rechercher par salarié, matricule, référence, nature..."/>
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource InkSubtleBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Width="20" Height="20"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Effacer la recherche"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Filtre Nature / Type -->
                            <ComboBox Grid.Column="2" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding TypesPretFiltreOptions}"
                                      SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par nature (prêt, avance, acompte)"/>

                            <!-- Filtre Statut / État -->
                            <ComboBox Grid.Column="4" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding StatutsPretFiltreOptions}"
                                      SelectedItem="{Binding SelectedStatutFilter, Mode=TwoWay}"
                                      ToolTip="Filtrer par état (actifs, soldés, suspendus, annulés)"/>

                            <!-- Réinitialiser -->
                            <Button Grid.Column="5" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                                    MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Réinitialiser les filtres"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Compteur de prêts -->
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombrePretsAffiches, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding NombrePrets, Mode=OneWay}"/>
                                <Run Text="prêt(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SituationsView}"
                              SelectedItem="{Binding SituationSelectionnee, Mode=TwoWay}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <!-- L'avancement de l'échéancier tient dans l'info-bulle : sa
                                 colonne volait la place du nom du salarié. -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                <Setter Property="ToolTip" Value="{Binding AvancementLibelle}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                Width="*" MinWidth="140"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Nature" Binding="{Binding TypeLibelle, Mode=OneWay}"
                                                Width="126"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Accordé"
                                                Binding="{Binding MontantAccorde, StringFormat=N0, Mode=OneWay}"
                                                Width="104"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Reste dû"
                                                Binding="{Binding SoldeRestantDu, StringFormat=N0, Mode=OneWay}"
                                                Width="104"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Ce mois"
                                                Binding="{Binding RetenueDuMois, StringFormat=N0, Mode=OneWay}"
                                                Width="100"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Suivante"
                                                Binding="{Binding ProchaineEcheance, Mode=OneWay}"
                                                Width="124"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="État" Binding="{Binding StatutLibelle, Mode=OneWay}"
                                                Width="100"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Formulaire, ouvert seulement quand un prêt est en cours -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10"
                            Visibility="{Binding EditionOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Salarié" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <!-- Recherche rapide du salarié pour entreprises à fort effectif -->
                                <Grid Margin="0,0,0,4">
                                    <TextBox Text="{Binding FiltreSalarie, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Height="28" Padding="24,2,22,2" Margin="0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Filtrer par nom, prénom, matricule ou emploi..."/>
                                    <TextBlock Text="{StaticResource IconSearch}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource InkSubtleBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="6,0,0,0" IsHitTestVisible="False"/>
                                    <Button Command="{Binding ClearFiltreSalarieCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,4,0" Width="16" Height="16"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Effacer la recherche"
                                            Visibility="{Binding HasFiltreSalarie, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{StaticResource InkSubtleBrush}"/>
                                    </Button>
                                </Grid>
                                <ComboBox Height="32" Margin="0,0,0,8"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding SalariesFiltres}"
                                          SelectedItem="{Binding SalarieSelectionne, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding LastName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding FirstName, Mode=OneWay}"/>
                                                <Run Text="·" Foreground="{StaticResource InkSubtleBrush}"/>
                                                <Run Text="{Binding Matricule, Mode=OneWay}" Foreground="{StaticResource InkSubtleBrush}" FontSize="11"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Nature" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox Height="32" Margin="0,0,0,8"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding TypesPret}"
                                          SelectedItem="{Binding TypeSelectionne, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Libelle}"/>
                                                <TextBlock Text="{Binding Precision, StringFormat=' — {0}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource InkSubtleBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Date d'octroi" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <DatePicker Width="128" Margin="0,0,0,8"
                                                Style="{StaticResource FormDatePickerStyle}"
                                                SelectedDate="{Binding PretEnCours.DateOctroi, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Référence" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Width="140" Margin="0,0,0,8"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             ToolTip="Numéro de la convention ou du bon d'avance. Il est repris sur la ligne du bulletin."
                                             Text="{Binding PretEnCours.Reference, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Montant accordé" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Width="118" Margin="0,0,0,8" TextAlignment="Right"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding PretEnCours.MontantAccorde, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Échéances" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Width="62" Margin="0,0,0,8" TextAlignment="Right"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             ToolTip="Nombre de mois de remboursement."
                                             Text="{Binding PretEnCours.NombreEcheances, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button Content="Calculer" MinWidth="0" Padding="10,0" Margin="0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Divise le montant par le nombre d'échéances. La dernière est ajustée au franc près pour ne retenir ni plus ni moins que la somme avancée."
                                            Command="{Binding CalculerEcheanceCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Retenue mensuelle" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <TextBox Width="128" HorizontalAlignment="Left" Margin="0,0,0,8" TextAlignment="Right"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding PretEnCours.MontantEcheance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Première retenue" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <ComboBox Width="128" Height="32" Margin="0,0,0,8"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding MoisDisponibles}"
                                              DisplayMemberPath="Nom"
                                              SelectedItem="{Binding MoisPremiereEcheanceSelectionne, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Année" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <ComboBox Width="88" Height="32" Margin="0,0,0,8"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding AnneesDisponibles}"
                                              SelectedItem="{Binding PretEnCours.AnneePremiereEcheance, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Commentaire et boutons sur la même ligne : c'est la ligne
                                 qu'on perdait sous le bord de la fenêtre. -->
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Commentaire" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Margin="0"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding PretEnCours.Commentaire, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                            MinWidth="0" Padding="10,0"
                                            Style="{StaticResource MenuButtonStyle}"
                                            ToolTip="Les échéances déjà retenues sur des mois clôturés ne sont pas touchées : seul le reliquat est replanifié."
                                            Command="{Binding EnregistrerCommand}"/>
                                    <Button Content="Annuler" MinWidth="0" Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AnnulerSaisieCommand}"/>
                                    <Button Content="Supprimer" Margin="0" MinWidth="0" Padding="10,0"
                                            Style="{StaticResource DangerButtonStyle}"
                                            ToolTip="Possible tant qu'aucune retenue n'a été opérée sur une période clôturée."
                                            Command="{Binding SupprimerCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ───────── Colonne droite : échéancier, arrêt et reprise ───────── -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <TextBlock Text="ÉCHÉANCIER" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Echeancier}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Rang, Mode=OneWay}"
                                                Width="54"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Période" Binding="{Binding PeriodeLibelle, Mode=OneWay}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Montant"
                                                Binding="{Binding MontantPrevu, StringFormat=N0, Mode=OneWay}"
                                                Width="106"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="État" Binding="{Binding EtatLibelle, Mode=OneWay}"
                                                Width="100"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Ce qui mérite un coup d'œil. Plafonné et défilant : trois
                         avertissements ne doivent pas pousser les boutons hors de l'écran. -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Background="{StaticResource WarningTintBrush}"
                            CornerRadius="3" Margin="10,8" Padding="10,7"
                            Visibility="{Binding ADesAvertissements, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="À VÉRIFIER" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Avertissements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Arrêt et reprise du remboursement -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Motif d'arrêt ou de reprise" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <TextBox Margin="0,0,0,6"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         ToolTip="Conservé sur le prêt : un remboursement interrompu sans raison écrite est un litige en attente."
                                         Text="{Binding MotifSaisi, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="Suspendre" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Neutralise les échéances des mois encore ouverts. Le solde restant dû ne bouge plus."
                                        Command="{Binding SuspendreCommand}"/>
                                <Button Content="Reprendre" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Réétale le reliquat à partir de la période affichée en haut de l'écran, avec la même échéance mensuelle."
                                        Command="{Binding ReprendreCommand}"/>
                                <Button Content="Annuler le prêt" Margin="0" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Arrête définitivement les retenues à venir en conservant celles déjà opérées."
                                        Command="{Binding AnnulerPretCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{Binding MotifLibelle}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Visibility="{Binding ADesMotifs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Barre d'état ═══════════ -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
