<Window x:Class="IUTSCalculator.Views.DossierSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Sélection du dossier"
        Height="580" Width="860"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource GrayLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="Ouvrir un dossier" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBlueDarkerBrush}"/>
            <TextBlock Text="Chaque dossier correspond à une entreprise : ses employés et calculs sont conservés séparément des autres dossiers."
                       Foreground="{StaticResource GrayDarkBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des dossiers -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Dossiers}"
                              SelectedItem="{Binding SelectedDossier}"
                              AutoGenerateColumns="False"
                              Style="{StaticResource FormDataGridStyle}"
                              MouseDoubleClick="DossiersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raison sociale" Binding="{Binding RaisonSociale}" Width="*"/>
                            <DataGridTextColumn Header="Sigle" Binding="{Binding Sigle}" Width="90"/>
                            <DataGridTextColumn Header="IFU / NIF" Binding="{Binding IFU}" Width="120"/>
                            <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Nouveau" Command="{Binding NewDossierCommand}"
                                Style="{StaticResource MenuButtonStyle}" Tag="{StaticResource IconNew}"/>
                        <Button Content="Modifier" Command="{Binding EditDossierCommand}"
                                Style="{StaticResource MenuButtonStyle}" Tag="{StaticResource IconView}" Margin="8,5,8,5"/>
                        <Button Content="Supprimer" Command="{Binding DeleteDossierCommand}"
                                Style="{StaticResource MenuButtonStyle}" Tag="{StaticResource IconDelete}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Formulaire de création/édition -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1" Padding="16"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Informations du dossier" Style="{StaticResource FormTextBlockLabelStyle}" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Raison sociale *" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.RaisonSociale, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Sigle" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.Sigle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="IFU / NIF" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.IFU, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="RCCM" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.RCCM, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Régime fiscal" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.RegimeFiscal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Adresse" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.Adresse, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Ville" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.Ville, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Téléphone" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditingDossier.Telephone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <Label Content="Logo de l'entreprise" Style="{StaticResource FormLabelStyle}"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="60" Height="60" BorderBrush="{StaticResource GrayMediumBrush}"
                                    BorderThickness="1" Background="White" Margin="0,0,10,0">
                                <Image Source="{Binding EditingDossier.LogoPath}" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Parcourir..." Command="{Binding ChoisirLogoCommand}" HorizontalAlignment="Left" Padding="10,4"/>
                                <TextBlock Text="{Binding EditingDossier.LogoPath}" FontSize="10"
                                           Foreground="{StaticResource GrayDarkBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Enregistrer" Command="{Binding SaveDossierCommand}" Style="{StaticResource MenuButtonStyle}" Tag="{StaticResource IconSave}"/>
                            <Button Content="Annuler" Command="{Binding CancelEditCommand}" Style="{StaticResource MenuButtonStyle}" Margin="8,5,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{StaticResource GrayDarkBrush}" FontSize="12"/>
            <Button Grid.Column="1" Content="Ouvrir le dossier" Command="{Binding OpenDossierCommand}"
                    Style="{StaticResource MenuButtonStyle}" Tag="{StaticResource IconCheck}" MinWidth="170"/>
        </Grid>
    </Grid>
</Window>
