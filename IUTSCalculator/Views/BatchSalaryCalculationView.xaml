<UserControl x:Class="IUTSCalculator.Views.BatchSalaryCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:BatchSalaryCalculationViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Calcul en lot" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding Employees.Count, Mode=OneWay}"/>
                    <Run Text="salariés chargés ·"/>
                    <Run Text="{Binding Calculations.Count, Mode=OneWay}"/>
                    <Run Text="calculs effectués"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Charger les employés" Tag="{StaticResource IconEmploye}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadEmployeesCommand}"/>
                <Button Content="Exporter les résultats" Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportAllCommand}"/>
                <Button Content="Tableau Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Génère un tableau complet des salaires au format Excel"
                        Command="{Binding GenerateExcelTableCommand}"/>
                <Button Content="Calculer pour tous" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding CalculateAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Période ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Période" VerticalAlignment="Center" Margin="0,0,12,0"
                           Style="{StaticResource FormTextBlockLabelStyle}"/>
                <TextBox Width="220" Margin="0"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding Periode, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Format attendu : mois et année, par exemple « Janvier 2026 »"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ Résultats ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Calculations}"
                      Style="{StaticResource FormDataGridStyle}"
                      Margin="0" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Employee.LastName}" Width="130"/>
                    <DataGridTextColumn Header="Prénom" Binding="{Binding Employee.FirstName}" Width="130"/>
                    <DataGridTextColumn Header="Emploi" Binding="{Binding Employee.Fonction}" Width="150"/>
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Employee.Category}" Width="110"/>
                    <DataGridTextColumn Header="Charges" Binding="{Binding Employee.FamilyCharges}" Width="80"
                                        ElementStyle="{StaticResource CenterTextStyle}"
                                        HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>

                    <DataGridTextColumn Header="Salaire de base" Binding="{Binding Employee.BaseSalary, StringFormat=N0}" Width="120"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Logement" Binding="{Binding Employee.HousingAllowance, StringFormat=N0}" Width="95"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Transport" Binding="{Binding Employee.TransportAllowance, StringFormat=N0}" Width="95"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Fonction" Binding="{Binding Employee.FunctionAllowance, StringFormat=N0}" Width="95"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Sujétion" Binding="{Binding Employee.SujetionAllowance, StringFormat=N0}" Width="95"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                    <DataGridTextColumn Header="Salaire brut" Binding="{Binding SalaireBrut, StringFormat=N0}" Width="115"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="CNSS salarié" Binding="{Binding CnssEmployee, StringFormat=N0}" Width="110"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="CNSS patronale" Binding="{Binding CnssPartPatronale, StringFormat=N0}" Width="120"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Base IUTS" Binding="{Binding BaseIUTSHorsDeduction, StringFormat=N0}" Width="110"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="IUTS" Binding="{Binding IUTSNet, StringFormat=N0}" Width="100"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Ret. spéciale" Binding="{Binding RetenueSpeciale, StringFormat=N0}" Width="110"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="TPA" Binding="{Binding TaxePatronale, StringFormat=N0}" Width="90"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    <DataGridTextColumn Header="Net à payer" Binding="{Binding SalaireNetaPayer, StringFormat=N0}" Width="120"
                                        ElementStyle="{StaticResource MoneyTextStyle}" HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                    <DataGridTextColumn Header="Calculé le" Binding="{Binding CalculationDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════ Pied ═══════════ -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}"
                Margin="0,14,0,0" Padding="0,10,0,0">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="Employés"/>
                    <Run Text="{Binding Employees.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <Run Text="  ·  Calculs"/>
                    <Run Text="{Binding Calculations.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
