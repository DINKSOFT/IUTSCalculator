<UserControl x:Class="IUTSCalculator.Views.ControleEquivalenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:ControleEquivalenceViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Contrôle du moteur" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Chaque bulletin recalculé avec l'ancienne formule et la nouvelle, puis comparé"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0"
                    Content="Lancer le contrôle" Tag="{StaticResource IconCheck}"
                    Style="{StaticResource MenuButtonStyle}"
                    Command="{Binding ControlerCommand}"/>
        </Grid>

        <!-- ═══════════ Explication et verdict ═══════════ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">

            <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="POURQUOI CE CONTRÔLE" Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="Deux interventions ont touché le moteur : DEC-01 a remplacé des taux écrits en dur — plafond 800 000, 5,5 % salarial, 16 % patronal, 3 % de taxe patronale — par des valeurs issues des barèmes datés et ajouté la ventilation par branche ; le branchement des variables du mois a décomposé un unique salaire brut en brut imposable, brut cotisable et brut du bulletin. Le moteur IUTS étant audité, le fait que rien ne change ne se promet pas : il se vérifie."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="La comparaison se fait sans tolérance d'arrondi : le moteur travaille en décimal exact, donc à taux identiques les deux formules doivent donner rigoureusement le même franc."/>
                </StackPanel>
            </Border>

            <!-- Verdict : conforme -->
            <Border Padding="14,12" CornerRadius="3"
                    Background="{StaticResource AccentTintBrush}"
                    BorderBrush="{StaticResource AccentTintRuleBrush}" BorderThickness="1"
                    Visibility="{Binding ToutEstIdentique, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Top"
                               Margin="0,1,12,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="{Binding ParametresLibelle}" TextWrapping="Wrap"
                                   FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Verdict : écarts -->
            <Border Padding="14,12" CornerRadius="3"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding ADesEcarts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top"
                               Margin="0,1,12,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="{Binding ParametresLibelle}" TextWrapping="Wrap"
                                   FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══════════ Détail ligne à ligne ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <TextBlock Text="DÉTAIL PAR SALARIÉ" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource InkSubtleBrush}"
                                   Visibility="{Binding ControleEffectue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="{Binding NombreIdentiques, Mode=OneWay}"/>
                            <Run Text="identique(s) ·"/>
                            <Run Text="{Binding NombreEcarts, Mode=OneWay}"/>
                            <Run Text="écart(s)"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding ControleEffectue, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                               Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Contrôle non lancé" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Lancez le contrôle pour comparer, salarié par salarié, l'ancienne formule et la nouvelle."
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="330" TextAlignment="Center"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Lignes}"
                          Style="{StaticResource FormDataGridStyle}"
                          Margin="0" BorderThickness="0" IsReadOnly="True"
                          Visibility="{Binding ControleEffectue, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Salarié" Binding="{Binding NomComplet}"
                                            Width="2*" MinWidth="160"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="Brut"
                                            Binding="{Binding SalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS sal. — avant"
                                            Binding="{Binding CnssSalarialeHeritee, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="110"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS sal. — après"
                                            Binding="{Binding CnssSalarialeCourante, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="110"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS pat. — avant"
                                            Binding="{Binding CnssPatronaleHeritee, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="110"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS pat. — après"
                                            Binding="{Binding CnssPatronaleCourante, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="110"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Somme des branches"
                                            Binding="{Binding SommeDesBranches, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Brut — avant"
                                            Binding="{Binding BrutHerite, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Brut — après"
                                            Binding="{Binding BrutCourant, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="*" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}"
                                            Width="2*" MinWidth="150"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstIdentique}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}"
                Margin="0,14,0,0" Padding="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
