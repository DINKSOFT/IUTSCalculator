<UserControl x:Class="IUTSCalculator.Views.DeclarationIutsTpaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:DeclarationIutsTpaViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="TotalValeur" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Déclaration IUTS/TPA" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Bordereau mensuel et état nominatif, construits depuis la paie déjà saisie"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterCommand}"/>
                <Button Content="Générer la déclaration" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding GenererCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mois -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Mois déclaré" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="150" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding MoisDisponibles}"
                              DisplayMemberPath="Nom"
                              SelectedItem="{Binding MoisSelectionne}"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="100" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                           Text="Déclaration mensuelle : sans seuil d'effectif, à la différence de la CNSS."/>
            </Grid>
        </Border>

        <!-- ═══════════ Résultat ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- État nominatif -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="ÉTAT NOMINATIF DE L'IUTS" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <!-- État vide -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding ADeclaration, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucune déclaration générée" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Choisissez le mois, puis générez la déclaration depuis les bulletins enregistrés."
                                   FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Lignes}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0" IsReadOnly="True"
                              Visibility="{Binding ADeclaration, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom et prénoms" Binding="{Binding NomComplet}"
                                                Width="2*" MinWidth="180"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Salaire brut"
                                                Binding="{Binding SalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Base imposable"
                                                Binding="{Binding BaseImposable, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="IUTS retenu"
                                                Binding="{Binding IUTSRetenu, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bordereau -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0"
                    Visibility="{Binding ADeclaration, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="BORDEREAU" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel DataContext="{Binding Declaration}">

                            <TextBlock Text="{Binding PeriodeLibelle}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding EcheanceLibelle}" FontSize="11" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EcheanceDepassee}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- IUTS -->
                            <TextBlock Text="IUTS" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Effectif déclaré" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding Effectif, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Salaires bruts" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalSalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Base imposable" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalBaseImposable, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="IUTS retenu — à reverser" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush2}"
                                           Text="{Binding TotalIUTSRetenu, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <!-- TPA -->
                            <TextBlock Text="TAXE PATRONALE ET D'APPRENTISSAGE" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Assiette TPA" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalAssietteTPA, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Taux appliqué" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding Bareme.TauxTaxePatronaleApprentissage, StringFormat={}{0:P2}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="TPA retenue — à verser" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush2}"
                                           Text="{Binding TotalTaxePatronale, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Écart avec le barème" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EcartTPA, Converter={StaticResource MontantConverter}, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TotalValeur}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EcartTPASignificatif}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <!-- Total à verser -->
                            <TextBlock Text="TOTAL À VERSER À LA DGI" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="IUTS" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalIUTSRetenu, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TPA" Style="{StaticResource TotalLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           Text="{Binding TotalTaxePatronale, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="TOTAL À VERSER" Style="{StaticResource TotalLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValeur}"
                                           FontSize="15" Foreground="{StaticResource AccentBrush2}"
                                           Text="{Binding TotalAVerser, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                            </Grid>

                            <TextBlock Text="{Binding Bareme.Designation}" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="À VÉRIFIER AVANT DÉPÔT" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
