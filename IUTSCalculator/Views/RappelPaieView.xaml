<UserControl x:Class="IUTSCalculator.Views.RappelPaieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:RappelPaieViewModel}"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="420"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Rappels &amp; régularisations de paie" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="Revalorisations rétroactives, régularisations sur mois clos et liquidation annuelle d'IUTS (Inviolabilité des périodes clôturées)."/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerDonneesCommand}" Margin="0,0,8,0"/>
                <Button Content="Exporter le registre" Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterRegistreExcelCommand}" Margin="0,0,8,0"
                        ToolTip="Exporter le registre des rappels en classeur Excel ClosedXML"/>
                <Button Content="Nouveau rappel" Tag="{StaticResource IconAdd}" Margin="0" Width="160"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauRappelCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Onglets Principaux ═══════════ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ═══════════════════════════════════════════════════════════════════
                 ONGLET 1 : RAPPELS & RÉGULARISATIONS SUR BULLETINS OUVERTS
                 ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="Rappels &amp; régularisations">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" MinWidth="580"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne gauche : Registre des rappels -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barre de filtre -->
                        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,6" CornerRadius="4"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Height="30" Padding="26,2,6,2"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Rechercher par nom, matricule, libellé ou motif..."/>
                                    <TextBlock Text="{StaticResource IconSearch}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource InkSubtleBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="8,0,0,0" IsHitTestVisible="False"/>
                                </Grid>

                                <ComboBox Grid.Column="2" Height="30" Style="{StaticResource FormComboBoxStyle}"
                                          SelectedIndex="{Binding FiltreStatutIndex, Mode=TwoWay}"
                                          ToolTip="Filtrer par statut">
                                    <ComboBoxItem Content="Tous statuts"/>
                                    <ComboBoxItem Content="En attente"/>
                                    <ComboBoxItem Content="Imputé"/>
                                    <ComboBoxItem Content="Annulé"/>
                                </ComboBox>

                                <ComboBox Grid.Column="4" Height="30" Style="{StaticResource FormComboBoxStyle}"
                                          SelectedIndex="{Binding FiltreTypeIndex, Mode=TwoWay}"
                                          ToolTip="Filtrer par type de régularisation">
                                    <ComboBoxItem Content="Tous types"/>
                                    <ComboBoxItem Content="Rappel salaire"/>
                                    <ComboBoxItem Content="Rappel prime"/>
                                    <ComboBoxItem Content="Heures sup omises"/>
                                    <ComboBoxItem Content="Trop-perçu"/>
                                    <ComboBoxItem Content="Régul. IUTS"/>
                                    <ComboBoxItem Content="Autre"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Tableau des rappels -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding RappelsFiltres}"
                                      SelectedItem="{Binding SelectedRappel, Mode=TwoWay}"
                                      Style="{StaticResource FormDataGridStyle}"
                                      Margin="0" BorderThickness="0"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                        Width="*" MinWidth="130"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLibelle, Mode=OneWay}"
                                                        Width="120" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Origine" Binding="{Binding PeriodeOrigineLibelle, Mode=OneWay}"
                                                        Width="90" ElementStyle="{StaticResource CenterTextStyle}"/>
                                    <DataGridTextColumn Header="Imputation" Binding="{Binding PeriodeImputationLibelle, Mode=OneWay}"
                                                        Width="90" ElementStyle="{StaticResource CenterTextStyle}"/>
                                    <DataGridTextColumn Header="Sens" Binding="{Binding SensLibelle, Mode=OneWay}"
                                                        Width="75" ElementStyle="{StaticResource CenterTextStyle}"/>
                                    <DataGridTextColumn Header="Montant Brut"
                                                        Binding="{Binding MontantBrut, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                        Width="100" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    <DataGridTextColumn Header="Net"
                                                        Binding="{Binding MontantNet, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                        Width="95" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle, Mode=OneWay}"
                                                        Width="85" ElementStyle="{StaticResource CenterTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Barre d'actions sous le tableau -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RappelsFiltres.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text=" rappel(s) listé(s)" Foreground="{StaticResource InkSubtleBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Annuler le rappel" Tag="{StaticResource IconCancel}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AnnulerRappelCommand}"
                                        Margin="0,0,8,0" ToolTip="Marquer comme annulé (ne sera pas imputé sur la paie)"/>
                                <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding SupprimerRappelCommand}"
                                        ToolTip="Supprimer définitivement ce rappel non imputé"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Colonne droite : Formulaire de saisie / modification -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="FICHE DE SAISIE DU RAPPEL" Style="{StaticResource SectionLabelStyle}"/>

                                <!-- Employé -->
                                <TextBlock Text="Employé concerné *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Employes}"
                                          SelectedItem="{Binding FormEmploye, Mode=TwoWay}"
                                          DisplayMemberPath="FullNameWithId"
                                          Style="{StaticResource FormComboBoxStyle}"/>

                                <!-- Type de rappel -->
                                <TextBlock Text="Type de régularisation *" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <ComboBox SelectedValue="{Binding FormTypeRappel, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem Content="Rappel de salaire rétroactif" Tag="{x:Static models:TypeRappelPaie.RappelSalaire}"/>
                                    <ComboBoxItem Content="Rappel de prime / indemnité" Tag="{x:Static models:TypeRappelPaie.RappelPrime}"/>
                                    <ComboBoxItem Content="Rattrapage heures supplémentaires" Tag="{x:Static models:TypeRappelPaie.OmissionHeuresSup}"/>
                                    <ComboBoxItem Content="Trop-perçu sur salaire antérieur" Tag="{x:Static models:TypeRappelPaie.TropPercuSalaire}"/>
                                    <ComboBoxItem Content="Régularisation IUTS fin d'année" Tag="{x:Static models:TypeRappelPaie.RegularisationIuts}"/>
                                    <ComboBoxItem Content="Autre régularisation" Tag="{x:Static models:TypeRappelPaie.Autre}"/>
                                </ComboBox>

                                <!-- Libellé -->
                                <TextBlock Text="Libellé sur le bulletin *" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding FormLibelle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>

                                <!-- Sens -->
                                <TextBlock Text="Sens de l'opération" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Gain versé au salarié (+)" IsChecked="{Binding FormIsGain, Mode=TwoWay}"
                                                 GroupName="SensGroup" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="Retenue déduite sur salaire (-)" IsChecked="{Binding FormIsRetenue, Mode=TwoWay}"
                                                 GroupName="SensGroup" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Période d'origine -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mois origine début" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker SelectedDate="{Binding FormMoisOrigineDebut, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mois origine fin" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker SelectedDate="{Binding FormMoisOrigineFin, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Période d'imputation cible -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Année d'imputation *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FormAnneeImputation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mois d'imputation (1-12) *" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FormMoisImputation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Montant brut -->
                                <TextBlock Text="Montant Brut (FCFA) *" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding FormMontantBrut, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource FormTextBoxStyle}" FontWeight="SemiBold" FontSize="14"/>

                                <!-- Assujettissements -->
                                <TextBlock Text="Régime fiscal &amp; social" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <CheckBox Content="Soumis IUTS" IsChecked="{Binding FormSoumisIUTS, Mode=TwoWay}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Soumis CNSS" IsChecked="{Binding FormSoumisCNSS, Mode=TwoWay}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Soumis TPA" IsChecked="{Binding FormSoumisTPA, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Motif -->
                                <TextBlock Text="Motif / Référence justificative" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FormMotif, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>

                                <!-- Boutons d'enregistrement -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Nouveau" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding NouveauRappelCommand}"/>
                                    <Button Grid.Column="2" Content="Enregistrer le rappel" Style="{StaticResource MenuButtonStyle}"
                                            Command="{Binding EnregistrerRappelCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════
                 ONGLET 2 : ASSISTANT DE SIMULATION RÉTROACTIVE (MULTI-MOIS)
                 ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="Calcul différentiel rétroactif">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panneau de configuration de la revalorisation -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="PARAMÈTRES DE LA REVALORISATION RÉTROACTIVE SUR PÉRIODES CLOSES"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Employé concerné" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Employes}"
                                              SelectedItem="{Binding SimuEmploye, Mode=TwoWay}"
                                              DisplayMemberPath="FullNameWithId"
                                              Style="{StaticResource FormComboBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Période début" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding SimuMoisDebut, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Période fin" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding SimuMoisFin, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="+ Augmentation salaire (FCFA)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SimuAugmentationSalaireBase, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                             Style="{StaticResource FormTextBoxStyle}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button Grid.Column="8" Content="Lancer la simulation"
                                        Tag="{StaticResource IconCalculator}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        VerticalAlignment="Bottom" Height="34" Width="170"
                                        Command="{Binding CalculerSimulationCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Grille de décomposition mois par mois -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding DetailsSimulation}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  Margin="0" BorderThickness="0"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mois" Binding="{Binding PeriodeLibelle, Mode=OneWay}"
                                                    Width="110" ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Ancien Base"
                                                    Binding="{Binding AncienSalaireDeBase, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="100" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Nouveau Base"
                                                    Binding="{Binding NouveauSalaireDeBase, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="105" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Δ Base"
                                                    Binding="{Binding DeltaSalaireDeBase, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="90" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Δ Brut Total"
                                                    Binding="{Binding DeltaBrut, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="100" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Δ Assiette CNSS"
                                                    Binding="{Binding DeltaAssietteCnss, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="110" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="CNSS Sal. (5,5%)"
                                                    Binding="{Binding DeltaCnssSalarial, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="115" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="CNSS Pat. (16%)"
                                                    Binding="{Binding DeltaCnssPatronal, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="115" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="TPA (3%)"
                                                    Binding="{Binding DeltaTpa, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="90" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Net Différentiel"
                                                    Binding="{Binding DeltaNet, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="110" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Observation" Binding="{Binding Observation, Mode=OneWay}"
                                                    Width="*" MinWidth="130" ElementStyle="{StaticResource CellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Cartouche synthétique de validation -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,10,0,0"
                            Background="{StaticResource SurfaceAltBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="TOTAL BRUT RAPPEL" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SimuTotalBrut, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="CNSS SALARIALE (5,5%)" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SimuTotalCnssSalarial, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="CNSS PATRONALE (16%)" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SimuTotalCnssPatronal, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="NET DIFFÉRENTIEL" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SimuTotalNet, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Exporter la simulation Excel" Tag="{StaticResource IconExport}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExporterSimulationExcelCommand}" Margin="0,0,8,0"/>
                                <Button Content="Créer le rappel pour le mois courant" Tag="{StaticResource IconCheck}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding ValiderEtCreerRappelSimulationCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════════
                 ONGLET 3 : RÉGULARISATION ANNUELLE D'IUTS (FIN D'ANNÉE / DGI)
                 ═══════════════════════════════════════════════════════════════════ -->
            <TabItem Header="Régularisation annuelle d'IUTS">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barre de lancement du calcul annuel -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Exercice fiscal :" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding RegulAnnee, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}" Height="32" VerticalContentAlignment="Center" FontWeight="SemiBold"/>

                            <Button Grid.Column="3" Content="Calculer pour tout le personnel"
                                    Tag="{StaticResource IconCalculator}"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Height="32" Width="230"
                                    Command="{Binding CalculerRegularisationAnnuelleCommand}"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <Button Content="Exporter l'état fiscal" Tag="{StaticResource IconExport}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExporterRegulIutsExcelCommand}" Margin="0,0,8,0"/>
                                <Button Content="Générer les régularisations (décembre)" Tag="{StaticResource IconRefresh}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding GenererRappelsRegulCommand}"
                                        ToolTip="Convertir automatiquement les écarts en lignes de régularisation pour le bulletin de fin d'année"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tableau comparatif annuel -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding RegularisationsIuts}"
                                  SelectedItem="{Binding SelectedRegularisation, Mode=TwoWay}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  Margin="0" BorderThickness="0"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeId, Mode=OneWay}"
                                                    Width="85" ElementStyle="{StaticResource CenterTextStyle}"/>
                                <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                    Width="*" MinWidth="150" ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Mois" Binding="{Binding NombreMoisTravailles, Mode=OneWay}"
                                                    Width="60" ElementStyle="{StaticResource CenterTextStyle}"/>
                                <DataGridTextColumn Header="Cumul Brut Imposable"
                                                    Binding="{Binding CumulBrutImposable, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="150" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="IUTS Théorique"
                                                    Binding="{Binding IutsTheoriqueAnnuel, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="130" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Acomptes Prélevés"
                                                    Binding="{Binding CumulIutsPreleve, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="130" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Écart (+/-)"
                                                    Binding="{Binding DifferenceRegularisation, StringFormat={}{0:+#,##0;-#,##0;0}, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="120" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Action fiscale" Binding="{Binding ActionRecommandee, Mode=OneWay}"
                                                    Width="190" ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle, Mode=OneWay}"
                                                    Width="85" ElementStyle="{StaticResource CenterTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Cartouche synthétique des totaux annuels -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,10,0,0"
                            Background="{StaticResource SurfaceAltBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MASSE IMPOSABLE EXERCICE" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                <TextBlock Text="{Binding TotalCumulBrutExercice, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IUTS THÉORIQUE ANNUEL" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                <TextBlock Text="{Binding TotalIutsTheoriqueExercice, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL ACOMPTES RETENUS" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                <TextBlock Text="{Binding TotalIutsPreleveExercice, StringFormat={}{0:N0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="ÉCART NET DE RÉGULARISATION" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                <TextBlock Text="{Binding TotalDifferenceExercice, StringFormat={}{0:+#,##0;-#,##0;0} FCFA, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Barre de statut inférieure ═══════════ -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                           VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
