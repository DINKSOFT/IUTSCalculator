<Window x:Class="IUTSCalculator.Views.DemarrageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sigma Paie &amp; RH"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource RuleStrongBrush}" BorderThickness="1"
        FontFamily="Segoe UI">
    <!-- Fenêtre de démarrage : sans elle, le chiffrement des bases au lancement laissait
         l'écran vide plusieurs secondes, comme si l'application ne s'ouvrait pas. -->
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Sigma Paie &amp; RH" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"/>
        <TextBlock x:Name="Etape" Text="Démarrage…" FontSize="13" Margin="0,14,0,8"
                   Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Barre" Height="6" Minimum="0" Maximum="1"
                     IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}"
                     Background="{StaticResource RuleBrush}"
                     BorderThickness="0"/>
        <TextBlock x:Name="Detail" FontSize="11" Margin="0,8,0,0"
                   Foreground="{StaticResource InkSubtleBrush}"
                   TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</Window>
