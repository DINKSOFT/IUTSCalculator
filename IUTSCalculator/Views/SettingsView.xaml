<UserControl x:Class="IUTSCalculator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:IUTSCalculator.Views"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:converters="clr-namespace:IUTSCalculator.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Ces deux grilles sont MODIFIABLES : elles ne peuvent pas recevoir
             FormDataGridStyle, qui impose IsReadOnly et remplace le gabarit des
             cellules par un simple affichage. On habille donc chaque propriété
             séparément, en laissant l'édition intacte. -->
        <Style x:Key="EditableGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RuleFaintBrush}"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeaderStyle}"/>
        </Style>

        <Style x:Key="TabNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Paramètres" Style="{StaticResource ScreenTitleStyle}"/>
            <TextBlock Text="Barème, abattements et préférences de l'application"
                       FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
        </StackPanel>

        <!-- ═══════════ Onglets ═══════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">

            <!-- ───── Tranches d'imposition ─────
                 Édite le même barème daté que l'écran « Barèmes légaux » (celui
                 actuellement en vigueur) — voir ETAT-DEVELOPPEMENT.md item 23. Grille
                 et boutons mêmes que sur cet autre écran : ajouter/supprimer une
                 tranche ne peut pas passer par CanUserAddRows/CanUserDeleteRows d'un
                 DataGrid brut, qui ne recollerait pas les bornes voisines. -->
            <TabItem Header="Tranches d'imposition">
                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel DataContext="{Binding FicheBareme}">
                        <TextBlock DockPanel.Dock="Top" Text="BARÈME DE L'IUTS EN VIGUEUR"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TabNote}" Margin="0,4,0,10"
                                   Text="{Binding DataContext.BaremeInfoLibelle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Ajouter une tranche"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.AjouterTrancheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="Supprimer" Margin="0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DataContext.SupprimerTrancheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TabNote}"
                                   Text="Les bornes doivent se toucher : la borne inférieure d'une tranche est exactement la borne supérieure de la précédente. Laisser la borne supérieure vide signifie « et au-delà »."/>

                        <DataGrid ItemsSource="{Binding Tranches}"
                                  SelectedItem="{Binding DataContext.TrancheSelectionnee, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Ordre}"
                                                    IsReadOnly="True" Width="44"
                                                    ElementStyle="{StaticResource CenterTextStyle}"
                                                    HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                                <DataGridTextColumn Header="De (FCFA)"
                                                    Binding="{Binding BorneInferieure, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                    IsReadOnly="True" Width="*" MinWidth="110"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                                <DataGridTextColumn Header="À (FCFA)"
                                                    Binding="{Binding BorneSuperieureSaisie, UpdateSourceTrigger=LostFocus}"
                                                    Width="*" MinWidth="110"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                                <DataGridTextColumn Header="Taux (%)"
                                                    Binding="{Binding Taux, StringFormat=N2, ConverterCulture=fr-FR, UpdateSourceTrigger=LostFocus}"
                                                    Width="100" MinWidth="90"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ───── Charges familiales ───── -->
            <TabItem Header="Charges familiales">
                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel DataContext="{Binding FicheBareme}">
                        <TextBlock DockPanel.Dock="Top" Text="RÉDUCTIONS POUR CHARGES DE FAMILLE (ART. 113 DU CGI)"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TabNote}" Margin="0,4,0,10"
                                   Text="{Binding DataContext.BaremeInfoLibelle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TabNote}"
                                   Text="La réduction s'applique sur l'impôt brut, pas sur le revenu imposable. Nombre de personnes à charge fixé de 0 à 7 ; seul le taux se modifie."/>

                        <DataGrid ItemsSource="{Binding ChargesFamille}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Personnes à charge" Binding="{Binding NombreCharges}"
                                                    IsReadOnly="True" Width="*" MinWidth="140"
                                                    ElementStyle="{StaticResource CenterTextStyle}"
                                                    HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                                <DataGridTextColumn Header="Réduction de l'IUTS"
                                                    Binding="{Binding Taux, Converter={StaticResource PourcentageConverter}, UpdateSourceTrigger=LostFocus}"
                                                    Width="*" MinWidth="140"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ───── Préférences ───── -->
            <TabItem Header="Préférences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="APPARENCE" Style="{StaticResource SectionLabelStyle}"/>
                                <CheckBox Content="Utiliser le thème sombre"
                                          Style="{StaticResource FormCheckBoxStyle}" Margin="0"
                                          IsChecked="{Binding IsDarkTheme}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="LANGUE" Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox Width="220" HorizontalAlignment="Left" Margin="0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          SelectedValue="{Binding Language}">
                                    <ComboBoxItem Content="Français" Tag="fr-FR"
                                                  IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=fr-FR}"/>
                                    <ComboBoxItem Content="English" Tag="en-US"
                                                  IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=en-US}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="SAUVEGARDE ET EXPORTS" Style="{StaticResource SectionLabelStyle}"/>

                                <CheckBox Content="Activer la sauvegarde automatique"
                                          Style="{StaticResource FormCheckBoxStyle}" Margin="0,0,0,14"
                                          IsChecked="{Binding IsAutoSaveEnabled}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Répertoire d'exportation"
                                               Style="{StaticResource FormTextBlockLabelStyle}"
                                               Margin="0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Margin="0"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding ExportDirectory}"/>
                                    <!-- Le bouton était lié à BrowseExportDirectoryCommand, qui
                                         n'existe pas sur le ViewModel : il ne faisait donc rien.
                                         Le gestionnaire du code-behind, lui, est complet et prévu
                                         pour ce cas — c'est lui qu'on branche. -->
                                    <Button Grid.Column="2" Content="Parcourir..." Margin="8,0,0,0"
                                            MinWidth="0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseExportDirectory_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───── Maintenance ─────
                 Panneau TEMPORAIRE, unique point d'entrée vers RattrapageCnssService
                 (dette connue n°3 — voir ETAT-DEVELOPPEMENT.md §7). « Analyser » ne fait
                 que lire ; « Appliquer » ne s'active qu'après une analyse ayant trouvé des
                 lignes, et redemande confirmation avant d'écrire. -->
            <TabItem Header="Maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="RATTRAPAGE CNSS (VENTILATION PAR BRANCHE)"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Style="{StaticResource TabNote}" Margin="0,4,0,14"
                                       Text="Reconstitue la ventilation par branche (prestations familiales, risques professionnels, pensions patronales) des bulletins enregistrés avant l'ajout de ce détail, sans toucher au salaire brut ni à aucun autre champ. « Analyser » se contente de lire et de proposer un rapport ; « Appliquer » écrit en base après dépôt d'une copie de sauvegarde du fichier, et ne concerne que les lignes que l'analyse a identifiées avec certitude — les lignes ambiguës sont signalées à part, pour un examen manuel."/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Analyser" MinWidth="140"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AnalyserRattrapageCnssCommand}"/>
                                <Button Content="Appliquer..." MinWidth="140"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding AppliquerRattrapageCnssCommand}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasRapportRattrapageCnss, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Foreground="{StaticResource InkBrush}">
                                    <Run Text="{Binding NombreLignesARattraperCnss, Mode=OneWay}"/>
                                    <Run Text="ligne(s) à rattraper — "/>
                                    <Run Text="{Binding NombreLignesSuspectesCnss, Mode=OneWay}"/>
                                    <Run Text="ligne(s) suspecte(s)"/>
                                </TextBlock>
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        Padding="10" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding RapportRattrapageCnssTexte}"
                                                   TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Actions ═══════════ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Réinitialiser" Tag="{StaticResource IconReset}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="Importer..." Tag="{StaticResource IconImport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ImportSettingsCommand}"/>
                <Button Content="Exporter..." Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportSettingsCommand}"/>
                <Button Content="Enregistrer" Tag="{StaticResource IconSave}" Margin="0"
                        IsDefault="True"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Voile d'attente -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#99FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Padding="28,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Traitement en cours..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Width="200" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
