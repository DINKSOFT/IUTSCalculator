<UserControl x:Class="IUTSCalculator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:IUTSCalculator.Views"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:converters="clr-namespace:IUTSCalculator.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Ces deux grilles sont MODIFIABLES : elles ne peuvent pas recevoir
             FormDataGridStyle, qui impose IsReadOnly et remplace le gabarit des
             cellules par un simple affichage. On habille donc chaque propriété
             séparément, en laissant l'édition intacte. -->
        <Style x:Key="EditableGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RuleFaintBrush}"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeaderStyle}"/>
        </Style>

        <Style x:Key="TabNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Paramètres" Style="{StaticResource ScreenTitleStyle}"/>
            <TextBlock Text="Barème, abattements et préférences de l'application"
                       FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
        </StackPanel>

        <!-- ═══════════ Onglets ═══════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">

            <!-- ───── Tranches d'imposition ───── -->
            <TabItem Header="Tranches d'imposition">
                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="BARÈME DE L'IUTS"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TabNote}"
                                   Text="Les limites sont exprimées en FCFA et les taux en proportion : 0,125 s'affiche 12,5 %. Les tranches doivent être contiguës — une limite supérieure est immédiatement suivie de la limite inférieure de la tranche suivante."/>

                        <DataGrid ItemsSource="{Binding TaxBrackets}"
                                  Style="{StaticResource EditableGridStyle}"
                                  CanUserAddRows="True" CanUserDeleteRows="True"
                                  Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Limite inférieure"
                                                    Binding="{Binding LowerBound, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="Limite supérieure"
                                                    Binding="{Binding UpperBound, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="Taux"
                                                    Binding="{Binding Rate, StringFormat=P1}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ───── Charges familiales ───── -->
            <TabItem Header="Charges familiales">
                <Border Style="{StaticResource CardBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ABATTEMENTS POUR CHARGES FAMILIALES"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TabNote}"
                                   Text="L'abattement s'applique sur l'impôt brut, pas sur le revenu imposable. Les taux sont exprimés en proportion : 0,10 s'affiche 10 %."/>

                        <DataGrid ItemsSource="{Binding FamilyCharges}"
                                  Style="{StaticResource EditableGridStyle}"
                                  CanUserAddRows="True" CanUserDeleteRows="True"
                                  Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Personnes à charge"
                                                    Binding="{Binding ChargeCount}" Width="*"/>
                                <DataGridTextColumn Header="Taux d'abattement"
                                                    Binding="{Binding AbatementPercentage, StringFormat=P1}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ───── Préférences ───── -->
            <TabItem Header="Préférences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="APPARENCE" Style="{StaticResource SectionLabelStyle}"/>
                                <CheckBox Content="Utiliser le thème sombre"
                                          Style="{StaticResource FormCheckBoxStyle}" Margin="0"
                                          IsChecked="{Binding IsDarkTheme}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="LANGUE" Style="{StaticResource SectionLabelStyle}"/>
                                <ComboBox Width="220" HorizontalAlignment="Left" Margin="0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          SelectedValue="{Binding Language}">
                                    <ComboBoxItem Content="Français" Tag="fr-FR"
                                                  IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=fr-FR}"/>
                                    <ComboBoxItem Content="English" Tag="en-US"
                                                  IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=en-US}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="SAUVEGARDE ET EXPORTS" Style="{StaticResource SectionLabelStyle}"/>

                                <CheckBox Content="Activer la sauvegarde automatique"
                                          Style="{StaticResource FormCheckBoxStyle}" Margin="0,0,0,14"
                                          IsChecked="{Binding IsAutoSaveEnabled}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Répertoire d'exportation"
                                               Style="{StaticResource FormTextBlockLabelStyle}"
                                               Margin="0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Margin="0"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding ExportDirectory}"/>
                                    <!-- Le bouton était lié à BrowseExportDirectoryCommand, qui
                                         n'existe pas sur le ViewModel : il ne faisait donc rien.
                                         Le gestionnaire du code-behind, lui, est complet et prévu
                                         pour ce cas — c'est lui qu'on branche. -->
                                    <Button Grid.Column="2" Content="Parcourir..." Margin="8,0,0,0"
                                            MinWidth="0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseExportDirectory_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Actions ═══════════ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Réinitialiser" Tag="{StaticResource IconReset}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="Importer..." Tag="{StaticResource IconImport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ImportSettingsCommand}"/>
                <Button Content="Exporter..." Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExportSettingsCommand}"/>
                <Button Content="Enregistrer" Tag="{StaticResource IconSave}" Margin="0"
                        IsDefault="True"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Voile d'attente -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#99FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Padding="28,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Traitement en cours..." FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Width="200" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
