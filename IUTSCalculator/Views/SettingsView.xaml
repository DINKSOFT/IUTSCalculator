<Window x:Class="IUTSCalculator.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IUTSCalculator.Views"
        xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
        xmlns:converters="clr-namespace:IUTSCalculator.Converters"
        mc:Ignorable="d"
        Title="Paramètres" Height="650" Width="800"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToTypeConverter x:Key="BoolToTypeConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Contenu principal -->
        <TabControl Grid.Row="0">
            <!-- Tranches d'imposition -->
            <TabItem Header="Tranches d'imposition">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Configuration des tranches d'imposition" 
                               Style="{StaticResource HeaderTextStyle}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding TaxBrackets}" 
                              AutoGenerateColumns="False" Margin="0,10"
                              CanUserAddRows="True" CanUserDeleteRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Limite inférieure" 
                                                Binding="{Binding LowerBound, StringFormat=N0}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Limite supérieure" 
                                                Binding="{Binding UpperBound, StringFormat=N0}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Taux (%)" 
                                                Binding="{Binding Rate, StringFormat=P1}" 
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" 
                               Text="Note: Les limites sont exprimées en unités monétaires et les taux en pourcentage (0.05 = 5%)"
                               FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- Charges familiales -->
            <TabItem Header="Charges familiales">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Configuration des abattements pour charges familiales" 
                               Style="{StaticResource HeaderTextStyle}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FamilyCharges}" 
                              AutoGenerateColumns="False" Margin="0,10"
                              CanUserAddRows="True" CanUserDeleteRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre de personnes à charge" 
                                                Binding="{Binding ChargeCount}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Taux d'abattement (%)" 
                                                Binding="{Binding AbatementPercentage, StringFormat=P1}" 
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" 
                               Text="Note: Les taux d'abattement sont exprimés en pourcentage (0.05 = 5%)"
                               FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- Préférences -->
            <TabItem Header="Préférences">
                <StackPanel Margin="10">
                    <TextBlock Text="Préférences générales" 
                               Style="{StaticResource HeaderTextStyle}"/>

                    <!-- Thème -->
                    <GroupBox Header="Apparence" Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <CheckBox Content="Utiliser le thème sombre" 
                                      IsChecked="{Binding IsDarkTheme}"
                                      Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Langue -->
                    <GroupBox Header="Langue" Style="{StaticResource SectionStyle}">
                        <ComboBox SelectedValue="{Binding Language}" Margin="0,5" Width="200"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Français" Tag="fr-FR" IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=fr-FR}"/>
                            <ComboBoxItem Content="English" Tag="en-US" IsSelected="{Binding Language, Converter={StaticResource StringEqualsConverter}, ConverterParameter=en-US}"/>
                        </ComboBox>
                    </GroupBox>

                    <!-- Sauvegarde -->
                    <GroupBox Header="Sauvegarde" Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <CheckBox Content="Activer la sauvegarde automatique" 
                                      IsChecked="{Binding IsAutoSaveEnabled}"
                                      Margin="0,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Répertoire d'exportation:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding ExportDirectory}" Width="250" Margin="0,0,10,0"/>
                                <Button Content="..." Width="30" Click="BrowseExportDirectory_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Barre de statut -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" 
                   Margin="0,10" FontStyle="Italic"/>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Réinitialiser" Width="120" Margin="5"
                    Command="{Binding ResetToDefaultsCommand}"/>
            <Button Content="Importer..." Width="120" Margin="5"
                    Command="{Binding ImportSettingsCommand}"/>
            <Button Content="Exporter..." Width="120" Margin="5"
                    Command="{Binding ExportSettingsCommand}"/>
            <Button Content="Enregistrer" Width="120" Margin="5"
                    Command="{Binding SaveSettingsCommand}"
                    IsDefault="True"/>
        </StackPanel>

        <!-- Indicateur de chargement -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToTypeConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Traitement en cours..." Foreground="White" 
                           FontSize="16" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Height="10" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>