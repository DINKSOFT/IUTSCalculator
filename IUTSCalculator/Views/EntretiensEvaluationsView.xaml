<UserControl x:Class="IUTSCalculator.Views.EntretiensEvaluationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:EntretiensEvaluationsViewModel}"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="TabHeaderBtnStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GroundBrush}">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Onglets de navigation -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             EN-TÊTE DE L'ÉCRAN
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <!-- Boutons d'actions globaux -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding RechargerToutCommand}"/>

                    <Button Content="Exporter Synthèse Excel (4 feuilles)" Tag="{StaticResource IconExcel}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0"
                            Command="{Binding ExporterExcelCampagneCommand}"/>
                </StackPanel>

                <!-- Titre & Sous-titre -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ENTRETIENS &amp; ÉVALUATIONS DES PERFORMANCES" Style="{StaticResource ScreenTitleStyle}"/>
                    <TextBlock Text="Campagnes annuelles, grilles de compétences, objectifs N-1 / N+1, notation et suivi individuel"
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             ONGLETS DE NAVIGATION DU MODULE
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="0,0,0,1" Padding="20,8,20,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Campagnes &amp; Tableau de bord"
                             Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=0, Mode=TwoWay}"/>

                <RadioButton Content="Conduite de l'Entretien Individuel"
                             Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1, Mode=TwoWay}"/>

                <RadioButton Content="Historique par Collaborateur"
                             Style="{StaticResource TabHeaderBtnStyle}"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource StringEqualsConverter}, ConverterParameter=2, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             CONTENU DES ONGLETS
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="20,14,20,16">

            <!-- ───────── ONGLET 0 : CAMPAGNES & TABLEAU DE BORD ───────── -->
            <Grid Visibility="{Binding EstOngletCampagne, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Sélecteur & Actions de Campagne -->
                            <RowDefinition Height="Auto"/>
                            <!-- Cartes d'indicateurs KPIs -->
                            <RowDefinition Height="Auto"/>
                            <!-- Alerte évaluateurs à assigner -->
                            <RowDefinition Height="Auto"/>
                            <!-- Filtres & recherche -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tableau des entretiens -->
                            <RowDefinition Height="*" MinHeight="360"/>
                        </Grid.RowDefinitions>

                        <!-- Ligne 0 : Sélecteur de Campagne & Actions -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="Nouvelle Campagne" Tag="{StaticResource IconAdd}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding NouvelleCampagneCommand}"/>

                                    <Button Content="Modifier" Tag="{StaticResource IconEdit}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding EditerCampagneCommand}"/>

                                    <Button Content="Clôturer" Tag="{StaticResource IconLock}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding CloturerCampagneCommand}"/>

                                    <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,12,0"
                                            Command="{Binding SupprimerCampagneCommand}"/>

                                    <Button Content="Initialiser l'effectif actif" Tag="{StaticResource IconEmploye}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="Génère les entretiens pour tous les salariés actifs avec affectation N+1 et critères types"
                                            Command="{Binding InitialiserCampagneCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Campagne active :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkBrush}"/>
                                    <ComboBox ItemsSource="{Binding Campagnes}" SelectedItem="{Binding CampagneSelectionnee, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" Width="360" Height="30" Margin="0,0,14,0" VerticalContentAlignment="Center"/>

                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CampagneSelectionnee.PeriodeLibelle, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                    </Border>

                                    <Border Background="{Binding CampagneSelectionnee.CouleurStatut, Mode=OneWay}" CornerRadius="3" Padding="8,4">
                                        <TextBlock Text="{Binding CampagneSelectionnee.BadgeStatut, Mode=OneWay}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Ligne 1 : Cartes d'indicateurs KPIs -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="SALARIÉS CIBLÉS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding StatsCampagne.TotalSalariesCibles, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Effectif actif éligible" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="PLANIFIÉS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding StatsCampagne.EntretiensPlanifies, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0288D1" Margin="0,4,0,0"/>
                                    <TextBlock Text="Non encore évalués" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="EN COURS / RÉALISÉS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding StatsCampagne.EntretiensRealises, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                                    <TextBlock Text="Évaluation notée" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="VALIDÉS &amp; SCELLÉS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding StatsCampagne.EntretiensValides, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,0"/>
                                    <TextBlock Text="Signés &amp; verrouillés" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TAUX D'AVANCEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding StatsCampagne.TauxAvancementPct, StringFormat={}{0:N1} %, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Entretiens conduits" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="5" Style="{StaticResource StatCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="NOTE MOYENNE GLOBALE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding StatsCampagne.NoteMoyenneGlobale, StringFormat={}{0:N2} / 5, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,4,0,0"/>
                                    <TextBlock Text="Baromètre entreprise" FontSize="10" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Ligne 2 : Alerte si des salariés sont sans N+1 -->
                        <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding StatsCampagne.EvaluateursAAssignerCount, Converter={StaticResource StringEqualsConverter}, ConverterParameter=0, Mode=OneWay, ConverterCulture=fr-FR}">
                            <!-- Masqué si 0 grâce au style -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatsCampagne.EvaluateursAAssignerCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Ligne 3 : Barre de filtres & recherche -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recherche textuelle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="28" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{Binding EntretiensFiltres.Count, StringFormat={}{0} entretien(s) affiché(s), Mode=OneWay}"
                                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <!-- Filtre Statut -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="Statut :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource InkMutedBrush}"/>
                                    <!-- SelectedValue + SelectedValuePath="Content" : FiltreStatut reçoit le texte de
                                         l'élément (« Réalisé »...) et non l'objet ComboBoxItem, qui ne correspondait à
                                         aucun statut et vidait la grille. -->
                                    <ComboBox SelectedValue="{Binding FiltreStatut, Mode=TwoWay}" SelectedValuePath="Content" Width="140" Height="28" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Tous"/>
                                        <ComboBoxItem Content="Planifié"/>
                                        <ComboBoxItem Content="En cours"/>
                                        <ComboBoxItem Content="Réalisé"/>
                                        <ComboBoxItem Content="Validé &amp; Signé"/>
                                        <ComboBoxItem Content="Clôturé"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Filtre Service -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Service :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource InkMutedBrush}"/>
                                    <ComboBox ItemsSource="{Binding ServicesFiltre}" SelectedItem="{Binding FiltreService, Mode=TwoWay}" Width="180" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ligne 4 : Tableau des entretiens -->
                        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="1">
                            <DataGrid ItemsSource="{Binding EntretiensFiltres}" SelectedItem="{Binding EntretienSelectionne, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                      RowHeaderWidth="0" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding EmployeeId, Mode=OneWay}" Width="85" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Nom &amp; Prénom(s)" Binding="{Binding EmployeeNomComplet, Mode=OneWay}" Width="160" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Direction / Service" Binding="{Binding EmployeeService, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="Poste Occupé" Binding="{Binding EmployeePoste, Mode=OneWay}" Width="150"/>
                                    <DataGridTemplateColumn Header="Supérieur N+1" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚠️ " Foreground="#C62828" ToolTip="Évaluateur à assigner manuellement"
                                                               Visibility="{Binding EvaluateurAAssigner, Converter={StaticResource BoolToVis}, Mode=OneWay}"/>
                                                    <TextBlock Text="{Binding EvaluateurNomComplet, Mode=OneWay}"
                                                               Foreground="{Binding EvaluateurAAssigner, Converter={StaticResource StringEqualsConverter}, ConverterParameter=True, Mode=OneWay}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Date Entretien" Binding="{Binding DateEntretienTexte, Mode=OneWay}" Width="100"/>
                                    <DataGridTemplateColumn Header="Statut" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CouleurStatut, Mode=OneWay}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatutLibelle, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Note Globale" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NoteGlobaleFormatee, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding CouleurMention, Mode=OneWay}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding NoteEtoiles, Mode=OneWay}" Foreground="#F57F17" FontSize="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mention Globale" Binding="{Binding MentionGlobale, Mode=OneWay}" Width="140"/>
                                    <DataGridTemplateColumn Header="Actions" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                    <Button Content="Ouvrir l'entretien" Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,2" FontSize="11" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OuvrirEntretienCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                    <Button Content="PDF" Style="{StaticResource MenuButtonStyle}"
                                                            Padding="6,2" FontSize="11"
                                                            Command="{Binding DataContext.ExporterPdfEntretienCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Dialogue rétractable : Édition Campagne -->
                        <Border Grid.Row="0" Grid.RowSpan="5" Background="#80000000" Visibility="{Binding EstEnEditionCampagne, Converter={StaticResource BoolToVis}}" Margin="-20,-14">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6"
                                    Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="CONFIGURATION DE LA CAMPAGNE D'ÉVALUATION" Style="{StaticResource ScreenTitleStyle}" FontSize="15" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Code de la campagne :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CampagneEnEdition.Code, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Année d'exercice :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CampagneEnEdition.AnneeExercice, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Titre officiel de la campagne :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CampagneEnEdition.Titre, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Date de début :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding CampagneEnEdition.DateDebut, Mode=TwoWay}" Height="28"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Date d'échéance (Fin) :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding CampagneEnEdition.DateFin, Mode=TwoWay}" Height="28"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Description &amp; Orientations stratégiques :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CampagneEnEdition.Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Annuler" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding AnnulerEditionCampagneCommand}"/>
                                        <Button Content="Enregistrer la Campagne" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding EnregistrerCampagneCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ───────── ONGLET 1 : CONDUITE DE L'ENTRETIEN INDIVIDUEL ───────── -->
            <Grid Visibility="{Binding EstOngletEntretien, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,20">

                        <!-- Barre d'outils Entretien -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="Retour à la liste" Tag="{StaticResource IconBack}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding RetourAuxCampagnesCommand}"/>

                                    <Button Content="Enregistrer" Tag="{StaticResource IconCheck}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                            IsEnabled="{Binding EstModifiable}"
                                            Command="{Binding EnregistrerEntretienCommand}"/>

                                    <Button Content="Marquer Réalisé"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            IsEnabled="{Binding EstModifiable}"
                                            Command="{Binding MarquerRealiseCommand}"/>

                                    <Button Content="Valider &amp; Sceller" Tag="{StaticResource IconLock}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            ToolTip="Verrouille définitivement l'entretien avec valeur probante"
                                            Command="{Binding ValiderEntretienCommand}"/>

                                    <Button Content="Imprimer PDF Officiel" Tag="{StaticResource IconExport}"
                                            Style="{StaticResource MenuButtonStyle}"
                                            Command="{Binding ImprimerPdfEntretienEnCoursCommand}"/>
                                </StackPanel>

                                <!-- En-tête Salarié -->
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EntretienEnCours.EmployeeNomComplet, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock Text="{Binding EntretienEnCours.EmployeeId, StringFormat={}  ({0}), Mode=OneWay}" FontSize="13" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{Binding EntretienEnCours.CouleurStatut, Mode=OneWay}" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EntretienEnCours.BadgeStatut, Mode=OneWay}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding EntretienEnCours.EmployeePoste, StringFormat={}Poste : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Bandeau de verrouillage si validé -->
                        <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding EstVerrouille, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 " FontSize="14"/>
                                    <TextBlock Text="Cet entretien d'évaluation est validé et scellé. En vertu de la règle d'opposabilité légale, ses données sont strictement verrouillées et protégées contre toute modification ultérieure."
                                               FontWeight="SemiBold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Date (et auteur) de validation scellés par le service -->
                                <TextBlock Text="{Binding EntretienEnCours.ValidationLibelle, Mode=OneWay}"
                                           FontSize="11" Foreground="#1B5E20" Margin="22,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- En-tête administratif & Date -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Supérieur Hiérarchique N+1 (Évaluateur) :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EntretienEnCours.EvaluateurMatricule, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding EstModifiable}" Height="28" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{Binding EntretienEnCours.EvaluateurNomComplet, StringFormat={}Nom : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Date de l'Entretien :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EntretienEnCours.DateEntretien, Mode=TwoWay}"
                                                IsEnabled="{Binding EstModifiable}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Direction / Service :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding EntretienEnCours.EmployeeService, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding EntretienEnCours.EmployeeAnciennete, StringFormat={}Ancienneté : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>

                                <!-- Note Globale Badge -->
                                <Border Grid.Column="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4" Padding="14,8" MinWidth="200">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NOTE GLOBALE / 5" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntretienEnCours.NoteGlobaleFormatee, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{Binding EntretienEnCours.CouleurMention, Mode=OneWay}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntretienEnCours.NoteEtoiles, Mode=OneWay}" Foreground="#F57F17" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding EntretienEnCours.MentionGlobale, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding EntretienEnCours.CouleurMention, Mode=OneWay}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Section 1 : Bilan des Objectifs N-1 -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="+ Ajouter un Objectif N-1" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding EstModifiable}" Padding="8,3" FontSize="11"
                                                Command="{Binding AjouterObjectifPasseCommand}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="1. BILAN DES OBJECTIFS DE L'EXERCICE ÉCOULÉ (N-1)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding EntretienEnCours.TauxAtteinteMoyenTexte, StringFormat={}  — Taux moyen : {0}, Mode=OneWay}"
                                                   FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding EntretienEnCours.ObjectifsPasses}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="{Binding EstVerrouille}"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                          RowHeaderWidth="0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource RuleBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Intitulé de l'objectif" Binding="{Binding Intitule, Mode=TwoWay}" Width="260"/>
                                        <DataGridTextColumn Header="Cible attendue" Binding="{Binding CibleAttendue, Mode=TwoWay}" Width="150"/>
                                        <DataGridTextColumn Header="Résultat obtenu" Binding="{Binding ResultatObtenu, Mode=TwoWay}" Width="150"/>
                                        <DataGridTextColumn Header="Atteinte (%)" Binding="{Binding TauxAtteintePct, Mode=TwoWay}" Width="90"/>
                                        <DataGridTextColumn Header="Poids" Binding="{Binding Poids, Mode=TwoWay}" Width="60"/>
                                        <DataGridTextColumn Header="Appréciation évaluateur" Binding="{Binding Appreciation, Mode=TwoWay}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Foreground="#C62828" Background="Transparent" BorderThickness="0"
                                                            IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.SupprimerObjectifPasseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section 2 : Évaluation des Compétences & Critères -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <!-- Ajout depuis le catalogue -->
                                        <TextBlock Text="Catalogue :" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                        <ComboBox ItemsSource="{Binding CatalogueCompetences}" SelectedItem="{Binding CompetenceAAjouter, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" Width="220" Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                                  IsEnabled="{Binding EstModifiable}"/>
                                        <Button Content="+ Ajouter depuis catalogue" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding EstModifiable}" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                                Command="{Binding AjouterCritereDepuisCatalogueCommand}"/>

                                        <Button Content="+ Critère libre" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding EstModifiable}" Padding="8,3" FontSize="11"
                                                Command="{Binding AjouterCritereCommand}"/>
                                    </StackPanel>

                                    <TextBlock Text="2. ÉVALUATION DES COMPÉTENCES &amp; QUALITÉS PROFESSIONNELLES" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding EntretienEnCours.Criteres}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="{Binding EstVerrouille}"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                          RowHeaderWidth="0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource RuleBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie, Mode=TwoWay}" Width="160"/>
                                        <DataGridTextColumn Header="Compétence / Critère évalué" Binding="{Binding Libelle, Mode=TwoWay}" Width="260"/>
                                        <DataGridTemplateColumn Header="Note (1 à 5)" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center"
                                                              IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <ComboBoxItem Content="1 - Insuffisant ★☆☆☆☆" Tag="1"/>
                                                        <ComboBoxItem Content="2 - À développer ★★☆☆☆" Tag="2"/>
                                                        <ComboBoxItem Content="3 - Conforme ★★★☆☆" Tag="3"/>
                                                        <ComboBoxItem Content="4 - Dépasse les attentes ★★★★☆" Tag="4"/>
                                                        <ComboBoxItem Content="5 - Remarquable ★★★★★" Tag="5"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Étoiles" Binding="{Binding NoteEtoiles, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Poids" Binding="{Binding Poids, Mode=TwoWay}" Width="55"/>
                                        <DataGridTextColumn Header="Commentaire &amp; Observations" Binding="{Binding Commentaire, Mode=TwoWay}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Foreground="#C62828" Background="Transparent" BorderThickness="0"
                                                            IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.SupprimerCritereCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section 3 : Nouveaux Objectifs N+1 -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="+ Ajouter un Objectif N+1" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding EstModifiable}" Padding="8,3" FontSize="11"
                                                Command="{Binding AjouterNouvelObjectifCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="3. FIXATION DES NOUVEAUX OBJECTIFS POUR L'EXERCICE SUIVANT (N+1)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding EntretienEnCours.NouveauxObjectifs}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="{Binding EstVerrouille}"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                          RowHeaderWidth="0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource RuleBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Intitulé de l'objectif opérationnel" Binding="{Binding Intitule, Mode=TwoWay}" Width="300"/>
                                        <DataGridTextColumn Header="Indicateur de mesure" Binding="{Binding IndicateurMesure, Mode=TwoWay}" Width="180"/>
                                        <DataGridTextColumn Header="Cible attendue" Binding="{Binding CibleAttendue, Mode=TwoWay}" Width="160"/>
                                        <DataGridTextColumn Header="Échéance" Binding="{Binding Echeance, Mode=TwoWay}" Width="120"/>
                                        <DataGridTextColumn Header="Priorité / Poids" Binding="{Binding Poids, Mode=TwoWay}" Width="90"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Foreground="#C62828" Background="Transparent" BorderThickness="0"
                                                            IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.SupprimerNouvelObjectifCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section 4 : Besoins de Formation & Évolution (RH-04) -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="+ Ajouter un Besoin de Formation" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding EstModifiable}" Padding="8,3" FontSize="11"
                                                Command="{Binding AjouterBesoinFormationCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="4. PLAN DE DÉVELOPPEMENT DES COMPÉTENCES &amp; BESOINS DE FORMATION (N+1)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding EntretienEnCours.BesoinsFormation}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="{Binding EstVerrouille}"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                          RowHeaderWidth="0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource RuleBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thème de formation souhaité" Binding="{Binding ThemeFormation, Mode=TwoWay}" Width="280"/>
                                        <DataGridTextColumn Header="Compétence visée" Binding="{Binding CompetenceVisee, Mode=TwoWay}" Width="200"/>
                                        <DataGridTemplateColumn Header="Priorité" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding Priorite, Mode=TwoWay}"
                                                              SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center"
                                                              IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <ComboBoxItem Content="1 - Normale" Tag="{x:Static models:PrioriteFormation.Normale}"/>
                                                        <ComboBoxItem Content="2 - Haute" Tag="{x:Static models:PrioriteFormation.Haute}"/>
                                                        <ComboBoxItem Content="3 - Urgente" Tag="{x:Static models:PrioriteFormation.Urgente}"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Avis &amp; Recommandation du Manager N+1" Binding="{Binding AvisEvaluateur, Mode=TwoWay}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Foreground="#C62828" Background="Transparent" BorderThickness="0"
                                                            IsEnabled="{Binding DataContext.EstModifiable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Command="{Binding DataContext.SupprimerBesoinFormationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section 5 : Synthèse & Appréciations collégiales -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="5. SYNTHÈSE, APPRÉCIATIONS CROISÉES &amp; DÉCISIONS RH" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Points Forts &amp; Réussites de l'exercice :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EntretienEnCours.PointsForts, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EstModifiable}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Axes de Progrès &amp; Améliorations attendues :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EntretienEnCours.AxesProgres, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EstModifiable}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Commentaires du Collaborateur évalué :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EntretienEnCours.CommentairesSalarie, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EstModifiable}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Appréciation Générale du Supérieur N+1 :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EntretienEnCours.CommentairesEvaluateur, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding EstModifiable}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Avis &amp; Décisions de la Direction des Ressources Humaines (Promotion, Augmentation, Mobilité) :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EntretienEnCours.AvisDirectionRH, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding EstModifiable}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── ONGLET 2 : HISTORIQUE PAR COLLABORATEUR ───────── -->
            <Grid Visibility="{Binding EstOngletHistorique, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Sélecteur de collaborateur -->
                            <RowDefinition Height="Auto"/>
                            <!-- Synthèse de l'agent -->
                            <RowDefinition Height="Auto"/>
                            <!-- Timeline des entretiens passés -->
                            <RowDefinition Height="*" MinHeight="350"/>
                        </Grid.RowDefinitions>

                        <!-- Ligne 0 : Sélecteur de Salarié -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sélectionner un collaborateur :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding SalariesActifs}" SelectedItem="{Binding SalarieSelectionne, Mode=TwoWay}"
                                          DisplayMemberPath="FullNameWithId" Width="360" Height="28" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Ligne 1 : Synthèse de l'agent -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Collaborateur :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.FullName, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.EmployeeId, StringFormat={}Matricule : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Service de rattachement :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.Service, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.Category, StringFormat={}Catégorie : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Poste actuel :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.PosteLibelle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SalarieSelectionne.Echelon, StringFormat={}Échelon : {0}, Mode=OneWay}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Historique recensé :" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkSubtleBrush}"/>
                                    <TextBlock Text="{Binding HistoriqueSalarie.Count, StringFormat={}{0} entretien(s) archivé(s), Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ligne 2 : Timeline des entretiens passés -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="1">
                            <DataGrid ItemsSource="{Binding HistoriqueSalarie}" SelectedItem="{Binding HistoriqueSelectionne, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RuleBrush}"
                                      RowHeaderWidth="0" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Exercice" Binding="{Binding AnneeExercice, Mode=OneWay}" Width="75" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Campagne" Binding="{Binding CampagneTitre, Mode=OneWay}" Width="200"/>
                                    <DataGridTextColumn Header="Date Entretien" Binding="{Binding DateEntretienTexte, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Évaluateur N+1" Binding="{Binding EvaluateurNom, Mode=OneWay}" Width="160"/>
                                    <DataGridTemplateColumn Header="Statut" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CouleurStatut, Mode=OneWay}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatutLibelle, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Note Globale (/5)" Binding="{Binding NoteFormatee, Mode=OneWay}" Width="120" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Mention Obtenue" Binding="{Binding MentionGlobale, Mode=OneWay}" Width="160"/>
                                    <DataGridTextColumn Header="Taux Obj N-1 (%)" Binding="{Binding TauxAtteinteMoyen, StringFormat={}{0:N1} %, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Formations" Binding="{Binding FormationsCount, StringFormat={}{0} besoin(s), Mode=OneWay}" Width="95"/>
                                    <DataGridTemplateColumn Header="Actions" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Télécharger PDF officiel" Style="{StaticResource MenuButtonStyle}"
                                                        Padding="8,2" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ImprimerHistoriquePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </Grid>
                </ScrollViewer>
