<UserControl x:Class="IUTSCalculator.Views.LivrePaieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:LivrePaieViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalBadgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="TotalBadgeValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Livre de paie" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Journal mensuel obligatoire : tous les salariés en lignes, rubriques en colonnes, totaux de contrôle"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterCommand}"/>
                <Button Content="Générer le livre de paie" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding GenererCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mois -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Mois" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="160" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding MoisDisponibles}"
                              DisplayMemberPath="Nom"
                              SelectedItem="{Binding MoisSelectionne}"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="110" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <!-- Période / Statut -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PeriodeChoisieLibelle}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="État issu des bulletins enregistrés"
                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Résultat (Tableau croisé) ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <!-- En-tête de la carte avec totaux de synthèse rapide -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RÉCAPITULATIF DES BULLETINS"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding LivrePaie.EstBrouillon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="BROUILLON (PÉRIODE NON CLÔTURÉE)" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ALivrePaie, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding LivrePaie.Effectif, StringFormat='Effectif : {0} salarié(s)'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="|" Foreground="{StaticResource RuleStrongBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Brut : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LivrePaie.TotalBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="|" Foreground="{StaticResource RuleStrongBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Net : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LivrePaie.TotalNetAPayer, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush2}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bandeau de totaux de contrôle en pied de tableau -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="16,10"
                        Visibility="{Binding ALivrePaie, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL BASE" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalSalaireBase, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TOTAL BRUT" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CNSS SALARIALE" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalCnssSalariale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="5" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="IUTS" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalIuts, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="7" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="NET À PAYER" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalNetAPayer, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}" Foreground="{StaticResource AccentBrush2}"/>
                        </StackPanel>
                        <Border Grid.Column="9" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="10">
                            <TextBlock Text="MASSE SALARIALE" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding LivrePaie.TotalMasseSalariale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding ALivrePaie, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucun livre de paie généré" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Choisissez le mois et l'année, puis cliquez sur « Générer le livre de paie » pour afficher le tableau récapitulatif."
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                </StackPanel>

                <!-- Tableau croisé scrollable horizontalement et verticalement -->
                <DataGrid ItemsSource="{Binding Lignes}"
                          Style="{StaticResource FormDataGridStyle}"
                          Margin="0" BorderThickness="0" IsReadOnly="True"
                          AutoGenerateColumns="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ALivrePaie, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="Nom et prénom" Binding="{Binding NomComplet, Mode=OneWay}"
                                            Width="160" MinWidth="140"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="Emploi" Binding="{Binding Emploi}"
                                            Width="120" MinWidth="100"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                        <DataGridTextColumn Header="Sal. base"
                                            Binding="{Binding SalaireDeBase, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="95" MinWidth="85"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ind. logement"
                                            Binding="{Binding IndemniteLogement, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="95" MinWidth="85"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ind. transport"
                                            Binding="{Binding IndemniteTransport, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="95" MinWidth="85"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ind. fonction"
                                            Binding="{Binding IndemniteFonction, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="95" MinWidth="85"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ind. sujétion"
                                            Binding="{Binding IndemniteSujetion, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="95" MinWidth="85"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Gains var."
                                            Binding="{Binding GainsVariables, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ret. absences"
                                            Binding="{Binding RetenueAbsences, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Brut"
                                            Binding="{Binding SalaireBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="105" MinWidth="95"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS sal."
                                            Binding="{Binding CnssSalariale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="IUTS"
                                            Binding="{Binding Iuts, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ret. spéc."
                                            Binding="{Binding RetenueSpeciale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Ret. div."
                                            Binding="{Binding RetenuesDiverses, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Net à payer"
                                            Binding="{Binding NetAPayer, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="110" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="CNSS pat."
                                            Binding="{Binding CnssPatronale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="TPA"
                                            Binding="{Binding Tpa, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="85" MinWidth="75"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="Masse salariale"
                                            Binding="{Binding MasseSalariale, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                            Width="110" MinWidth="100"
                                            ElementStyle="{StaticResource MoneyTextStyle}"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="AVERTISSEMENTS ET POINTS D'ATTENTION" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
