<UserControl x:Class="IUTSCalculator.Views.ConventionCollectiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConventionCollectiveViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SubSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Conventions collectives &amp; grilles salariales" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Classification catégorielle, salaires minima garantis et valorisation de l'ancienneté légale (Art. 37 CCI-BF)"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Nouvelle convention" Tag="{StaticResource IconNew}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding NouvelleConventionCommand}"/>
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Enregistrer convention" Tag="{StaticResource IconSave}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding EnregistrerConventionCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Sélection et configuration de la Convention ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sélecteur convention -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Convention collective active" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Conventions}"
                                  SelectedItem="{Binding SelectedConvention}"
                                  DisplayMemberPath="Libelle"
                                  Height="30"/>
                    </StackPanel>

                    <!-- Code -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Code convention" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CodeConvention, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Libellé -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Désignation / Intitulé légal" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibelleConvention, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Suppression convention -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button Content="Supprimer" Tag="{StaticResource IconDelete}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="{StaticResource DangerBrush}"
                                Command="{Binding SupprimerConventionCommand}"
                                ToolTip="Supprimer la convention collective sélectionnée"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Base de calcul ancienneté -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Assiette de calcul de l'ancienneté" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding OptionsBaseCalcul}"
                                  SelectedItem="{Binding SelectedBaseCalculOption}"
                                  DisplayMemberPath="Libelle"
                                  Height="30"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Notes / Référence légale" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DescriptionConvention, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Padding="6,2" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Statut actif -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,14,0,0">
                        <CheckBox Content="Convention active" IsChecked="{Binding EstActiveConvention}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ Corps principal : Grilles / Barème + Simulateur ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Volet Gauche : Grille salariale et Tranches d'ancienneté -->
            <TabControl Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}">
                
                <!-- Onglet 1 : Grille des salaires minima -->
                <TabItem Header="Grille des salaires minima conventionnels">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tableau de la grille -->
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Grilles}"
                                  SelectedItem="{Binding SelectedGrille}"
                                  Style="{StaticResource FormDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="90"/>
                                <DataGridTextColumn Header="Échelon" Binding="{Binding Echelon}" Width="70"/>
                                <DataGridTextColumn Header="Salaire minimum" Binding="{Binding SalaireMinimum, StringFormat={}{0:N0} FCFA}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Désignation / Emploi repère" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Bandeau d'édition de grille -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CategorieGrille, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Échelon" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EchelonGrille, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Salaire min (FCFA)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SalaireMinimumGrille, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding DescriptionGrille, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <Button Grid.Column="8" Content="Enregistrer" VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        Command="{Binding EnregistrerGrilleCommand}"/>

                                <Button Grid.Column="10" Content="Suppr." VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding SupprimerGrilleCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Onglet 2 : Barème d'ancienneté -->
                <TabItem Header="Barème légal d'ancienneté">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tableau des tranches -->
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Tranches}"
                                  SelectedItem="{Binding SelectedTranche}"
                                  Style="{StaticResource FormDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tranche d'années" Binding="{Binding LibelleTranche}" Width="160"/>
                                <DataGridTextColumn Header="Années min" Binding="{Binding AnneesMin}" Width="100"/>
                                <DataGridTextColumn Header="Années max" Binding="{Binding AnneesMax}" Width="100"/>
                                <DataGridTextColumn Header="Taux légal (%)" Binding="{Binding TauxPourcentage, StringFormat={}{0:0.##} %}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Bandeau d'édition de tranche -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Années min" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AnneesMinTranche, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Années max" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AnneesMaxTranche, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Taux (%)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding TauxTranche, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}" Height="28" Padding="4,2"/>
                                </StackPanel>

                                <Button Grid.Column="7" Content="Enregistrer" VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        Command="{Binding EnregistrerTrancheCommand}"/>

                                <Button Grid.Column="9" Content="Suppr." VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding SupprimerTrancheCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Volet Droit : Simulateur & Conformité légale -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Simulateur &amp; Conformité légale" Style="{StaticResource ScreenTitleStyle}" FontSize="16" Margin="0,0,0,2"/>
                        <TextBlock Text="Vérification instantanée de la prime d'ancienneté et du respect du salaire minimum conventionnel pour tout salarié."
                                   FontSize="11" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Sélecteur de salarié -->
                        <TextBlock Text="Sélectionner un salarié" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedEmployeeForSimulation}"
                                  DisplayMemberPath="FullName"
                                  Height="30" Margin="0,0,0,10"/>

                        <!-- Date de simulation -->
                        <TextBlock Text="Date d'évaluation de la paie" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateSimulation}" Height="30" Margin="0,0,0,16"/>

                        <!-- Carte récapitulative de simulation -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SITUATION CONTRACTUELLE" Style="{StaticResource SubSectionHeader}" Foreground="{StaticResource InkMutedBrush}"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Date d'embauche :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEmployeeForSimulation.HireDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ancienneté révolue :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding ResultatSimulation.Annees, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="ans"/>
                                        <Run Text="{Binding ResultatSimulation.Mois, Mode=OneWay}"/>
                                        <Run Text="mois"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Catégorie / Échelon :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding SelectedEmployeeForSimulation.Category, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="— Éch."/>
                                        <Run Text="{Binding SelectedEmployeeForSimulation.Echelon, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Salaire de base contractuel :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEmployeeForSimulation.BaseSalary, StringFormat={}{0:N0} FCFA}" FontWeight="SemiBold"/>
                                </Grid>

                                <Separator Margin="0,8" Background="{StaticResource RuleBrush}"/>

                                <TextBlock Text="CALCUL DE LA PRIME D'ANCIENNETÉ" Style="{StaticResource SubSectionHeader}" Foreground="{StaticResource AccentBrush}"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Taux conventionnel :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResultatSimulation.TauxPourcentage, StringFormat={}{0:0.##} %}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Assiette de calcul :" Foreground="{StaticResource InkMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResultatSimulation.BaseDeCalcul, StringFormat={}{0:N0} FCFA}"/>
                                </Grid>

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Prime d'ancienneté (PRIMEANC) :" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResultatSimulation.Montant, StringFormat={}{0:N0} FCFA}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Indicateur de conformité conventionnelle -->
                        <Border Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding ResultatSimulation.EstConformeSalaireDeBase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="✔ CONFORMITÉ SALARIALE RESPECTÉE" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                                <TextBlock Text="Le salaire de base du salarié est égal ou supérieur au minimum garanti par la convention collective."
                                           FontSize="11" Foreground="#166534" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="12,10"
                                Visibility="{Binding ResultatSimulation.EstNonConformeSalaireDeBase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="⚠ ALERTE DE NON-CONFORMITÉ CONVENTIONNELLE" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ResultatSimulation.MessageConformite}"
                                           FontSize="11" Foreground="#991B1B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════ Pied d'écran : message de statut ═══════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="0,1,0,0" Padding="12,8" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource InkMutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
