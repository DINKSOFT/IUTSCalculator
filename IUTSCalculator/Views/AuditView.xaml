<UserControl x:Class="IUTSCalculator.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuditViewModel}"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="750">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalBadgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="TotalBadgeValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Journal d'audit et traçabilité" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Contrôle des opérations sensibles : qui a changé quel salaire, quand, et quelle était la valeur précédente"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Vérifier l'intégrité" Tag="{StaticResource IconLock}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Recalcule la chaîne des empreintes SHA-256 de tout le journal et signale la première entrée modifiée, supprimée ou insérée après coup."
                        Command="{Binding VerifierIntegriteCommand}"/>
                <Button Content="Fichier CSV (.csv)" Tag="{StaticResource IconSave}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterCsvCommand}"/>
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterExcelCommand}"/>
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding FiltrerCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres de filtrage multicritères ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date début -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="Date début" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Width="125" HorizontalAlignment="Left"
                                    SelectedDate="{Binding DateDebut}"/>
                    </StackPanel>

                    <!-- Date fin -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="Date fin" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Width="125" HorizontalAlignment="Left"
                                    SelectedDate="{Binding DateFin}"/>
                    </StackPanel>

                    <!-- Entité / Module -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Top">
                        <TextBlock Text="Entité / Module" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="145" HorizontalAlignment="Left"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding ModulesDisponibles}"
                                  SelectedItem="{Binding ModuleSelectionne}"/>
                    </StackPanel>

                    <!-- Action -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Top">
                        <TextBlock Text="Type d'action" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="165" HorizontalAlignment="Left"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding ActionsDisponibles}"
                                  SelectedItem="{Binding ActionSelectionnee}"/>
                    </StackPanel>

                    <!-- Utilisateur -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Top">
                        <TextBlock Text="Opérateur" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="160" HorizontalAlignment="Left"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding UtilisateursDisponibles}"
                                  SelectedItem="{Binding UtilisateurSelectionne}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recherche textuelle rapide -->
                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Recherche rapide :" FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}" Margin="0"
                                 Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <Button Grid.Column="2" Content="Réinitialiser les filtres" Tag="{StaticResource IconClear}"
                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="0"
                            Command="{Binding ReinitialiserCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ Cartes métriques KPI ═══════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total événements -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL ÉVÉNEMENTS" Style="{StaticResource TotalBadgeLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalEntrees, Mode=OneWay}"
                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text=" tracés" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Modifications salariales -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="MODIFICATIONS DE SALAIRES" Style="{StaticResource TotalBadgeLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalModificationsSalaires, Mode=OneWay}"
                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush2}"/>
                        <TextBlock Text=" variations" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions sensibles -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="ACTIONS SENSIBLES" Style="{StaticResource TotalBadgeLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalActionsSensibles, Mode=OneWay}"
                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text=" arrêtés / fiches" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dernière activité -->
            <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="DERNIÈRE ACTIVITÉ" Style="{StaticResource TotalBadgeLabel}"/>
                    <TextBlock Text="{Binding DerniereActivite, Mode=OneWay}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Tableau d'audit et détails ═══════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <!-- En-tête de la carte -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="REGISTRE CHRONOLOGIQUE DES ACTIONS DE PAIE"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

                            <Border Background="#E6F0ED" BorderBrush="#2BA24C" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2"
                                    ToolTip="Chaque entrée porte l'empreinte SHA-256 de son contenu et de l'entrée précédente. Cliquez sur « Vérifier l'intégrité » pour contrôler la chaîne."
                                    Visibility="{Binding BadgeScelleNonVerifie, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="JOURNAL SCELLÉ (SHA-256)" FontSize="10" FontWeight="Bold" Foreground="#1F7A4D"/>
                            </Border>
                            <Border Background="#E6F0ED" BorderBrush="#2BA24C" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2"
                                    Visibility="{Binding BadgeIntegriteVerifiee, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✓ INTÉGRITÉ VÉRIFIÉE" FontSize="10" FontWeight="Bold" Foreground="#1F7A4D"/>
                            </Border>
                            <Border Background="#FBEAE8" BorderBrush="#9C2F28" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2"
                                    Visibility="{Binding BadgeJournalAltere, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="⚠ JOURNAL ALTÉRÉ" FontSize="10" FontWeight="Bold" Foreground="#9C2F28"/>
                            </Border>
                            <Border Background="{StaticResource WarningTintBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2"
                                    ToolTip="La base du dossier n'a pas encore reçu la mise à niveau qui ajoute les empreintes (schéma v38)."
                                    Visibility="{Binding BadgeNonScelle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="JOURNAL NON SCELLÉ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Résultats : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalEntrees, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" entrée(s)" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding PaginationLibelle, Mode=OneWay}" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="{Binding APlusieursPages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="◀ Précédente" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                    Command="{Binding PagePrecedenteCommand}"
                                    Visibility="{Binding APlusieursPages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Suivante ▶" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                                    Command="{Binding PageSuivanteCommand}"
                                    Visibility="{Binding APlusieursPages, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Résultat de « Vérifier l'intégrité » -->
                <Border DockPanel.Dock="Top" Padding="16,8" Background="#EBF7F0"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding BadgeIntegriteVerifiee, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding MessageIntegrite, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="#1F7A4D"/>
                </Border>
                <Border DockPanel.Dock="Top" Padding="16,8" Background="#FBEAE8"
                        BorderBrush="#9C2F28" BorderThickness="0,0,0,1"
                        Visibility="{Binding BadgeJournalAltere, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding MessageIntegrite, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#9C2F28"/>
                </Border>

                <!-- Panneau d'inspection en pied de tableau (si sélectionné) -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="16,10"
                        Visibility="{Binding AEntreeSelectionnee, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DÉTAIL DE L'ÉVÉNEMENT SÉLECTIONNÉ" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding EntreeSelectionnee.DescriptionCourte, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                            <TextBlock Text="OBSERVATIONS / CONTEXTE" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding EntreeSelectionnee.Details, Mode=OneWay}"
                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="ENVIRONNEMENT" Style="{StaticResource TotalBadgeLabel}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding EntreeSelectionnee.Utilisateur, StringFormat='Opérateur : {0}', Mode=OneWay}"
                                           FontSize="11" Foreground="{StaticResource InkBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding EntreeSelectionnee.AdresseMachine, StringFormat='Poste : {0}', Mode=OneWay}"
                                           FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding AEntrees, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                    <TextBlock Text="&#xF182;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucun événement d'audit trouvé" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Ajustez vos filtres ou effectuez des opérations de paie pour alimenter le journal d'audit."
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                </StackPanel>

                <!-- Tableau du journal d'audit -->
                <DataGrid ItemsSource="{Binding Entrees}"
                          SelectedItem="{Binding EntreeSelectionnee}"
                          Style="{StaticResource FormDataGridStyle}"
                          Margin="0" BorderThickness="0" IsReadOnly="True"
                          AutoGenerateColumns="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding AEntrees, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstAlteree}" Value="True">
                                    <Setter Property="Background" Value="#FBEAE8"/>
                                    <Setter Property="Foreground" Value="#9C2F28"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding Id, Mode=OneWay}"
                                            Width="50" MinWidth="40"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Scellement" Binding="{Binding StatutScellement, Mode=OneWay}"
                                            Width="90" MinWidth="80"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Date &amp; Heure"
                                            Binding="{Binding DateAction, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}', Mode=OneWay}"
                                            Width="140" MinWidth="130"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur, Mode=OneWay}"
                                            Width="105" MinWidth="85"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Machine" Binding="{Binding AdresseMachine, Mode=OneWay}"
                                            Width="90" MinWidth="75"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Entité" Binding="{Binding Entite, Mode=OneWay}"
                                            Width="95" MinWidth="80"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Réf. / Matricule" Binding="{Binding EntiteId, Mode=OneWay}"
                                            Width="95" MinWidth="80"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Action" Binding="{Binding Action, Mode=OneWay}"
                                            Width="160" MinWidth="130"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Champ modifié" Binding="{Binding ChampModifie, Mode=OneWay}"
                                            Width="135" MinWidth="110"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Ancienne valeur" Binding="{Binding AncienneValeur, Mode=OneWay}"
                                            Width="125" MinWidth="100"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Nouvelle valeur" Binding="{Binding NouvelleValeur, Mode=OneWay}"
                                            Width="125" MinWidth="100"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Détails et observations" Binding="{Binding Details, Mode=OneWay}"
                                            Width="*" MinWidth="220"
                                            ElementStyle="{StaticResource CellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══════════ Barre d'état ═══════════ -->
        <Border Grid.Row="4" Margin="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,6,0,0">
            <TextBlock Text="{Binding MessageStatut}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
