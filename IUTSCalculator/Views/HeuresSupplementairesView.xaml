<UserControl x:Class="IUTSCalculator.Views.HeuresSupplementairesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:HeuresSupplementairesViewModel}"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="750">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalBadgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="TotalBadgeValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Heures supplémentaires &amp; majorations" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Décompte mensuel et valorisation légale des heures sup (115%, 130%, 150%, 200%)"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterExcelCommand}"/>
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Enregistrer la saisie" Tag="{StaticResource IconSave}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding EnregistrerCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres de sélection de période & Recherche ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mois -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Mois de paie" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="135"
                              ItemsSource="{Binding MoisDisponibles}"
                              SelectedItem="{Binding MoisSelectionne}"
                              DisplayMemberPath="Nom"/>
                </StackPanel>

                <!-- Année -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="95"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <!-- Recherche -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Filtrer par salarié / matricule" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" Padding="6,2"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Remise à zéro -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <Button Content="Remise à zéro"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Réinitialise toutes les heures supplémentaires saisies à 0 pour ce mois"
                            Command="{Binding ReinitialiserCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Bannière d'alerte si période clôturée ═══════════ -->
        <Border Grid.Row="2" Background="#FEFCE8" BorderBrush="#CA8A04" BorderThickness="1" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding EstPeriodeCloturee, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔒  PÉRIODE CLÔTURÉE : " FontWeight="Bold" Foreground="#854D0E"/>
                <TextBlock Text="Cette période de paie est verrouillée. Les heures supplémentaires sont figées en consultation seule." Foreground="#854D0E"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ Bandeau des indicateurs KPI ═══════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12"
              Visibility="{Binding PeriodeOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1 : Total Heures -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL HEURES SUP" Style="{StaticResource TotalBadgeLabel}"/>
                    <TextBlock Text="{Binding TotalHeuresMois, StringFormat={}{0:N2} h, Mode=OneWay}"
                               Style="{StaticResource TotalBadgeValue}" Foreground="{StaticResource AccentBrush2}"/>
                </StackPanel>
            </Border>

            <!-- KPI 2 : Total Brut -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="MONTANT BRUT TOTAL" Style="{StaticResource TotalBadgeLabel}"/>
                    <TextBlock Text="{Binding TotalMontantMois, StringFormat={}{0:N0} FCFA, Mode=OneWay}"
                               Style="{StaticResource TotalBadgeValue}" Foreground="#14675A"/>
                </StackPanel>
            </Border>

            <!-- KPI 3 : Salariés concernés -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="SALARIÉS BÉNÉFICIAIRES" Style="{StaticResource TotalBadgeLabel}"/>
                    <TextBlock Text="{Binding NombreSalariesConcernes, StringFormat={}{0} salarié(s), Mode=OneWay}"
                               Style="{StaticResource TotalBadgeValue}"/>
                </StackPanel>
            </Border>

            <!-- KPI 4 : Taux horaire moyen -->
            <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="TAUX HORAIRE MOYEN" Style="{StaticResource TotalBadgeLabel}"/>
                    <TextBlock Text="{Binding TauxHoraireMoyen, StringFormat={}{0:N2} FCFA, Mode=OneWay}"
                               Style="{StaticResource TotalBadgeValue}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Tableau / Grille matricielle de saisie ═══════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding VueFiltree}"
                      SelectedItem="{Binding LigneSelectionnee}"
                      Style="{StaticResource FormDataGridStyle}"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="{Binding EstPeriodeCloturee}">
                <DataGrid.Columns>
                    <!-- Matricule -->
                    <DataGridTextColumn Header="Matricule"
                                        Binding="{Binding Matricule, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="100"/>

                    <!-- Nom & Prénom -->
                    <DataGridTextColumn Header="Collaborateur"
                                        Binding="{Binding NomComplet, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="2*" MinWidth="160"/>

                    <!-- Salaire de base -->
                    <DataGridTextColumn Header="Salaire Base"
                                        Binding="{Binding SalaireDeBase, StringFormat={}{0:N0} FCFA, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="115"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource MoneyTextStyle}"/>

                    <!-- Taux horaire base -->
                    <DataGridTextColumn Header="Taux Horaire"
                                        Binding="{Binding TauxHoraireBase, StringFormat={}{0:N2}, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="95"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource RightTextStyle}"/>

                    <!-- Heures 15% -->
                    <DataGridTextColumn Header="HS 15% (115%)"
                                        Binding="{Binding Heures15, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="105"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource RightTextStyle}"/>

                    <!-- Heures 30% -->
                    <DataGridTextColumn Header="HS 30% (130%)"
                                        Binding="{Binding Heures30, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="105"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource RightTextStyle}"/>

                    <!-- Heures 50% -->
                    <DataGridTextColumn Header="HS 50% (150%)"
                                        Binding="{Binding Heures50, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="105"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource RightTextStyle}"/>

                    <!-- Heures 100% -->
                    <DataGridTextColumn Header="HS 100% (200%)"
                                        Binding="{Binding Heures100, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="105"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource RightTextStyle}"/>

                    <!-- Total Heures -->
                    <DataGridTextColumn Header="Total Heures"
                                        Binding="{Binding TotalHeures, StringFormat={}{0:0.##} h, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="95"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightTextStyle}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush2}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Montant Brut Total -->
                    <DataGridTextColumn Header="Total Brut (FCFA)"
                                        Binding="{Binding MontantTotal, StringFormat={}{0:N0} FCFA, Mode=OneWay}"
                                        IsReadOnly="True"
                                        Width="130"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#14675A"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Commentaire -->
                    <DataGridTextColumn Header="Commentaire"
                                        Binding="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════ Barre de statut ═══════════ -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8,4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
        </Border>
    </Grid>
</UserControl>
