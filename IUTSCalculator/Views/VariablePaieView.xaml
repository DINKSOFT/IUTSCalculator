<UserControl x:Class="IUTSCalculator.Views.VariablePaieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:VariablePaieViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Variables du mois" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding NombreLignes, Mode=OneWay}"/>
                    <Run Text="ligne(s) — heures, primes, absences et retenues du mois, sans toucher à la fiche du salarié"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Recharger" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Enregistrer" Tag="{StaticResource IconSave}" Margin="0" Width="140"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding EnregistrerCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Barre de période et actions de masse ═══════════

             Deux groupes, jamais renvoyés à la ligne : « Période traitée » à gauche,
             largeur fixe (Auto), et « Appliquer une rubrique à tout l'effectif » à
             droite, sur une colonne étoile qui absorbe toute la largeur restante.

             Cette dernière colonne est en « * » et non en « Auto » : c'est elle qui
             se comprime quand la fenêtre rétrécit, si bien que rien ne peut plus
             être poussé hors de l'écran comme avec une barre entièrement en Auto.
             Sa MinWidth garantit que les deux boutons restent lisibles, et la
             combo des rubriques, étirée, affiche la désignation complète
             (« HSUP — Heures supplémentaires ») au lieu de la tronquer.

             Les contrôles sont tous en hauteur 34 pour aligner les bases.

             Les actions portant sur UNE ligne ne sont pas ici mais au pied de la
             grille, à côté de la ligne concernée.
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="330"/>
                </Grid.ColumnDefinitions>

                <!-- Groupe gauche : la période traitée -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Période traitée" Style="{StaticResource SectionLabelStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="150" Height="34" Margin="0,0,8,0"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding MoisDisponibles}"
                                  DisplayMemberPath="Nom"
                                  SelectedItem="{Binding MoisSelectionne}"/>
                        <ComboBox Width="96" Height="34" Margin="0,0,14,0"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding AnneesDisponibles}"
                                  SelectedItem="{Binding Annee}"/>
                        <Button Content="Reporter le mois précédent" Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Recopie les variables du mois précédent. Remplace ce qui est saisi sur ce mois."
                                Command="{Binding ReporterCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filet de séparation entre les deux groupes -->
                <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Margin="22,4,22,2"
                           VerticalAlignment="Stretch"
                           Fill="{StaticResource RuleBrush}"/>

                <!-- Groupe droit : la même rubrique pour tout l'effectif -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Appliquer une rubrique à tout l'effectif"
                               Style="{StaticResource SectionLabelStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Height="34" Margin="0,0,14,0"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding RubriquesSaisissables}"
                                  DisplayMemberPath="Designation"
                                  SelectedItem="{Binding RubriqueAAjouter}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Ajouter à tous"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Crée cette rubrique sur la ligne de chaque salarié du mois, à zéro."
                                    Command="{Binding AjouterATousCommand}"/>
                            <Button Content="Retirer de tous" Margin="0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Retire cette rubrique de toutes les lignes du mois — le symétrique de « Ajouter à tous »."
                                    Command="{Binding RetirerATousCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Période clôturée : bandeau pleine largeur sous les deux groupes -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Margin="0,14,0,0" Padding="12,8" CornerRadius="3"
                        Background="{StaticResource WarningTintBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        Visibility="{Binding PeriodeCloturee, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Période clôturée — lecture seule. Rouvrez-la depuis « Périodes de paie » pour corriger."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource InkBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ Saisie et totaux ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <TextBlock Text="SAISIE" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}"
                                       Text="{Binding PeriodeLibelle}"/>
                        </Grid>
                    </Border>

                    <!-- ═══════════ Barre de recherche et filtres variables ═══════════ -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche textuelle -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="32" Padding="28,4,26,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Rechercher par salarié, matricule, rubrique, note..."/>
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource InkSubtleBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Width="20" Height="20"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Effacer la recherche"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Filtre Sens -->
                            <ComboBox Grid.Column="2" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding SensFiltreOptions}"
                                      SelectedValue="{Binding SelectedSensFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par sens (gain, retenue)"/>

                            <!-- Filtre Rubrique -->
                            <ComboBox Grid.Column="4" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding RubriquesSaisissables}"
                                      SelectedItem="{Binding SelectedRubriqueFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Designation"
                                      ToolTip="Filtrer par rubrique spécifique"/>

                            <!-- Réinitialiser -->
                            <Button Grid.Column="5" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                                    MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Réinitialiser les filtres"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Compteur de lignes -->
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombreLignesAffichees, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding NombreLignes, Mode=OneWay}"/>
                                <Run Text="ligne(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Retraits : au pied de la grille, là où se trouve la ligne à retirer.
                         La touche Suppr fonctionne aussi (CanUserDeleteRows). -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,10"
                            Visibility="{Binding PeriodeOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Une seule rangée, jamais repliée : l'ajout à gauche, un filet,
                             puis les trois retraits ; l'indicateur « Salarié visé » occupe
                             la colonne étoile et se tronque par des points de suspension
                             au lieu de repousser les boutons à la ligne suivante.

                             Les boutons abandonnent la MinWidth de 110 du style commun :
                             quatre boutons calibrés sur le plus long dépassaient la
                             largeur de la carte et se repliaient sur deux rangs. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="60"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Ajouter une ligne" Tag="{StaticResource IconAdd}"
                                        MinWidth="0" Padding="12,0" Margin="0"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding AjouterLigneCommand}"/>

                                <Rectangle Width="1" Margin="12,5,12,5"
                                           VerticalAlignment="Stretch"
                                           Fill="{StaticResource RuleBrush}"/>

                                <Button Content="Retirer la ligne" Tag="{StaticResource IconDelete}"
                                        MinWidth="0" Padding="12,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding SupprimerLigneCommand}"/>
                                <Button Content="Retirer le salarié"
                                        MinWidth="0" Padding="12,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Retire toutes les lignes du salarié sélectionné, ici ou dans le panneau de droite."
                                        Command="{Binding RetirerSalarieCommand}"/>
                                <Button Content="Tout effacer" Margin="0"
                                        MinWidth="0" Padding="12,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Vide la saisie du mois. Rien n'est perdu en base tant que vous n'enregistrez pas : « Recharger » ramène la dernière version enregistrée."
                                        Command="{Binding ToutEffacerCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                                       ToolTip="{Binding SalarieViseLibelle, Mode=OneWay}">
                                <Run Text="Salarié visé :"/>
                                <Run Text="{Binding SalarieViseLibelle, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding VariablesView}"
                              SelectedItem="{Binding VariableSelectionnee}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="True"
                              IsReadOnly="{Binding PeriodeCloturee}">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Salarié"
                                                    SelectedValueBinding="{Binding EmployeeId}"
                                                    SelectedValuePath="EmployeeId"
                                                    DisplayMemberPath="FullName"
                                                    Width="2*" MinWidth="150">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Salaries, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Salaries, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>

                            <DataGridComboBoxColumn Header="Rubrique"
                                                    SelectedValueBinding="{Binding CodeRubrique}"
                                                    SelectedValuePath="Code"
                                                    DisplayMemberPath="Designation"
                                                    Width="2*" MinWidth="160">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.RubriquesSaisissables, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.RubriquesSaisissables, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>

                            <DataGridTextColumn Header="Sens" Binding="{Binding SensLibelle}"
                                                IsReadOnly="True" Width="84"
                                                ElementStyle="{StaticResource CenterTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>

                            <DataGridTextColumn Header="Quantité"
                                                Binding="{Binding Quantite, StringFormat=N2, ConverterCulture=fr-FR}"
                                                Width="100"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                            <DataGridTextColumn Header="Montant"
                                                Binding="{Binding Montant, Converter={StaticResource MontantConverter}}"
                                                Width="*" MinWidth="95"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                            <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}"
                                                Width="2*" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Totaux par salarié -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="INCIDENCE PAR SALARIÉ" HorizontalAlignment="Left"
                                   Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Total des gains"
                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,0,0,6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding TotalGains, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Total des retenues"
                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding TotalRetenues, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>

                            <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                    Content="Retirer ce salarié du mois" HorizontalAlignment="Stretch"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Retire toutes les lignes du salarié sélectionné dans cette liste."
                                    Visibility="{Binding PeriodeOuverte, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{Binding RetirerSalarieCommand}"/>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding TotauxView}"
                              SelectedItem="{Binding TotalSelectionne}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie}"
                                                Width="*" MinWidth="100"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Gains"
                                                Binding="{Binding TotalGains, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="82"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Retenues"
                                                Binding="{Binding TotalRetenues, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="82"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Net"
                                                Binding="{Binding Net, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                                Width="82"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10" CornerRadius="3"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="À VÉRIFIER" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
