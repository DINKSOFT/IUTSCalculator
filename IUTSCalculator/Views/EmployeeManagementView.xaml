<UserControl x:Class="IUTSCalculator.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IUTSCalculator.Views"
             xmlns:vm="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <!-- Libellé de la colonne de gauche des formulaires : une largeur unique,
             c'est ce qui fait que tous les champs s'alignent enfin. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Montant : aligné à droite, chiffres tabulaires. -->
        <Style x:Key="MoneyBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="FieldDate" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Employés" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding Employees.Count, Mode=OneWay}"/>
                    <Run Text="salariés  ·  total des salaires de base"/>
                    <Run Text="{Binding TotalSalaireBase, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                    <Run Text="FCFA"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Importer"
                        Tag="{StaticResource IconImport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ImportEmployeesCommand}"/>
                <Button Content="Nouveau salarié"
                        Tag="{StaticResource IconAdd}"
                        Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauSalarieCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Liste + fiche ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ───── Liste ───── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>

                    <!-- ── Barre de recherche et filtres ── -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Background="{StaticResource SurfaceAltBrush}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche textuelle rapide -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="32" Padding="28,4,26,4" Margin="0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Rechercher par nom, prénom, matricule, emploi, CNSS, IFU..."/>
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource InkSubtleBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Width="20" Height="20"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Effacer la recherche"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Filtre Statut -->
                            <ComboBox Grid.Column="2" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding StatutsFiltreOptions}"
                                      SelectedValue="{Binding SelectedStatutFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par statut"/>

                            <!-- Filtre Catégorie -->
                            <ComboBox Grid.Column="4" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding CategoriesFiltreOptions}"
                                      SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                      ToolTip="Filtrer par catégorie professionnelle"/>

                            <!-- Réinitialiser les filtres -->
                            <Button Grid.Column="5" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                                    MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Réinitialiser tous les critères de recherche et filtres"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource SurfaceAltBrush}" Padding="14,8">
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombreSalariesAffiches, Mode=OneWay}"/>
                                <Run Text="sur"/>
                                <Run Text="{Binding Employees.Count, Mode=OneWay}"/>
                                <Run Text="salarié(s)"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="Total base filtré"/>
                                <Run Text="{Binding TotalSalaireBaseAffiche, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"
                                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <Run Text="FCFA"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding EmployeesView}"
                              SelectedItem="{Binding SelectedEmployee}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0"
                              BorderThickness="0">
                        <!-- Sept colonnes ne tenaient pas dans la largeur disponible.
                             Or ce sont les colonnes en « * » qui se compriment quand la
                             place manque : le nom, le prénom et l'emploi étaient donc
                             écrasés les premiers. Nom et prénom sont désormais réunis en
                             une seule colonne, avec une largeur minimale qui l'empêche
                             d'être rognée, et les deux indemnités secondaires quittent la
                             liste — elles restent lisibles dans la fiche de droite, avec
                             leur plafond. -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nom et prénom" Width="2*" MinWidth="210"
                                                    SortMemberPath="LastName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="LastName"/>
                                                    <Binding Path="FirstName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Emploi" Binding="{Binding Fonction}"
                                                Width="*" MinWidth="130"
                                                ElementStyle="{StaticResource CellTextStyle}"/>

                            <DataGridTextColumn Header="Service" Binding="{Binding Service}"
                                                Width="*" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>

                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}"
                                                Width="Auto" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>

                            <DataGridTextColumn Header="Salaire de base"
                                                Binding="{Binding BaseSalary, StringFormat={}{0:N0}}"
                                                Width="120" MinWidth="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                            <DataGridTextColumn Header="Charges"
                                                Binding="{Binding FamilyCharges}"
                                                Width="80" MinWidth="70"
                                                ElementStyle="{StaticResource CenterTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>

                            <DataGridTemplateColumn Header="Statut" Width="85" MinWidth="75"
                                                    SortMemberPath="StatutSalarie">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatutSalarie}" Value="1">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatutSalarie}" Value="2">
                                                            <Setter Property="Background" Value="{StaticResource WarningTintBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatutLibelle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatutSalarie}" Value="1">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatutSalarie}" Value="2">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ───── Fiche ───── -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>

                    <!-- En-tête de la fiche -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <TextBlock Text="FICHE DU SALARIÉ" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nouveau salarié"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                <Setter Property="Text" Value="Modification"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Boutons Enregistrer / Supprimer (bas de fiche) -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <!-- Mode ajout : seul Enregistrer apparaît -->
                            <Button Content="Enregistrer le salarié"
                                    Tag="{StaticResource IconSave}"
                                    Margin="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding AddEmployeeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Mode modification : Enregistrer + Supprimer -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Supprimer"
                                        Tag="{StaticResource IconDelete}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Foreground="{StaticResource DangerBrush}"
                                        ToolTip="Supprimer définitivement la fiche de ce salarié"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DeleteEmployeeCommand}"/>
                                <Button Grid.Column="1"
                                        Content="Enregistrer"
                                        Tag="{StaticResource IconSave}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        ToolTip="Enregistrer les modifications de la fiche"
                                        Margin="0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding EditEmployeeCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Contenu défilant de la fiche -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel DataContext="{Binding FicheCourante}">

                            <!-- Alerte de sous-rémunération conventionnelle (module SOC-05) -->
                            <Border CornerRadius="4" Padding="10,8" Margin="0,0,0,14"
                                    Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding DataContext.EstNonConformeSalaireMinimum, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="⚠ Conformité conventionnelle :" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DataContext.MessageConformiteSalaireMinimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Foreground="{StaticResource InkBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="IDENTIFICATION &amp; CONTRAT" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Prénom" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Emploi" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Fonction, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Service" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           ToolTip="Service ou département (ex. Comptabilité, Production). Utilisé comme axe de ventilation du tableau de bord masse salariale."
                                           Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Catégorie" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.EmployeeCategories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Échelon" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.EchelonsDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedItem="{Binding Echelon, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Convention" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.ConventionsDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedValue="{Binding ConventionId, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedValuePath="Id"
                                           DisplayMemberPath="Libelle"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Date d'entrée" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding DateEntreeNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Situation" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.SituationsMatrimoniales, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedItem="{Binding SituationMatrimoniale, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Statut" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.StatutsSalarieDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedValue="{Binding StatutSalarie, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedValuePath="Key"
                                           DisplayMemberPath="Value"/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Matricule CNSS" Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"/>
                                <TextBox   Grid.Row="10" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           ToolTip="Numéro d'assuré à la CNSS. Sans lui, la ligne du salarié ne peut pas être rattachée sur la déclaration."
                                           Text="{Binding NumeroCnss, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Date sortie" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding DateSortie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Motif départ" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="12" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding MotifDepart, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <TextBlock Text="ÉTAT CIVIL" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Né(e) le" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding DateNaissance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="À" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding LieuNaissance, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sexe" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           IsEditable="True"
                                           Text="{Binding Sexe, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="Masculin"/>
                                    <ComboBoxItem Content="Féminin"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Nationalité" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Nationalite, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="CNIB n°" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding NumeroCnib, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Délivrée le" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding DateDelivranceCnib, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="À" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding LieuDelivranceCnib, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <TextBlock Text="COORDONNÉES ET RÈGLEMENT" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Adresse" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Téléphone" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Courriel" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="IFU" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding NumeroIfu, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Règlement" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           IsEditable="True"
                                           Text="{Binding ModeReglement, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="Virement"/>
                                    <ComboBoxItem Content="Espèces"/>
                                    <ComboBoxItem Content="Chèque"/>
                                    <ComboBoxItem Content="Mobile money"/>
                                </ComboBox>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Banque" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Banque, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="N° de compte" Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding NumeroCompte, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="3"
                                    Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Visibility="{Binding CoordonneesBancairesCompletes, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                                <TextBlock Text="Règlement par virement sans numéro de compte : la paie de ce salarié ne pourra pas partir."
                                           TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource InkBrush}"/>
                            </Border>

                            <!-- ══ Personnes à charge (SAL-01) ══ -->
                            <StackPanel Visibility="{Binding DataContext.GereLesPersonnesACharge, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PERSONNES À CHARGE" VerticalAlignment="Center"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Foreground="{StaticResource AccentBrush2}" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Ajouter" MinWidth="0" Padding="10,0" Height="28" Margin="0,0,6,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Ajouter une personne à charge"
                                                Command="{Binding DataContext.AjouterPersonneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Content="Retirer" MinWidth="0" Padding="10,0" Height="28" Margin="0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                ToolTip="Retirer la personne sélectionnée"
                                                Command="{Binding DataContext.SupprimerPersonneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding DataContext.PersonnesACharge, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DataContext.PersonneSelectionnee, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Style="{StaticResource FormDataGridStyle}"
                                          IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          MaxHeight="220" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}"
                                                            Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}"
                                                            Width="*" MinWidth="90"/>
                                        <DataGridComboBoxColumn Header="Lien"
                                                                SelectedItemBinding="{Binding Lien}"
                                                                Width="100" MinWidth="90">
                                            <DataGridComboBoxColumn.ElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.LiensDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </Style>
                                            </DataGridComboBoxColumn.ElementStyle>
                                            <DataGridComboBoxColumn.EditingElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.LiensDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </Style>
                                            </DataGridComboBoxColumn.EditingElementStyle>
                                        </DataGridComboBoxColumn>
                                        <DataGridTextColumn Header="Né(e) le"
                                                            Binding="{Binding DateNaissance, StringFormat=dd/MM/yyyy}"
                                                            Width="100" MinWidth="90"/>
                                        <DataGridTextColumn Header="Âge" Binding="{Binding AgeLibelle}"
                                                            IsReadOnly="True" Width="70" MinWidth="60"
                                                            ElementStyle="{StaticResource CenterTextStyle}"
                                                            HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                                        <DataGridCheckBoxColumn Header="Études" Binding="{Binding PoursuitDesEtudes}"
                                                                Width="70"/>
                                        <DataGridCheckBoxColumn Header="Handicap" Binding="{Binding SituationDeHandicap}"
                                                                Width="80"/>
                                        <DataGridCheckBoxColumn Header="Compte" Binding="{Binding CompteCommeCharge}"
                                                                Width="70"/>
                                        <DataGridTextColumn Header="Situation" Binding="{Binding Situation}"
                                                            IsReadOnly="True" Width="2*" MinWidth="150"
                                                            ElementStyle="{StaticResource CellTextStyle}"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ASignaler}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>

                                <TextBlock Text="{Binding DataContext.DecompteLibelle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,8"
                                           Foreground="{StaticResource InkMutedBrush}"/>

                                <Button Content="Reprendre ce décompte sur la fiche" HorizontalAlignment="Left" Margin="0,0,0,4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Recopie le décompte dans le nombre de charges qui commande la réduction d'IUTS. Rien n'est modifié sans ce geste."
                                        Visibility="{Binding DataContext.DecompteDiffere, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding DataContext.ReprendreDecompteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <TextBlock Text="RÉMUNÉRATION" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <!-- Alerte non-conformité salaire minimum conventionnel -->
                            <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3"
                                    Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding DataContext.EstNonConformeSalaireMinimum, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding DataContext.MessageConformiteSalaireMinimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextWrapping="Wrap" FontSize="11.5" Foreground="#B91C1C"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Salaire de base" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding BaseSalary, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="FCFA" Style="{StaticResource Hint}" Margin="8,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ind. logement" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding HousingAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxHousingAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ind. transport" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding TransportAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxTransportAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ind. fonction" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding FunctionAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxFunctionAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ind. sujétion" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding SujetionAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="FCFA" Style="{StaticResource Hint}" Margin="8,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Charges famille" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           HorizontalAlignment="Left" Width="64"
                                           Text="{Binding FamilyCharges, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Conjoint salarié" Style="{StaticResource FieldLabel}"/>
                                <CheckBox  Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                                           Style="{StaticResource FormCheckBoxStyle}"
                                           IsChecked="{Binding IsSpouseWorking, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Les plafonds de l'article 106 du CGI se recalculent sur le
                                 salaire de base saisi : l'excédent éventuel est réintégré
                                 dans la base imposable. -->
                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Padding="12,10" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="Les plafonds indiqués sont ceux de l'article 106 du CGI (20 % / 5 % / 5 % du salaire brut, dans la limite de 75 000, 30 000 et 50 000 FCFA). Tout dépassement est réintégré dans la base imposable."/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
