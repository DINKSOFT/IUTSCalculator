<UserControl x:Class="IUTSCalculator.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IUTSCalculator.Views"
             xmlns:vm="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:models="clr-namespace:IUTSCalculator.Models"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <!-- Libellé de la colonne de gauche des formulaires : une largeur unique,
             c'est ce qui fait que tous les champs s'alignent enfin. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Montant : aligné à droite, chiffres tabulaires. -->
        <Style x:Key="MoneyBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="FieldDate" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Employés" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding Employees.Count, Mode=OneWay}"/>
                    <Run Text="salariés  ·  total des salaires de base"/>
                    <Run Text="{Binding TotalSalaireBase, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                    <Run Text="FCFA"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Importer"
                        Tag="{StaticResource IconImport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ImportEmployeesCommand}"/>
                <Button Content="Nouveau salarié"
                        Tag="{StaticResource IconAdd}"
                        Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauSalarieCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Liste + fiche ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ───── Liste ───── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>

                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource SurfaceAltBrush}" Padding="14,8">
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding Employees.Count, Mode=OneWay}"/>
                                <Run Text="salariés"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="Total base"/>
                                <Run Text="{Binding TotalSalaireBase, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"
                                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <Run Text="FCFA"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0"
                              BorderThickness="0">
                        <!-- Sept colonnes ne tenaient pas dans la largeur disponible.
                             Or ce sont les colonnes en « * » qui se compriment quand la
                             place manque : le nom, le prénom et l'emploi étaient donc
                             écrasés les premiers. Nom et prénom sont désormais réunis en
                             une seule colonne, avec une largeur minimale qui l'empêche
                             d'être rognée, et les deux indemnités secondaires quittent la
                             liste — elles restent lisibles dans la fiche de droite, avec
                             leur plafond. -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nom et prénom" Width="2*" MinWidth="210"
                                                    SortMemberPath="LastName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="LastName"/>
                                                    <Binding Path="FirstName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Emploi" Binding="{Binding Fonction}"
                                                Width="*" MinWidth="130"
                                                ElementStyle="{StaticResource CellTextStyle}"/>

                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}"
                                                Width="Auto" MinWidth="110"
                                                ElementStyle="{StaticResource CellTextStyle}"/>

                            <DataGridTextColumn Header="Salaire de base"
                                                Binding="{Binding BaseSalary, StringFormat={}{0:N0}}"
                                                Width="120" MinWidth="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>

                            <DataGridTextColumn Header="Charges"
                                                Binding="{Binding FamilyCharges}"
                                                Width="80" MinWidth="70"
                                                ElementStyle="{StaticResource CenterTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ───── Fiche ───── -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DockPanel>

                    <!-- En-tête de la fiche -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <TextBlock Text="FICHE DU SALARIÉ" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nouveau salarié"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                <Setter Property="Text" Value="Modification"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Boutons, épinglés en bas -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <!-- Mode création -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="Ajouter" Width="150"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding AddEmployeeCommand}"/>
                                <Button Content="Effacer" Margin="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearNewEmployeeCommand}"/>
                            </StackPanel>

                            <!-- Mode modification -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstEnEdition}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="Enregistrer" Width="150"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Command="{Binding EditEmployeeCommand}"/>
                                <Button Content="Annuler"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding NouveauSalarieCommand}"/>
                                <Button Content="Supprimer" Margin="0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteEmployeeCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Champs -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                        <StackPanel DataContext="{Binding FicheCourante}">

                            <TextBlock Text="IDENTITÉ" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Prénom" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Emploi" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldBox}"
                                           Text="{Binding Fonction, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Catégorie" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.EmployeeCategories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Date d'entrée" Style="{StaticResource FieldLabel}"/>
                                <DatePicker Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding DateEntreeNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Situation" Style="{StaticResource FieldLabel}"/>
                                <ComboBox  Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource FieldCombo}"
                                           ItemsSource="{Binding DataContext.SituationsMatrimoniales, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           SelectedItem="{Binding SituationMatrimoniale, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,8,0,14"/>

                            <TextBlock Text="RÉMUNÉRATION" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Salaire de base" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding BaseSalary, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="FCFA" Style="{StaticResource Hint}" Margin="8,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ind. logement" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding HousingAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxHousingAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ind. transport" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding TransportAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxTransportAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ind. fonction" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding FunctionAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="8,0,0,8">
                                    <Run Text="plaf."/>
                                    <Run Text="{Binding MaxFunctionAllowance, Mode=OneWay, ConverterCulture=fr-FR, StringFormat={}{0:N0}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ind. sujétion" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           Text="{Binding SujetionAllowance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="FCFA" Style="{StaticResource Hint}" Margin="8,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Charges famille" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource MoneyBox}"
                                           HorizontalAlignment="Left" Width="64"
                                           Text="{Binding FamilyCharges, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Conjoint salarié" Style="{StaticResource FieldLabel}"/>
                                <CheckBox  Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                                           Style="{StaticResource FormCheckBoxStyle}"
                                           IsChecked="{Binding IsSpouseWorking, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Les plafonds de l'article 106 du CGI se recalculent sur le
                                 salaire de base saisi : l'excédent éventuel est réintégré
                                 dans la base imposable. -->
                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Padding="12,10" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="Les plafonds indiqués sont ceux de l'article 106 du CGI (20 % / 5 % / 5 % du salaire brut, dans la limite de 75 000, 30 000 et 50 000 FCFA). Tout dépassement est réintégré dans la base imposable."/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
