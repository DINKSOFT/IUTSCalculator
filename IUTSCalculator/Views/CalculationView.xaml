<UserControl x:Class="IUTSCalculator.Views.CalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IUTSCalculator.Views"
             xmlns:vm="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:converters="clr-namespace:IUTSCalculator.Converters" d:DataContext="{d:DesignInstance Type=vm:CalculationViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter" />
        <converters:BoolToTypeConverter x:Key="BoolToTypeConverter" />
        <converters:DecimalToStringConverter x:Key="DecimalToString" />
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,5" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="35" />
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="28" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Entête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Nouveau calcul" 
                    Command="{Binding CreateNewEmployeeCommand}" 
                    Style="{StaticResource ButtonStyle}"/>
            <Button Content="Charger employé" 
                    Command="{Binding LoadEmployeeCommand}" 
                    Style="{StaticResource ButtonStyle}"/>
            <Button Content="Effacer formulaire" 
                    Command="{Binding ClearFormCommand}" 
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Type de calcul -->
                <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Type de calcul" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Calcul mensuel" IsChecked="{Binding IsAnnual, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}" Margin="5"/>
                        <RadioButton Content="Calcul annuel" IsChecked="{Binding IsAnnual}" Margin="15,5,5,5"/>
                        <CheckBox Content="Régularisation" IsChecked="{Binding IsRegularization}" Margin="20,5,5,5"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRegularization, Converter={StaticResource BoolToTypeConverter}}">
                            <Label Content="Impôt déjà payé:" Style="{StaticResource LabelStyle}" />
                            <TextBox Width="120" Text="{Binding PreviousTaxPaid, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                            <Label Content="FCFA" Style="{StaticResource LabelStyle}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Informations employé -->
                <GroupBox Grid.Row="1" Grid.Column="0" Header="Informations de l'employé" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="ID:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEmployee.EmployeeId}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Nom:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEmployee.LastName}" Style="{StaticResource TextBoxStyle}" />

                        <Label Grid.Row="2" Grid.Column="0" Content="Prénom:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEmployee.FirstName }" Style="{StaticResource TextBoxStyle}" />

                        <Label Grid.Row="3" Grid.Column="0" Content="Catégorie:" Style="{StaticResource LabelStyle}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" 
                                  ItemsSource="{Binding EmployeeCategories}" 
                                  SelectedItem="{Binding CurrentEmployee.Category}" 
                                  Style="{StaticResource ComboBoxStyle}" />

                        <Label Grid.Row="4" Grid.Column="0" Content="Charges familiales:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentEmployee.FamilyCharges}" Style="{StaticResource TextBoxStyle}" />

                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Conjoint(e) salarié(e)" 
                                  IsChecked="{Binding CurrentEmployee.IsSpouseWorking}" 
                                  Style="{StaticResource CheckBoxStyle}" />
                    </Grid>
                </GroupBox>

                <!-- Rémunération -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="Rémunération" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Salaire de base:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEmployee.BaseSalary, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                        <Label Grid.Row="0" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Indemnité de logement:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEmployee.HousingAllowance, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                        <Label Grid.Row="1" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                        <Label Grid.Row="2" Grid.Column="0" Content="Indemnité de transport:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEmployee.TransportAllowance, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                        <Label Grid.Row="2" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                        <Label Grid.Row="3" Grid.Column="0" Content="Indemnité de fonction:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentEmployee.FunctionAllowance, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                        <Label Grid.Row="3" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                        <Label Grid.Row="4" Grid.Column="0" Content="Cotisation retraite:" Style="{StaticResource LabelStyle}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentEmployee.PensionContribution, StringFormat=N0}" Style="{StaticResource TextBoxStyle}" />
                        <Label Grid.Row="4" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />
                    </Grid>
                </GroupBox>

                <!-- Boutons de calcul -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="Calculer l'impôt" 
                            Command="{Binding CalculateTaxCommand}" 
                            Style="{StaticResource ButtonStyle}" 
                            Background="#2980b9" 
                            Foreground="White" />
                    <Button Content="Enregistrer le calcul" 
                            Command="{Binding SaveCalculationCommand}" 
                            Style="{StaticResource ButtonStyle}" 
                            Background="#27ae60" 
                            Foreground="White" 
                            Visibility="{Binding HasCalculation, Converter={StaticResource BoolToTypeConverter}}" />
                    <Button Content="Export Excel" 
                            Command="{Binding ExportExcelCommand}" 
                            Style="{StaticResource ButtonStyle}" 
                            Background="#f39c12" 
                            Foreground="White" 
                            Visibility="{Binding HasCalculation, Converter={StaticResource BoolToTypeConverter}}" />
                </StackPanel>

                <!-- Résultats du calcul -->
                <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="Résultats du calcul" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Résumé du calcul -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="5">
                            <TextBlock Text="{Binding ResultMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- Détails du calcul -->
                        <Grid Grid.Row="1" Grid.Column="0" Margin="5" Visibility="{Binding HasCalculation, Converter={StaticResource BoolToTypeConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Salaire brut:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCalculation.SalaireBrut, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />
                            <Label Grid.Row="0" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Montant exonéré:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCalculation.ExemptAmount, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />
                            <Label Grid.Row="1" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Revenu imposable:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCalculation.BaseIUTSHorsDeduction, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />
                            <Label Grid.Row="2" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                            <Label Grid.Row="3" Grid.Column="0" Content="Réduction familiale:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCalculation.FamilyChargeReduction, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />
                            <Label Grid.Row="3" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Montant de l'impôt:" Style="{StaticResource LabelStyle}" FontWeight="Bold" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCalculation.IUTSNet, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" FontWeight="Bold" Background="#f0f8ff" />
                            <Label Grid.Row="4" Grid.Column="2" Content="FCFA" Style="{StaticResource LabelStyle}" FontWeight="Bold" />

                            <Label Grid.Row="5" Grid.Column="0" Content="Taux d'imposition:" Style="{StaticResource LabelStyle}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCalculation.TaxRate, StringFormat=N2}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" />
                            <Label Grid.Row="5" Grid.Column="2" Content="%" Style="{StaticResource LabelStyle}" />

                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="{Binding IsRegularization, Converter={StaticResource BoolToTypeConverter}}">
                                <Label Content="Différence à payer/rembourser:" Style="{StaticResource LabelStyle}" FontWeight="Bold" />
                                <TextBox Width="120" Text="{Binding CurrentCalculation.TaxDifference, StringFormat=N0}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}" FontWeight="Bold" />
                                <Label Content="FCFA" Style="{StaticResource LabelStyle}" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>

                        <!-- Détails du calcul -->
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" 
                                 Text="{Binding CurrentCalculation.CalculationDetails}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Visibility="{Binding HasCalculation, Converter={StaticResource BoolToTypeConverter}}" 
                                 Padding="5" />
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- Pied de page -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#CCCCCC" Background="#F5F5F5">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <TextBlock Text="Statut: " VerticalAlignment="Center" />
                <TextBlock Text="{Binding IsBusy, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=text:En cours de traitement...;Prêt}" VerticalAlignment="Center" />

                <ProgressBar Width="100" Height="10" Margin="10,0" IsIndeterminate="{Binding IsBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>