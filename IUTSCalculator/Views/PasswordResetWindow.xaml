<Window x:Class="IUTSCalculator.Views.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réinitialisation du mot de passe"
        Height="350" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF8F8F8"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI">
    <Border CornerRadius="10" Background="White" Padding="24" Margin="12" BorderBrush="#FFCCCCCC" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Réinitialiser le mot de passe" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="Nom d'utilisateur" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" Height="28" Margin="0,0,0,10"/>
            <TextBlock Text="Nouveau mot de passe" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Height="28" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Foreground="Red" FontSize="12" Margin="0,0,0,8"/>
            <Button Style="{StaticResource MenuButtonStyle}" Content="Réinitialiser" Click="ResetButton_Click"/>
                    <!--Height="32"
                    Background="#FF0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    CornerRadius="6"-->
                    
        </StackPanel>
    </Border>
</Window>