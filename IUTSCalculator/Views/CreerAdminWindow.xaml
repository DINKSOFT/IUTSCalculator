<Window x:Class="IUTSCalculator.Views.CreerAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Création du compte administrateur"
        Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource GrayLightBrush}"
        FontFamily="Segoe UI">
    <Border CornerRadius="10" Background="White" Padding="28" Margin="16"
            BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Premier démarrage" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBlueDarkerBrush}"/>
            <TextBlock Text="Aucun utilisateur n'existe encore. Créez le compte administrateur : il pourra ensuite créer les autres comptes."
                       FontSize="12" Foreground="{StaticResource GrayDarkBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>

            <TextBlock Text="Nom affiché" Margin="0,0,0,4" Foreground="{StaticResource InkBrush}"/>
            <TextBox x:Name="NomAffiche" Height="32" Padding="8" Margin="0,0,0,12"
                     BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>

            <TextBlock Text="Identifiant de connexion" Margin="0,0,0,4" Foreground="{StaticResource InkBrush}"/>
            <TextBox x:Name="Identifiant" Height="32" Padding="8" Margin="0,0,0,12"
                     BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>

            <TextBlock Text="Mot de passe (6 caractères minimum)" Margin="0,0,0,4" Foreground="{StaticResource InkBrush}"/>
            <PasswordBox x:Name="MotDePasse" Height="32" Padding="8" Margin="0,0,0,12"
                         BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>

            <TextBlock Text="Confirmer le mot de passe" Margin="0,0,0,4" Foreground="{StaticResource InkBrush}"/>
            <PasswordBox x:Name="Confirmation" Height="32" Padding="8" Margin="0,0,0,10"
                         BorderBrush="{StaticResource GrayMediumBrush}" BorderThickness="1"/>

            <TextBlock x:Name="MessageEtat" Foreground="{StaticResource RedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Button x:Name="BoutonCreer" Content="Créer le compte administrateur"
                    Style="{StaticResource MenuButtonStyle}" Height="38" Click="Creer_Click"/>
            <Button Content="Quitter" Style="{StaticResource SecondaryButtonStyle}" Height="32"
                    Margin="0,8,0,0" Click="Quitter_Click"/>
        </StackPanel>
    </Border>
</Window>
