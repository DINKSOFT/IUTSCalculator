<UserControl x:Class="IUTSCalculator.Views.BaseSalaryEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:converters="clr-namespace:IUTSCalculator.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:BaseSalaryEstimatorViewModel}"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,10"/>
        </Style>
        <!-- Ligne de résultat : libellé à gauche, montant tabulaire à droite. -->
        <Style x:Key="ResultLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="ResultValue" TargetType="TextBlock" BasedOn="{StaticResource MoneyTextStyle}">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Estimation du salaire de base" Style="{StaticResource ScreenTitleStyle}"/>
            <TextBlock Text="Retrouve le salaire de base — et les indemnités qui l'accompagnent — produisant le net à payer visé"
                       FontSize="12" Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───── Hypothèses ─────
                 L'écran proposait aussi trois champs « Indemnité logement / transport /
                 fonction ». Ils étaient liés à des propriétés qui n'existent pas sur le
                 ViewModel : ils restaient vides et ne servaient à rien. Ces indemnités
                 sont en réalité CALCULÉES par l'estimateur — elles figurent donc
                 désormais du côté des résultats. -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="HYPOTHÈSES" Style="{StaticResource SectionLabelStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Salaire net souhaité" Style="{StaticResource FieldLabel}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextAlignment="Right"
                                   Style="{StaticResource FormTextBoxStyle}"
                                   Text="{Binding NetSalary, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="FCFA" Style="{StaticResource Unit}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Catégorie" Style="{StaticResource FieldLabel}"/>
                        <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                                   Style="{StaticResource FormComboBoxStyle}"
                                   IsEditable="True"
                                   ItemsSource="{Binding EmployeeCategories}"
                                   Text="{Binding Category, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Charges familiales" Style="{StaticResource FieldLabel}"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="72"
                                   Margin="0,0,0,10" TextAlignment="Right"
                                   Style="{StaticResource FormTextBoxStyle}"
                                   Text="{Binding FamilyCharges, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="Conjoint(e) salarié(e)" Margin="0"
                                  Style="{StaticResource FormCheckBoxStyle}"
                                  IsChecked="{Binding IsSpouseWorking, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Estimer" Tag="{StaticResource IconEstimate}"
                                Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding EstimateCommand}"/>
                        <Button Content="Export Excel" Tag="{StaticResource IconExcel}" Margin="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>

                    <!-- Reprend le résultat dans une fiche de création : actif seulement
                         après une estimation réussie (et pour un compte autorisé à saisir). -->
                    <Button Content="Créer la fiche employé" Tag="{StaticResource IconEmploye}"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Ouvre une nouvelle fiche employé pré-remplie avec la catégorie, les charges, le salaire de base et les indemnités estimés"
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding CreerFicheEmployeCommand}"/>
                </StackPanel>
            </Border>

            <!-- ───── Résultat ───── -->
            <Border Grid.Column="2" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Padding" Value="0"/>
                        <Style.Triggers>
                            <!-- Tant qu'aucune estimation n'a été lancée, le panneau ne
                                 prend pas la place pour rien. -->
                            <DataTrigger Binding="{Binding Result}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Result}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="RÉSULTAT DE L'ESTIMATION" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <!-- Le salaire de base est la réponse à la question posée : il se lit
                         sans avoir à le chercher. -->
                    <Border Background="{StaticResource AccentTintBrush}" Padding="16,14">
                        <Grid>
                            <TextBlock Text="SALAIRE DE BASE" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentDarkBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding EstimatedBaseSalary, StringFormat=N0}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="FCFA" FontSize="12" Margin="7,0,0,3"
                                           Foreground="{StaticResource InkSubtleBrush}" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Indemnité de logement" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ResultValue}"
                                   Text="{Binding EstimatedHousing, StringFormat=N0}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="FCFA" Style="{StaticResource Unit}" Margin="8,0,0,9"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Indemnité de transport" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ResultValue}"
                                   Text="{Binding EstimatedTransport, StringFormat=N0}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="FCFA" Style="{StaticResource Unit}" Margin="8,0,0,9"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Indemnité de fonction" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ResultValue}"
                                   Text="{Binding EstimatedFunction, StringFormat=N0}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="FCFA" Style="{StaticResource Unit}" Margin="8,0,0,9"/>

                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                Height="1" Background="{StaticResource RuleBrush}" Margin="0,2,0,11"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="IUTS mensuel" Style="{StaticResource ResultLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ResultValue}"
                                   FontWeight="SemiBold"
                                   Text="{Binding EstimatedIUTS, StringFormat=N0}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="FCFA" Style="{StaticResource Unit}" Margin="8,0,0,9"/>
                    </Grid>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource InkSubtleBrush}"
                                   Text="Le salaire de base estimé ne tient pas compte de la réduction pour charges familiales : elle est appliquée ensuite, au calcul du bulletin. Un salarié ayant des charges perçoit donc un net légèrement supérieur au net visé."/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Pied ═══════════ -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}"
                Margin="0,14,0,0" Padding="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
