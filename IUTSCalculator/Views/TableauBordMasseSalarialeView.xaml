<UserControl x:Class="IUTSCalculator.Views.TableauBordMasseSalarialeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:TableauBordMasseSalarialeViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TotalBadgeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="TotalBadgeValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="VentilationLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VentilationValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Tableau de bord masse salariale" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock Text="Évolution mensuelle du brut, du net et du coût employeur, par service et par catégorie — alimenté par les mois clôturés"
                           FontSize="12" Foreground="{StaticResource InkSubtleBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Exporter vers Excel" Tag="{StaticResource IconExcel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterCommand}"/>
                <Button Content="Générer le tableau de bord" Tag="{StaticResource IconCalculator}" Margin="0"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding GenererCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Paramètres ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Année -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="110" HorizontalAlignment="Left"
                              Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding AnneesDisponibles}"
                              SelectedItem="{Binding Annee}"/>
                </StackPanel>

                <!-- Période / Statut -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PeriodeChoisieLibelle}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Évolution issue des périodes clôturées"
                               FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Résultat ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <!-- En-tête de la carte -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TABLEAU DE BORD"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                    Visibility="{Binding EstPartiel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="ANNÉE PARTIELLE (TOUS LES MOIS NE SONT PAS CLÔTURÉS)" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ATableau, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Tableau.MoisClotures.Count, StringFormat='Mois clôturés : {0}/12'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="|" Foreground="{StaticResource RuleStrongBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Coût employeur cumulé : " FontSize="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Tableau.TotalCoutEmployeur, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FCFA" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bandeau de totaux -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource SurfaceAltBrush}"
                        Padding="16,10"
                        Visibility="{Binding ATableau, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL BRUT" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding Tableau.TotalBrut, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TOTAL NET À PAYER" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding Tableau.TotalNet, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TOTAL COÛT EMPLOYEUR" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding Tableau.TotalCoutEmployeur, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                        <Border Grid.Column="5" Width="1" Background="{StaticResource RuleBrush}" Margin="8,2"/>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="MOYENNE MENSUELLE (COÛT EMPLOYEUR)" Style="{StaticResource TotalBadgeLabel}"/>
                            <TextBlock Text="{Binding Tableau.MoyenneMensuelleCoutEmployeur, Converter={StaticResource MontantConverter}, Mode=OneWay}"
                                       Style="{StaticResource TotalBadgeValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- État vide -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding ATableau, Converter={StaticResource BoolToTypeConverter}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource RuleStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucun tableau de bord généré" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Choisissez l'année, puis cliquez sur « Générer le tableau de bord » — seuls les mois clôturés (écran « Périodes de paie ») alimentent l'évolution."
                               FontSize="12" Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                </StackPanel>

                <!-- Contenu scrollable : évolution + ventilations -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ATableau, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="16">

                        <!-- ── Évolution mensuelle ─────────────────────────────── -->
                        <TextBlock Text="ÉVOLUTION MENSUELLE" Style="{StaticResource SectionLabelStyle}"
                                   Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource AccentBrush2}" Margin="0,0,4,0"/>
                            <TextBlock Text="Brut" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,14,0"/>
                            <Rectangle Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="Net à payer" FontSize="11" Foreground="{StaticResource InkSubtleBrush}" Margin="0,0,14,0"/>
                            <Rectangle Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="Coût employeur" FontSize="11" Foreground="{StaticResource InkSubtleBrush}"/>
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12,16,12,8" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding Evolution}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="64" Margin="2,0">
                                            <Grid Height="140" VerticalAlignment="Bottom"
                                                  ToolTip="{Binding Designation}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Rectangle Width="14" Height="{Binding HauteurBrutPx}"
                                                               Fill="{StaticResource AccentBrush2}" Margin="1,0"
                                                               VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Width="14" Height="{Binding HauteurNetPx}"
                                                               Fill="{StaticResource SuccessBrush}" Margin="1,0"
                                                               VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Width="14" Height="{Binding HauteurCoutEmployeurPx}"
                                                               Fill="{StaticResource WarningBrush}" Margin="1,0"
                                                               VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Designation}" FontSize="10"
                                                       Foreground="{StaticResource InkSubtleBrush}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- ── Ventilation par catégorie ───────────────────────── -->
                        <TextBlock Text="RÉPARTITION PAR CATÉGORIE" Style="{StaticResource SectionLabelStyle}"
                                   Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding ParCategorie}" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Cle}"
                                                   Style="{StaticResource VentilationLabelStyle}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource VentilationValueStyle}">
                                            <Run Text="{Binding CoutEmployeur, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                                            <Run Text=" FCFA" FontWeight="Normal" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding NombreBulletins, StringFormat='{}{0} b.'}"
                                                   FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                Background="{StaticResource RuleFaintBrush}" Height="8" CornerRadius="4"
                                                Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                            <Border Background="{StaticResource AccentBrush2}" Height="8" CornerRadius="4"
                                                    HorizontalAlignment="Left" Width="{Binding LargeurBarrePx}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── Ventilation par service ─────────────────────────── -->
                        <TextBlock Text="RÉPARTITION PAR SERVICE" Style="{StaticResource SectionLabelStyle}"
                                   Foreground="{StaticResource AccentBrush2}" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding ParService}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Cle}"
                                                   Style="{StaticResource VentilationLabelStyle}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource VentilationValueStyle}">
                                            <Run Text="{Binding CoutEmployeur, Converter={StaticResource MontantConverter}, Mode=OneWay}"/>
                                            <Run Text=" FCFA" FontWeight="Normal" FontSize="10" Foreground="{StaticResource InkSubtleBrush}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding NombreBulletins, StringFormat='{}{0} b.'}"
                                                   FontSize="11" Foreground="{StaticResource InkSubtleBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                Background="{StaticResource RuleFaintBrush}" Height="8" CornerRadius="4"
                                                Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                            <Border Background="{StaticResource WarningBrush}" Height="8" CornerRadius="4"
                                                    HorizontalAlignment="Left" Width="{Binding LargeurBarrePx}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════ Anomalies et barre d'état ═══════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Padding="12,10" Margin="0,0,0,10"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding ADesAnomalies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="AVERTISSEMENTS ET POINTS D'ATTENTION" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Anomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
