<UserControl x:Class="IUTSCalculator.Views.ProfilPaieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProfilPaieViewModel}"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <!--
        Deux contraintes ont dicté cette disposition.

        HAUTEUR. Chaque carte est une grille à lignes explicites : « Auto » pour les
        en-têtes et les formulaires, « * » pour le tableau. Un DockPanel servait d'abord
        ses enfants ancrés et ne laissait au tableau que le reste — c'est-à-dire rien.
        La bande de portée a perdu son cadre et tient sur une ligne : les cent pixels
        qu'elle prenait manquaient en bas de l'écran, où les boutons se trouvaient coupés.

        LARGEUR. GridCellStyle pose 10 px de marge de chaque côté : une colonne déclarée
        à 70 px n'affiche que 50 px de texte, et « Retenue » y devient « Reten… ». Toutes
        les largeurs ci-dessous comptent donc ces 20 px, et les colonnes secondaires ont
        été retirées au profit de l'info-bulle de ligne.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Profils de paie" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding NombreProfils, Mode=OneWay}"/>
                    <Run Text="profil(s) — un salarié rattaché reçoit les rubriques de son profil sans ressaisie"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Recharger" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ChargerCommand}"/>
                <Button Content="Nouveau profil" Tag="{StaticResource IconAdd}" Margin="0" Width="170"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Portée d'une modification, sur une ligne ═══════════ -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="14,7" CornerRadius="3"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                ToolTip="Le profil est un lien vivant : il alimente le bulletin à chaque calcul. Une rubrique saisie dans les variables du mois l'emporte sur celle du profil.">
            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource InkMutedBrush}">
                <Run Text="{Binding PorteeLibelle, Mode=OneWay}"/>
                <Run Text="Lien vivant : le profil alimente le bulletin à chaque calcul, et la variable du mois l'emporte sur lui."
                     Foreground="{StaticResource InkSubtleBrush}"/>
            </TextBlock>
        </Border>

        <!-- ═══════════ Profils, rubriques et rattachements ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.1*" MinWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- ───────── Colonne gauche : profils du dossier ───────── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <TextBlock Text="PROFILS DU DOSSIER" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                    </Border>

                    <!-- ═══════════ Barre de recherche et filtres profils ═══════════ -->
                    <Border Grid.Row="1" Background="#F8FAFC"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche textuelle -->
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="32" Padding="28,4,26,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Rechercher par code ou libellé du profil..."/>
                                <TextBlock Text="{StaticResource IconSearch}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource InkSubtleBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Width="20" Height="20"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Effacer la recherche"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource InkSubtleBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Filtre Population -->
                            <ComboBox Grid.Column="2" Height="32" Margin="0"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding PopulationFiltreOptions}"
                                      SelectedValue="{Binding SelectedPopulationFilter, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      ToolTip="Filtrer par population"/>

                            <!-- Réinitialiser -->
                            <Button Grid.Column="3" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                                    MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Réinitialiser les filtres"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Compteur de profils -->
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombreProfilsAffiches, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding NombreProfils, Mode=OneWay}"/>
                                <Run Text="profil(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ProfilsView}"
                              SelectedItem="{Binding ProfilSelectionne, Mode=TwoWay}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <!-- Population et état actif tiennent dans l'info-bulle : les
                                 mettre en colonnes volait la place du libellé. -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                <Setter Property="ToolTip" Value="{Binding PopulationLibelle}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}"
                                                Width="100"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle, Mode=OneWay}"
                                                Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Population" Binding="{Binding PopulationLibelle, Mode=OneWay}"
                                                Width="130"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Rubr." Binding="{Binding NombreLignes, Mode=OneWay}"
                                                Width="66"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Sal." Binding="{Binding NombreSalaries, Mode=OneWay}"
                                                Width="62"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Formulaire, ouvert seulement quand un profil est en cours -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10"
                            Visibility="{Binding EditionOuverte, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Code" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <TextBox Margin="0,0,0,8"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         ToolTip="Code court et unique, en majuscules (CADRE, JOURNALIER…)."
                                         Text="{Binding ProfilEnCours.Code, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Population" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox Height="32" Margin="0,0,0,8"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding Populations}"
                                          DisplayMemberPath="Libelle"
                                          SelectedItem="{Binding PopulationSelectionnee, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Libellé" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <TextBox Margin="0,0,0,8"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding ProfilEnCours.Libelle, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Description" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                <TextBox Margin="0,0,0,8"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding ProfilEnCours.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Case à cocher et boutons sur la même ligne : c'est la
                                 ligne qu'on perdait sous le bord de la fenêtre. -->
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <CheckBox Content="Profil actif" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          ToolTip="Un profil inactif n'est plus proposé au rattachement, mais continue d'alimenter les salariés qui le portent déjà."
                                          IsChecked="{Binding ProfilEnCours.Actif, Mode=TwoWay}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                            MinWidth="0" Padding="10,0"
                                            Style="{StaticResource MenuButtonStyle}"
                                            Command="{Binding EnregistrerCommand}"/>
                                    <Button Content="Annuler" MinWidth="0" Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AnnulerSaisieCommand}"/>
                                    <Button Content="Supprimer" Margin="0" MinWidth="0" Padding="10,0"
                                            Style="{StaticResource DangerButtonStyle}"
                                            ToolTip="Possible tant qu'aucun salarié n'a été rattaché. Sinon, décochez « Profil actif »."
                                            Command="{Binding SupprimerCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ───────── Colonne droite : rubriques et rattachements ───────── -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <Grid>
                            <TextBlock Text="RUBRIQUES DU PROFIL" HorizontalAlignment="Left"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="{Binding NombreLignes, Mode=OneWay}"/>
                                <Run Text="rubrique(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- La barre d'ajout est au-dessus du tableau qu'elle alimente. -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Height="32" Margin="0" VerticalAlignment="Bottom"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding RubriquesDisponibles}"
                                      DisplayMemberPath="Designation"
                                      ToolTip="Rubrique à ajouter. Seules les rubriques saisissables du plan de paie sont proposées : le salaire de base, les indemnités plafonnées, la CNSS et l'IUTS sont lus par le moteur sur la fiche du salarié."
                                      SelectedItem="{Binding RubriqueAAjouter, Mode=TwoWay}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Ajouter" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AjouterRubriqueCommand}"/>
                                <Button Content="Retirer" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RetirerRubriqueCommand}"/>
                                <Button Content="Enregistrer" Tag="{StaticResource IconSave}"
                                        Margin="0" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource MenuButtonStyle}"
                                        ToolTip="Enregistre les rubriques de ce profil. Les salariés rattachés en héritent au prochain calcul."
                                        Command="{Binding EnregistrerRubriquesCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Le montant et la quantité se saisissent ici : ce sont de vraies
                         propriétés du modèle, donc liables en TwoWay. Les colonnes
                         calculées restent en OneWay, sans quoi WPF lève « liaison TwoWay
                         sur une propriété en lecture seule » dès l'affichage. -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Lignes}"
                              SelectedItem="{Binding LigneSelectionnee, Mode=TwoWay}"
                              Style="{StaticResource FormDataGridStyle}"
                              Margin="0" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <!-- D'où viendra le montant : en info-bulle plutôt qu'en
                                 colonne, qui mangeait la place du libellé de rubrique. -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
                                <Setter Property="ToolTip" Value="{Binding ValorisationLibelle}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rubrique" Binding="{Binding Designation, Mode=OneWay}"
                                                Width="*" MinWidth="150" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Sens" Binding="{Binding SensLibelle, Mode=OneWay}"
                                                Width="92" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="Montant"
                                                Binding="{Binding Montant, StringFormat=N0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridTextColumn Header="Qté"
                                                Binding="{Binding Quantite, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="82"
                                                ElementStyle="{StaticResource MoneyTextStyle}"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active, Mode=TwoWay}"
                                                    Width="66"
                                                    HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Ce qui mérite un coup d'œil. Plafonné et défilant : trois
                         avertissements ne doivent pas pousser les rattachements hors
                         de l'écran. -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Background="{StaticResource WarningTintBrush}"
                            CornerRadius="3" Margin="10,8" Padding="10,7"
                            Visibility="{Binding ADesAvertissements, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="À VÉRIFIER" Style="{StaticResource SectionLabelStyle}"
                                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Avertissements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Rattachement des salariés -->
                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*" MinWidth="100"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Rattacher le salarié" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <!-- Recherche rapide du salarié pour entreprises à fort effectif -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBox Text="{Binding FiltreSalarie, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Height="28" Padding="24,2,22,2" Margin="0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Filtrer par nom, prénom, matricule ou emploi..."/>
                                        <TextBlock Text="{StaticResource IconSearch}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource InkSubtleBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" IsHitTestVisible="False"/>
                                        <Button Command="{Binding ClearFiltreSalarieCommand}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,4,0" Width="16" Height="16"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Effacer la recherche"
                                                Visibility="{Binding HasFiltreSalarie, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource InkSubtleBrush}"/>
                                        </Button>
                                    </Grid>
                                    <ComboBox Height="32" Margin="0,0,0,6"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              ItemsSource="{Binding SalariesFiltres}"
                                              SelectedItem="{Binding SalarieAAffecter, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding LastName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding FirstName, Mode=OneWay}"/>
                                                    <Run Text="·" Foreground="{StaticResource InkSubtleBrush}"/>
                                                    <Run Text="{Binding Matricule, Mode=OneWay}" Foreground="{StaticResource InkSubtleBrush}" FontSize="11"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Motif" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox Margin="0,0,0,6"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             ToolTip="Embauche, promotion, fin de stage… Conservé dans l'historique."
                                             Text="{Binding MotifAffectation, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="À partir du" Style="{StaticResource FormTextBlockLabelStyle}" Margin="0,0,0,2"/>
                                    <DatePicker Width="128" Margin="0,0,0,6"
                                                Style="{StaticResource FormDatePickerStyle}"
                                                ToolTip="Les bulletins antérieurs à cette date gardent le profil qui les a calculés."
                                                SelectedDate="{Binding DateEffet, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Rattacher" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource MenuButtonStyle}"
                                        ToolTip="Rattache le salarié au profil sélectionné à gauche, à partir de la date indiquée."
                                        Command="{Binding AffecterCommand}"/>
                                <Button Content="Retirer le profil" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Le salarié n'a plus de profil à partir de cette date. Le retrait est daté et conservé."
                                        Command="{Binding RetirerProfilCommand}"/>
                                <Button Content="Effacer la ligne" Margin="0" MinWidth="0" Padding="10,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        ToolTip="Retire la ligne sélectionnée de l'historique. À réserver aux saisies erronées."
                                        Command="{Binding SupprimerAffectationCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Affectations}"
                                      SelectedItem="{Binding AffectationSelectionnee, Mode=TwoWay}"
                                      Style="{StaticResource FormDataGridStyle}"
                                      Margin="0" BorderThickness="0" MinHeight="70" MaxHeight="102"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Salarié" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                        Width="*" MinWidth="110"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Profil" Binding="{Binding ProfilLibelle, Mode=OneWay}"
                                                        Width="*" MinWidth="110"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Depuis" Binding="{Binding DateEffetLibelle, Mode=OneWay}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource CellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Barre d'état ═══════════ -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource RuleBrush}" Padding="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkSubtleBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
