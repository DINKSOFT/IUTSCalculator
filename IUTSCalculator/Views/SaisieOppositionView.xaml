<UserControl x:Class="IUTSCalculator.Views.SaisieOppositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:IUTSCalculator.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=viewmodels:SaisieOppositionViewModel}"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormTextBlockLabelStyle}"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="360"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ En-tête d'écran ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Saisies-arrêts, cessions et oppositions" Style="{StaticResource ScreenTitleStyle}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkSubtleBrush}" TextTrimming="CharacterEllipsis"
                           ToolTip="Contentieux de la paie, hiérarchie des créances et barème progressif burkinabè (Art. 122+ Loi 028-2008 &amp; OHADA AUPSRVE)">
                    <Run Text="Contentieux de la paie, hiérarchie des créances et barème burkinabè (Art. 122+ Loi 028-2008 &amp; OHADA)"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Actualiser" Tag="{StaticResource IconRefresh}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ActualiserCommand}" Margin="0,0,8,0"/>
                <ComboBox Width="150" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                          Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding MoisBordereauOptions}" DisplayMemberPath="Libelle"
                          SelectedItem="{Binding MoisBordereau}"
                          ToolTip="Mois de paie du bordereau de reversement"/>
                <Button Content="Bordereau mensuel" Tag="{StaticResource IconExport}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterBordereauCommand}" Margin="0,0,8,0"
                        ToolTip="Exporter le bordereau de reversement pour le tribunal et les créanciers (Excel)"/>
                <Button Content="Registre général" Tag="{StaticResource IconFile}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ExporterRegistreCommand}" Margin="0,0,8,0"
                        ToolTip="Exporter l'état exhaustif des créances et soldes restants (Excel)"/>
                <Button Content="Nouveau dossier" Tag="{StaticResource IconAdd}" Margin="0" Width="175"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding NouveauCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Barre de recherche et filtres ═══════════ -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8" CornerRadius="4"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche textuelle -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Height="32" Padding="28,4,26,4"
                             VerticalContentAlignment="Center"
                             ToolTip="Rechercher par travailleur, matricule, créancier, dossier, tribunal..."/>
                    <TextBlock Text="{StaticResource IconSearch}"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource InkSubtleBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <Button Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0" Width="20" Height="20"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Effacer la recherche"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource InkSubtleBrush}"/>
                    </Button>
                </Grid>

                <!-- Filtre Nature / Type -->
                <ComboBox Grid.Column="2" Height="32" Margin="0"
                          Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding TypesSaisieFiltreOptions}"
                          SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          ToolTip="Filtrer par nature légale de la saisie"/>

                <!-- Filtre Statut / État -->
                <ComboBox Grid.Column="4" Height="32" Margin="0"
                          Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding StatutsSaisieFiltreOptions}"
                          SelectedValue="{Binding SelectedStatutFilter, Mode=TwoWay}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          ToolTip="Filtrer par statut"/>

                <!-- Réinitialiser -->
                <Button Grid.Column="5" Content="Effacer filtres" Tag="{StaticResource IconClear}"
                        MinWidth="0" Padding="10,0" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Réinitialiser les filtres"
                        Command="{Binding ResetFiltersCommand}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Compteur -->
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="11" Foreground="{StaticResource InkSubtleBrush}">
                    <Run Text="{Binding NombreSaisiesAffichees, Mode=OneWay}"/>
                    <Run Text="dossier(s) listé(s)"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════ Corps principal : Deux Colonnes ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="560"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne Gauche : Tableau des Saisies + Onglets Échéancier / Simulateur -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="235"/>
                </Grid.RowDefinitions>

                <!-- Registre des dossiers -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="DOSSIERS EN COURS ET TITRES EXÉCUTOIRES"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SaisiesView}"
                                  SelectedItem="{Binding SelectedSaisie, Mode=TwoWay}"
                                  Style="{StaticResource FormDataGridStyle}"
                                  Margin="0" BorderThickness="0"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Travailleur" Binding="{Binding NomSalarie, Mode=OneWay}"
                                                    Width="*" MinWidth="130"
                                                    ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Créancier" Binding="{Binding Creancier, Mode=OneWay}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Nature" Binding="{Binding TypeLibelle, Mode=OneWay}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource CellTextStyle}"/>
                                <DataGridTextColumn Header="Total Dû"
                                                    Binding="{Binding MontantTotalDu, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="100"
                                                    ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Retenue/Mois"
                                                    Binding="{Binding RetenueMensuelleFixee, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="105"
                                                    ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Amorti"
                                                    Binding="{Binding TotalAmorti, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="95"
                                                    ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Reste Dû"
                                                    Binding="{Binding SoldeRestantDu, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                    Width="100"
                                                    ElementStyle="{StaticResource MoneyTextStyle}"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle, Mode=OneWay}"
                                                    Width="90"
                                                    ElementStyle="{StaticResource CellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Séparateur horizontal -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeNS"/>

                <!-- Onglets inférieurs : Échéancier / Simulateur légal -->
                <TabControl Grid.Row="2" Margin="0,4,0,0">
                    <!-- Onglet 1 : Historique des retenues -->
                    <TabItem Header="Prélèvements effectués sur paie">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0" BorderThickness="0">
                            <DataGrid ItemsSource="{Binding HistoriqueRetenues}"
                                      Style="{StaticResource FormDataGridStyle}"
                                      Margin="0" BorderThickness="0"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Période"
                                                        Binding="{Binding DatePrelevement, StringFormat=MM/yyyy, Mode=OneWay}"
                                                        Width="75" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Montant Retenu"
                                                        Binding="{Binding MontantRetenu, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                        Width="105" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    <DataGridTextColumn Header="Assiette Net"
                                                        Binding="{Binding BaseNetCalcul, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                        Width="95" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    <DataGridTextColumn Header="Quotité Disp."
                                                        Binding="{Binding QuotiteDisponible, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                        Width="95" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    <DataGridTextColumn Header="Règlement"
                                                        Binding="{Binding NumeroChequeOuVirement, Mode=OneWay}"
                                                        Width="100" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Statut"
                                                        Binding="{Binding StatutPaiement, Mode=OneWay}"
                                                        Width="80" ElementStyle="{StaticResource CellTextStyle}"/>
                                    <DataGridTextColumn Header="Détail répartition"
                                                        Binding="{Binding Commentaire, Mode=OneWay}"
                                                        Width="*" MinWidth="140" ElementStyle="{StaticResource CellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- Onglet 2 : Simulateur légal de la quotité et répartition -->
                    <TabItem Header="Barème légal &amp; Simulateur de quotité">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Zone de test du simulateur -->
                                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        Padding="10,6" Margin="0,0,0,6" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Net de référence :"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" Height="28"
                                                 Text="{Binding SimulateurNetReference, UpdateSourceTrigger=PropertyChanged, StringFormat=N0, ConverterCulture=fr-FR}"
                                                 Style="{StaticResource FormTextBoxStyle}"/>

                                        <TextBlock Grid.Column="2" Text="FCFA" VerticalAlignment="Center" Margin="6,0,12,0"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource AccentTintBrush}" Padding="8,4" CornerRadius="3" Margin="0,0,6,0">
                                                <TextBlock FontSize="11">
                                                    <Run Text="Quotité légale :" FontWeight="Bold"/>
                                                    <Run Text="{Binding SimulateurQuotiteLegale, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold"/>
                                                    <Run Text="FCFA"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#F1F5F9" Padding="8,4" CornerRadius="3">
                                                <TextBlock FontSize="11">
                                                    <Run Text="Minimum vital protégé :" FontWeight="Bold"/>
                                                    <Run Text="{Binding SimulateurFractionInsaisissable, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"/>
                                                    <Run Text="FCFA"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Détail des 7 tranches -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SimulateurTranches}"
                                          Style="{StaticResource FormDataGridStyle}"
                                          Margin="0" BorderThickness="1" RowHeight="23"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tranche" Binding="{Binding LibelleTranche, Mode=OneWay}"
                                                            Width="185" ElementStyle="{StaticResource CellTextStyle}"/>
                                        <DataGridTextColumn Header="Fraction légale" Binding="{Binding RatioAffichage, Mode=OneWay}"
                                                            Width="105" ElementStyle="{StaticResource CellTextStyle}"/>
                                        <DataGridTextColumn Header="Assiette tranche"
                                                            Binding="{Binding AssietteTranche, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                            Width="110" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                        <DataGridTextColumn Header="Saisissable"
                                                            Binding="{Binding MontantSaisissableTranche, StringFormat=N0, ConverterCulture=fr-FR, Mode=OneWay}"
                                                            Width="110" ElementStyle="{StaticResource MoneyTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Colonne Droite : Formulaire & Détail du Dossier -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête de la fiche -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <TextBlock Text="FICHE DU DOSSIER DE SAISIE / CESSION"
                                       Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold"
                                       Text="{Binding SelectedSaisie.StatutLibelle, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <!-- Contenu du formulaire -->
                    <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,8">
                        <StackPanel>
                            <!-- Travailleur concerné -->
                            <TextBlock Text="Travailleur débiteur *" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding SalariesFiltres}"
                                      SelectedItem="{Binding FormEmployee, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEditing}"
                                      Height="32" Style="{StaticResource FormComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding LastName, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="{Binding FirstName, Mode=OneWay}"/>
                                            <Run Text="(" Foreground="{StaticResource InkSubtleBrush}"/>
                                            <Run Text="{Binding EmployeeId, Mode=OneWay}" Foreground="{StaticResource InkSubtleBrush}"/>
                                            <Run Text=")" Foreground="{StaticResource InkSubtleBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Type de créance / Titre -->
                            <TextBlock Text="Nature légale &amp; privilège *" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding TypesSaisieFiltreOptions}"
                                      SelectedValue="{Binding FormTypeSaisie, Mode=TwoWay}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      IsEnabled="{Binding IsEditing}"
                                      Height="32" Style="{StaticResource FormComboBoxStyle}"/>

                            <!-- Notification pension alimentaire -->
                            <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="3"
                                    Background="{StaticResource AccentTintBrush}"
                                    Visibility="{Binding EstPensionAlimentaire, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="Super-privilège légal :"/>
                                    <Run Text="La pension alimentaire s'impute en priorité absolue et peut mordre sur la fraction insaisissable ordinaire au-delà du SMIG (45 000 FCFA)."/>
                                </TextBlock>
                            </Border>

                            <!-- Créancier et Bénéficiaire -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Créancier saisissant *" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormCreancier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bénéficiaire / Enfant" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormBeneficiaire, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Montants : Total Dû & Retenue Mensuelle -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Montant total dû (FCFA)" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"
                                               ToolTip="0 si créance continue à terme indéterminé (ex: pension alimentaire)"/>
                                    <TextBox Text="{Binding FormMontantTotalDu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0, ConverterCulture=fr-FR}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Retenue mensuelle (FCFA) *" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormRetenueMensuelleFixee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0, ConverterCulture=fr-FR}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dates & Juridiction -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="N° Dossier / Greffe" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormNumeroDossier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tribunal / Autorité" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormTribunalOuAutorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date d'effet / Début" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding FormDateDebut, Mode=TwoWay}"
                                                IsEnabled="{Binding IsEditing}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Réf. Jugement / Titre" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FormReferenceJugement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditing}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Commentaire -->
                            <TextBlock Text="Observations &amp; références" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding FormCommentaire, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsEditing}"
                                     Height="46" TextWrapping="Wrap" AcceptsReturn="True"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Barre d'actions du formulaire -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <Grid>
                            <!-- Boutons en mode édition -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Content="Annuler" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="0" Padding="12,4"
                                        Command="{Binding AnnulerCommand}" Margin="0,0,8,0"/>
                                <Button Content="Enregistrer" Style="{StaticResource MenuButtonStyle}"
                                        MinWidth="0" Padding="14,4"
                                        Command="{Binding EnregistrerCommand}"/>
                            </StackPanel>

                            <!-- Boutons hors édition -->
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>

                                <Button Content="Modifier" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="0" Padding="10,4"
                                        Command="{Binding EditerCommand}" Margin="0,0,6,0"/>
                                <Button Content="Mainlevée" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="0" Padding="10,4"
                                        Command="{Binding PrononcerMainleveeCommand}" Margin="0,0,6,0"
                                        ToolTip="Prononcer la mainlevée suite à notification de désistement ou ordonnance"/>
                                <Button Content="{Binding BasculerStatutLibelle, FallbackValue='Suspendre'}" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="0" Padding="10,4"
                                        Command="{Binding BasculerStatutCommand}" Margin="0,0,6,0"
                                        ToolTip="Suspendre temporairement les retenues ou les réactiver"/>
                                <Button Content="Supprimer" Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="0" Padding="10,4"
                                        Command="{Binding SupprimerCommand}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Pied d'écran : Statut ═══════════ -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource InkMutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
