<Window x:Class="IUTSCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IUTSCalculator"
        xmlns:views="clr-namespace:IUTSCalculator.Views"
        xmlns:viewModels="clr-namespace:IUTSCalculator.ViewModels"
        mc:Ignorable="d"
        Title="Calculateur d'Impôts IUTS" 
        Height="650" 
        Width="850"
        MinHeight="500"
        MinWidth="800" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>

            <!-- DataTemplates pour les ViewModels -->
            <DataTemplate DataType="{x:Type viewModels:CalculationViewModel}">
                <views:CalculationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BaseSalaryEstimatorViewModel}">
                <views:BaseSalaryEstimatorView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de menu -->
        <Menu Grid.Row="0" FontSize="14">
            <MenuItem Header="Fichier">
                <MenuItem Header="Nouveau calcul" Command="{Binding NewCalculationCommand}"/>
                <MenuItem Header="Historique" Command="{Binding NavigateToHistoryCommand}"/>
                <MenuItem Header="Exporter" Command="{Binding ExportToPdfCommand}"/>
                <Separator/>
                <MenuItem Header="Quitter" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Paramètres" Command="{Binding NavigateToSettingsCommand}"/>
                <MenuItem Header="Préférences d'affichage" Click="DisplayPreferences_Click"/>
            </MenuItem>
            <MenuItem Header="Aide">
                <MenuItem Header="Documentation" Click="OpenDocumentation_Click"/>
                <MenuItem Header="À propos" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Zone de contenu principal -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre d'outils pour accès rapide -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Style="{StaticResource MenuButtonStyle}" 
                        Tag="{StaticResource IconNew}"
                        Content="Nouveau calcul" Command="{Binding NewCalculationCommand}" Width="143"/>
                <Button Style="{StaticResource MenuButtonStyle}" 
                        Tag="{StaticResource IconHistory}"
                        Content="Historique" Command="{Binding NavigateToHistoryCommand}"/>
                <Button Style="{StaticResource MenuButtonStyle}" 
                        Tag="{StaticResource IconSettings}"
                        Content="Paramètres" Command="{Binding NavigateToSettingsCommand}"/>
                <Button Style="{StaticResource MenuButtonStyle}" 
                        Tag="{StaticResource IconEstimate}"
                        Content="Estimation Salaire Base" Command="{Binding NavigateToBaseSalaryEstimatorCommand}" Width="194"/>                
            </StackPanel>

            <!-- Vue dynamique selon le ViewModel courant -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Barre de statut -->
        <StatusBar Grid.Row="2" Background="#f0f0f0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ApplicationTitle}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>